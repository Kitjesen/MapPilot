# =============================================================================
# LingTu native development image
#
# The source tree is mounted at /ws by docker-compose.dev.yml. The packaged
# development extra supplies the Python tooling while PYTHONPATH keeps live
# workspace edits ahead of the installed package.
# =============================================================================

ARG UBUNTU_VERSION=22.04
FROM ubuntu:${UBUNTU_VERSION}

ARG DEBIAN_FRONTEND=noninteractive
ARG HOST_UID=1000
ARG HOST_GID=1000

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    build-essential \
    ca-certificates \
    cargo \
    ccache \
    cmake \
    curl \
    cyclonedds-dev \
    cyclonedds-tools \
    gdb \
    htop \
    libeigen3-dev \
    libgrpc++-dev \
    libgtest-dev \
    liboctomap-dev \
    libopencv-dev \
    libpcl-dev \
    libprotobuf-dev \
    libtbb-dev \
    libyaml-cpp-dev \
    ninja-build \
    pkg-config \
    protobuf-compiler \
    protobuf-compiler-grpc \
    python3 \
    python3-dev \
    python3-pip \
    rustc \
    strace \
    sudo \
    tmux \
    valgrind \
    vim \
    && rm -rf /var/lib/apt/lists/*

RUN if ! getent group "${HOST_GID}" >/dev/null; then groupadd --gid "${HOST_GID}" lingtu; fi \
    && useradd --uid "${HOST_UID}" --gid "${HOST_GID}" --shell /bin/bash \
        --create-home lingtu \
    && printf 'lingtu ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/lingtu \
    && chmod 0440 /etc/sudoers.d/lingtu

COPY . /tmp/lingtu
RUN python3 -c "import sys; assert sys.version_info[:2] == (3, 10), sys.version" \
    && python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir '/tmp/lingtu[dev]' \
    && rm -rf /tmp/lingtu

WORKDIR /ws
RUN chown -R lingtu:lingtu /ws

ENV CCACHE_DIR=/ws/.ccache \
    CCACHE_MAXSIZE=10G \
    PYTHONPATH=/ws/src:/ws \
    CMAKE_BUILD_TYPE=RelWithDebInfo

USER lingtu
CMD ["/bin/bash"]
