# =============================================================================
# LingTu Navigation System — Development Dockerfile
#
# Usage:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up dev
#
# Features:
#   - Source code mounted at /ws (live editing, no rebuild needed)
#   - ccache volume for incremental compilation
#   - Debug tools: gdb, valgrind, htop, rviz2
#   - UID/GID mapping to avoid permission issues
# =============================================================================

ARG ROS_DISTRO=humble

FROM ros:${ROS_DISTRO}-ros-base

ARG ROS_DISTRO
ARG HOST_UID=1000
ARG HOST_GID=1000

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Build tools
    cmake build-essential python3-pip python3-dev \
    python3-colcon-common-extensions python3-rosdep \
    # Libraries
    libpcl-dev libeigen3-dev libopencv-dev \
    libgrpc++-dev protobuf-compiler-grpc \
    # Debug tools
    gdb valgrind htop strace \
    # ROS tools
    ros-${ROS_DISTRO}-rviz2 \
    ros-${ROS_DISTRO}-rqt \
    ros-${ROS_DISTRO}-rqt-common-plugins \
    # Utilities
    curl vim tmux bash-completion \
    && rm -rf /var/lib/apt/lists/* \
    && rosdep init || true \
    && rosdep update --rosdistro ${ROS_DISTRO} || true

# Create user matching host UID/GID to avoid permission issues
RUN groupadd --gid ${HOST_GID} lingtu || true \
    && useradd --uid ${HOST_UID} --gid ${HOST_GID} --shell /bin/bash \
        --create-home lingtu \
    && echo "lingtu ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/lingtu

# Install Python dependencies
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir \
    -r /tmp/requirements.txt \
    pytest pytest-asyncio pytest-mock pytest-benchmark \
    mypy ruff \
    && rm /tmp/requirements.txt

# Create workspace directory
WORKDIR /ws
RUN chown -R lingtu:lingtu /ws

# ccache setup
ENV CCACHE_DIR=/ws/.ccache
ENV CCACHE_MAXSIZE=10G

# Shell prompt enhancement
RUN echo 'source /opt/ros/${ROS_DISTRO}/setup.bash' >> /home/lingtu/.bashrc \
    && echo 'export RMW_IMPLEMENTATION=rmw_fastrtps_cpp' >> /home/lingtu/.bashrc

USER lingtu
CMD ["/bin/bash"]
