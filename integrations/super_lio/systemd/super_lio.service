[Unit]
Description=LingTu experimental Super-LIO mapping adapter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=sunrise
WorkingDirectory=/home/sunrise/data/inovxio/lingtu
Environment=HOME=/home/sunrise
Environment=ROS_DOMAIN_ID=0
Environment=SUPER_LIO_WS=/home/sunrise/data/inovxio/super-lio
Environment=SUPER_LIO_LIDAR_TOPIC=/lidar/raw_frame
Environment=SUPER_LIO_IMU_TOPIC=/imu/raw
EnvironmentFile=-/etc/lingtu/super_lio.env
ExecStart=/bin/bash -c '\
  set -eo pipefail; \
  source /opt/lingtu/config/ros2-env.sh; \
  if [ -f "$${SUPER_LIO_WS}/install/local_setup.bash" ]; then \
    source "$${SUPER_LIO_WS}/install/local_setup.bash"; \
  elif [ -f "$${SUPER_LIO_WS}/install/setup.bash" ]; then \
    source "$${SUPER_LIO_WS}/install/setup.bash"; \
  else \
    echo "Super-LIO install setup not found: $${SUPER_LIO_WS}" >&2; \
    exit 1; \
  fi; \
  CONFIG="$${SUPER_LIO_CONFIG:-$$(ros2 pkg prefix super_lio)/share/super_lio/config/livox_360.yaml}"; \
  test -f "$${CONFIG}" || { echo "Super-LIO config not found: $${CONFIG}" >&2; exit 2; }; \
  exec ros2 run super_lio super_lio_node \
    --ros-args \
    --params-file "$${CONFIG}" \
    -p "lio.ros.lidar_topic:=$${SUPER_LIO_LIDAR_TOPIC}" \
    -p "lio.ros.imu_topic:=$${SUPER_LIO_IMU_TOPIC}" \
    -r "/lio/odom:=/slam/odometry" \
    -r "/lio/cloud_world:=/slam/map_cloud" \
    -r "/lio/imu/odom:=/nav/imu_odom" \
    -r "/lio/robo/odom:=/nav/robot_odom"'
TimeoutStopSec=15
Restart=on-failure
RestartSec=3
MemoryMax=2G
KillMode=control-group
KillSignal=SIGINT
SuccessExitStatus=130 SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=lingtu-super-lio-experimental

