# Build portable PCT Rust GPMP optimizer artifacts.
#
# Usage from the repository root:
#   docker build -f src/nav/services/plan/global_planner/algorithm/pct/vendor/pct_planner/Dockerfile.build -t pct-rust-gpmp-build .
#   docker run --rm -v "$(pwd)/src/nav/services/plan/global_planner/algorithm/pct/runtime/rust/x86_64:/output" pct-rust-gpmp-build
#
# aarch64/S100P build through Docker buildx:
#   docker buildx build --platform linux/arm64 -f src/nav/services/plan/global_planner/algorithm/pct/vendor/pct_planner/Dockerfile.build -t pct-rust-gpmp-build-arm64 --load .
#   docker run --rm -v "$(pwd)/src/nav/services/plan/global_planner/algorithm/pct/runtime/rust/aarch64:/output" pct-rust-gpmp-build-arm64

FROM rust:1-bookworm AS builder

WORKDIR /workspace

COPY src/kernels/planning/gpmp_trajectory_optimizer \
    /workspace/src/kernels/planning/gpmp_trajectory_optimizer

RUN cargo build --release \
      --manifest-path /workspace/src/kernels/planning/gpmp_trajectory_optimizer/Cargo.toml \
      --lib && \
    cargo build --release \
      --manifest-path /workspace/src/kernels/planning/gpmp_trajectory_optimizer/Cargo.toml \
      --bin gpmp_optimize

RUN mkdir -p /artifacts && \
    cp /workspace/src/kernels/planning/gpmp_trajectory_optimizer/target/release/gpmp_optimize /artifacts/ && \
    cp /workspace/src/kernels/planning/gpmp_trajectory_optimizer/target/release/liblingtu_gpmp_trajectory_optimizer.so /artifacts/ && \
    chmod +x /artifacts/gpmp_optimize && \
    test -f /artifacts/gpmp_optimize && \
    test -f /artifacts/liblingtu_gpmp_trajectory_optimizer.so && \
    echo "=== PCT Rust optimizer artifacts ===" && \
    ls -la /artifacts

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /artifacts /artifacts

CMD ["sh", "-c", "mkdir -p /output && cp -a /artifacts/* /output/ && echo 'PCT Rust GPMP optimizer artifacts copied to /output/' && ls -la /output"]
