// marker_types.idl
//
// DDS IDL for visualization_msgs/MarkerArray, used by the Rerun overlay
// to render 3-D detection markers from the perception pipeline.
//
// Only the fields consumed by rerun_bridge._on_ros2_detections are
// populated; unused ROS2 Marker arrays (points, texture, etc.) are omitted
// to keep the wire type minimal.
//
// Generated descriptor name:
//   lingtu_dds_MarkerArray, lingtu_dds_MarkerArray_desc

module lingtu {
module dds {

// -- Shared geometry primitives (self-contained) --

struct ColorRGBA {
    float r;
    float g;
    float b;
    float a;
};

struct Point3D {
    double x;
    double y;
    double z;
};

struct Quaternion {
    double x;
    double y;
    double z;
    double w;
};

struct Pose {
    Point3D position;
    Quaternion orientation;
};

// -- Marker --

struct Marker {
    long id;
    long type;   // SPHERE=2, CUBE=1, etc.
    long action; // ADD=0, MODIFY=0, DELETE=2
    Pose pose;
    ColorRGBA color;
    string<256> text;
    string<128> ns;
};

// -- MarkerArray (top-level topic type) --

struct MarkerArray {
    sequence<Marker> markers;
};

};
};
