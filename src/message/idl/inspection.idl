// Product task ingress. task_id identifies one durable user-visible lifecycle;
// request_id identifies one retryable call.
@final
struct InspectionTaskRequest {
  Header header;
  string task_id;
  string request_id;
  long kind;
  string route_id;
  unsigned long long route_revision;
  string reason;
};
@final
struct InspectionTaskAck {
  Header header;
  string task_id;
  string request_id;
  long kind;
  boolean accepted;
  string reason;
  string run_id;
};
@final
struct InspectionEvidenceRequest {
  Header header;
  string request_id;
  string run_id;
  string route_id;
  unsigned long long revision;
  string map_id;
  long long map_content_epoch;
  unsigned long point_index;
  string point_id;
  string action;
  double deadline_s;
};
@final
struct InspectionEvidenceResult {
  Header header;
  string request_id;
  string evidence_id;
  boolean persisted;
  string reason;
  string analysis_verdict;
};
@final
struct InspectionStatus {
  Header header;
  string run_id;
  string route_id;
  unsigned long long route_revision;
  long state;
  unsigned long point_index;
  unsigned long point_count;
  unsigned long loop_index;
  unsigned long retry_count;
  string point_id;
  string action;
  string action_request_id;
  string evidence_id;
  double phase_started_at;
  double stable_since;
  double deadline;
  string reason;
};
// Immutable task-fact stream emitted alongside the live InspectionStatus view.
@final
struct InspectionTaskEvent {
  Header header;
  string boot_id;
  unsigned long long event_sequence;
  long kind;
  string task_id;
  string request_id;
  string command_request_id;
  long state;
  string map_id;
  long long map_content_epoch;
  string route_id;
  unsigned long long route_revision;
  unsigned long point_index;
  unsigned long point_count;
  unsigned long loop_index;
  unsigned long retry_count;
  string point_id;
  string action;
  string action_request_id;
  string evidence_id;
  string reason;
};
