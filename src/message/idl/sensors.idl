@final
struct Imu {
  Header header;
  Quaternion orientation;
  double orientation_covariance[9];
  Vector3 angular_velocity;
  double angular_velocity_covariance[9];
  Vector3 linear_acceleration;
  double linear_acceleration_covariance[9];
};
@final
struct LivoxPoint {
  unsigned long offset_time;
  float x;
  float y;
  float z;
  octet reflectivity;
  octet tag;
  octet line;
};
@final
struct LivoxFrame {
  Header header;
  unsigned long long timebase;
  unsigned long point_num;
  octet lidar_id;
  octet rsvd[3];
  sequence<LivoxPoint> points;
};
@final
struct Image {
  Header header;
  unsigned long height;
  unsigned long width;
  string encoding;
  boolean is_bigendian;
  unsigned long step;
  sequence<octet> data;
};
@final
struct CameraInfo {
  Header header;
  unsigned long height;
  unsigned long width;
  double depth_scale;
  string distortion_model;
  sequence<double> d;
  double k[9];
  double r[9];
  double p[12];
};
// Product identity is distinct from the compiled sensor session identity.
// Source time/generation remain simulation truth, not receipt/epoch time.
@final
struct MeasurementIdentity {
  string product_session_id;
  string session_id;
  string instance_id;
  unsigned long long model_generation;
  unsigned long long reset_generation;
  unsigned long long sample_sequence;
  unsigned long long sim_time_ns;
};
// Requests are applied by the source owner at a safe sampling boundary.
// operation uses SensorControlKind. Irrelevant numeric fields remain zero.
@final
struct SensorControlRequest {
  string request_id;
  string product_session_id;
  string session_id;
  string sensor_id;
  unsigned long long model_generation;
  unsigned long long reset_generation;
  double deadline_s;
  long operation;
  boolean enabled;
  double rate_hz;
  double noise_stddev;
  unsigned long long noise_seed;
  string noise_unit;
  double pan_deg;
  double tilt_deg;
};
// Applied means effective settings changed/read, not sensor quality or task success.
@final
struct SensorControlResult {
  string request_id;
  string product_session_id;
  string session_id;
  string sensor_id;
  unsigned long long model_generation;
  unsigned long long reset_generation;
  unsigned long long applied_sim_time_ns;
  boolean applied;
  string reason;
  string settings_json;
};
// Row-major Kelvin and a same-sized 0/1 validity mask; invalid values are NaN.
// metadata_json retains temperature kind, calibration, pose and model assumptions.
@final
struct ThermalImage {
  @key string sensor_id;
  Header header;
  MeasurementIdentity identity;
  unsigned long width;
  unsigned long height;
  sequence<float> temperature_k;
  sequence<octet> valid_mask;
  string metadata_json;
};
// Channel-major pressure, not an Image or an audio playback command.
// voltage_v is empty when no electrical sensitivity calibration was declared.
@final
struct AcousticBlock {
  @key string sensor_id;
  Header header;
  MeasurementIdentity identity;
  unsigned long sample_rate_hz;
  unsigned long channels;
  unsigned long samples;
  sequence<float> pressure_pa;
  sequence<octet> valid_mask;
  sequence<float> voltage_v;
  string metadata_json;
};
// Physical labels are simulation ground truth, never detector predictions.
@final
struct SemanticImage {
  @key string sensor_id;
  Header header;
  MeasurementIdentity identity;
  unsigned long width;
  unsigned long height;
  sequence<unsigned long> class_ids;
  sequence<unsigned long> instance_ids;
  sequence<octet> valid_mask;
  string metadata_json;
};
@final
struct GnssFix {
  Header header;
  double latitude;
  double longitude;
  double altitude;
  long fix_type;
  double position_covariance[9];
  unsigned long num_sat;
  unsigned long num_sat_used;
  double hdop;
  double rtcm_age_s;
};
@final
struct GnssStatus {
  Header header;
  string device;
  long fix_type;
  boolean link_ok;
  boolean rtk;
  unsigned long num_sat;
  unsigned long num_sat_used;
  double hdop;
  double rtcm_age_s;
  string error;
};
@final
struct JointState {
  Header header;
  string robot_model;
  sequence<string> names;
  sequence<double> position;
  sequence<double> velocity;
  sequence<double> effort;
};
@final
struct DriverControlState {
  Header header;
  boolean connected;
  boolean ready;
  boolean motors_enabled;
  boolean critical_fault;
  boolean control_assured;
  boolean lease_valid;
  unsigned long lease_remaining_ms;
  unsigned long long accepted_sequence;
  boolean zero_output;
  string fsm;
  string owner;
  string owner_id;
  string reason;
};
@final
struct MotionProfileRequest {
  Header header;
  string task_id;
  string requirement;
};
@final
struct MotionProfileState {
  Header header;
  string task_id;
  string requirement;
  string phase;
  string requested_profile;
  string active_profile;
  string reason;
};
@final
struct MotionPostureRequest {
  Header header;
  string host_boot_id;
  string producer_boot_id;
  unsigned long long source_boottime_ns;
  string client_id;
  string request_id;
  // NavigationCommandKind STAND, SIT, ENABLE_MOTORS, DISABLE_MOTORS or
  // SWITCH_PROFILE. Phase 0 inspects, phase 1 follows
  // nav's stop barrier. Phase 2 cancels an unexecuted request. Driver
  // independently confirms the stop prerequisite before execution.
  long action;
  long phase;
  string profile_name;
  string external_session_id;
};
@final
struct MotionPostureAck {
  Header header;
  string producer_boot_id;
  string client_id;
  string request_id;
  long action;
  long phase;
  string profile_name;
  string external_session_id;
  boolean final_result;
  boolean accepted;
  string reason;
};
@final
struct ExternalJointCommand {
  double q;
  double dq;
  double kp;
  double kd;
  double tau;
};
@final
struct ExternalCommand {
  string host_boot_id;
  string session_id;
  unsigned long long frame_sequence;
  unsigned long long source_boottime_ns;
  unsigned long long input_window;
  boolean heartbeat;
  ExternalJointCommand joints[16];
};
@final
struct ExternalControlState {
  Header header;
  string session_id;
  boolean selected;
  boolean active;
  boolean motors_enabled;
  unsigned long long last_sequence;
  string reason;
  unsigned long long input_window;
  unsigned long joint_count;
  boolean fresh;
  boolean motor_disable_confirmed;
};
