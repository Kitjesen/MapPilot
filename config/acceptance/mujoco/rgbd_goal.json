{
  "extends": "navigation.json",
  "name": "mujoco_rgbd_selected_goal",
  "description": "Selected image ROI -> rendered RGB-D -> production projection and visual standoff -> native SCAN -> physical MuJoCo. Truth localization is an explicit isolation fixture.",
  "world": "sim/packages/worlds/industrial_park/physics/industrial_park_scene.xml",
  "start": [40.0, 6.0, 0.6, 0.0],
  "paths": {"path_library": null},
  "slam_runtime": {"provider": "mujoco_navigation_fixture", "mode": "localization"},
  "driver_runtime": {"command_timeout_ms": 500, "heartbeat_timeout_ms": 10000, "apply_timeout_ms": 30000},
  "planner_constraints": {
    "robot_radius_m": 0.95,
    "max_iterations": 300000,
    "require_ground_support": true,
    "strict_ground_support": true,
    "ground_support_xy_radius_cells": 0,
    "ground_support_depth_cells": 2,
    "support_height_m": 0.3,
    "support_height_tolerance_m": 0.11,
    "enable_preblocked_costmap": false,
    "preblocked_radius_cells": 0,
    "lowest_traversable_only": true,
    "same_floor_preference": true,
    "same_floor_z_tolerance_m": 0.4,
    "max_same_floor_z_excursion_m": 0.8,
    "obstacle_clearance_radius_cells": 0,
    "obstacle_clearance_weight": 0.0,
    "terminal_goal_xy_tolerance_m": 0.6,
    "terminal_goal_z_tolerance_m": 0.4
  },
  "navigation_runtime": {
    "local_planner": "scan",
    "corridor_lookahead_m": 1.2,
    "max_obstacle_points": 4000,
    "status_period_s": 0.5,
    "use_traversability_cost": false,
    "path_follower_lookahead_m": 0.35,
    "path_follower_max_accel_mps2": 1.0,
    "path_follower_max_speed_mps": 0.5,
    "path_follower_min_speed_mps": 0.0,
    "path_follower_max_yaw_rate_rad_s": 0.8,
    "path_follower_heading_align_enter_rad": 1.0,
    "path_follower_heading_align_exit_rad": 0.5
  },
  "sensor_runtime": {
    "publish_hz": 10.0,
    "imu_hz": 200.0,
    "mid360_samples_per_frame": 4000,
    "scan_time_profile": "instantaneous",
    "physics_integrator": "euler",
    "physics_timestep_s": 0.005,
    "stop_on_nav_goal_reached": true,
    "publish_odom_prior": true,
    "publisher_write_mode": "async_fifo"
  },
  "telemetry_log": {"enabled": true, "hz": 10.0, "lidar_points": 640},
  "phases": {
    "motion": {"duration_s": 45.0, "warmup_s": 10.0, "start_anchor": "warmup", "publish_cmd_vel": true, "require_nonzero_cmd_vel": true}
  },
  "thresholds": {
    "startup_timeout_s": 60.0,
    "startup_ready_stable_s": 3.0,
    "plan_timeout_s": 15.0,
    "require_slam_tracking": false,
    "require_slam_accuracy": false,
    "require_continuous_map_tracking": false,
    "require_navigation_safety_contracts": true,
    "require_traversability": false,
    "require_goal_reached": true,
    "max_goal_error_m": 0.5,
    "min_motion_m": 1.0,
    "min_net_displacement_m": 1.0,
    "min_goal_distance_reduction_m": 1.0,
    "min_input_gate_ready_fraction": 0.98,
    "max_consecutive_input_stale_s": 1.0,
    "max_navigation_loop_overrun_p99_ms": 100.0,
    "max_navigation_loop_overrun_peak_ms": 250.0
  },
  "runtime_tolerances": {
    "sim_hardware_realtime_factor": 0.5,
    "odom_max_age_s": 1.0,
    "tf_max_age_s": 1.0,
    "cloud_max_age_s": 1.5,
    "traversability_max_age_s": 2.0,
    "localization_health_max_age_s": 1.5,
    "terrain_map_max_age_s": 1.5
  },
  "contracts": {"terrain_output": null, "navigation_traversability_authority": null},
  "windows_cpu_isolation": true,
  "windows_navigation_physical_cores": 3,
  "acceptance_scope": {
    "coverage": "component",
    "claims": ["rendered RGB-D image selection, native navigation, physical contacts, arrival and terminal stop"],
    "excluded_claims": ["automatic object recognition", "Fast-LIO2 localization", "traversability service qualification", "ProductControl/Gateway integration", "Go2 gait", "field motion"]
  }
}
