# Copy to /etc/lingtu/models.env on the deployed Host (root-owned, mode 0600).
# Set only the providers being delivered. Never put actual keys in this repository.
# MOONSHOT_API_KEY=replace_with_your_key
# OPENAI_API_KEY=replace_with_your_key
# ANTHROPIC_API_KEY=replace_with_your_key
# DASHSCOPE_API_KEY=replace_with_your_key
# TAVILY_API_KEY=replace_with_your_key
# Codex device login is performed in the Web console, not via an API key here.
