<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Native typed-DDS defaults for LingTu.
  Development: export CYCLONEDDS_URI=file://$(pwd)/config/cyclonedds.xml
  ProductControl may supply target-specific inline XML for a selected robot.
-->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain id="any">

    <!-- Network and payload limits. -->
    <General>
      <!-- A deployment may replace autodetection with its robot-facing NIC. -->
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default" />
      </Interfaces>

      <AllowMulticast>default</AllowMulticast>

      <!-- Larger map payloads are fragmented by CycloneDDS. -->
      <MaxMessageSize>65500B</MaxMessageSize>
      <FragmentSize>4096B</FragmentSize>
    </General>

    <!-- Participant discovery. -->
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
    </Discovery>

    <!-- Runtime buffers and retransmission policy. -->
    <Internal>
      <WriterLingerDuration>1s</WriterLingerDuration>

      <!-- Covers concurrent LiDAR fragments plus one bounded map scene. -->
      <SocketReceiveBufferSize min="8MB" />

      <BuiltinEndpointSet>writers</BuiltinEndpointSet>
      <RetransmitMerging>adaptive</RetransmitMerging>
    </Internal>

    <!-- Keep production output bounded; raise locally while diagnosing DDS. -->
    <Tracing>
      <Verbosity>warning</Verbosity>
      <!-- <OutputFile>/tmp/cyclonedds.log</OutputFile> -->
    </Tracing>

    <!--
      MapScene and PointCloud2 contain variable-length strings/sequences, so
      they are serialized even when an iceoryx-enabled CycloneDDS is used.
      Keep their rates and payload caps enforced in mapd.
    -->
    <!-- Optional shared memory for eligible fixed-layout local types. -->
    <!--
    <SharedMemory>
      <Enable>true</Enable>
      <LogLevel>warning</LogLevel>
    </SharedMemory>
    -->

  </Domain>
</CycloneDDS>
