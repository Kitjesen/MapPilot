# Target-specific native video runtime. Install as /etc/lingtu/video.env.
# Select an encoder that is present on the target; the managed launcher never
# falls back to software implicitly.
LINGTU_VIDEO_ENCODER=

# Field releases must generate this environment for the target architecture.
# Do not copy build/deps/video/prefix/env.sh from an x86/WSL checkout to ARM.
LINGTU_VIDEO_RUNTIME_ENV=/opt/lingtu/current/lib/lingtu/video/env.sh

# Development example after scripts/build/prepare_camera_video.sh:
# LINGTU_VIDEO_ENCODER=x264enc
# LINGTU_VIDEO_RUNTIME_ENV=/absolute/repository/build/deps/video/prefix/env.sh
