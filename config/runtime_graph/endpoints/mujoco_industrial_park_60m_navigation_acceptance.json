{
  "schema_version": "lingtu.mujoco.native_navigation_acceptance.v1",
  "name": "mujoco_industrial_park_60m_navigation",
  "description": "Strict single-goal native-DDS navigation acceptance across the 60 x 40 m MuJoCo industrial park.",
  "acceptance_scope": {
    "function": "saved_map_single_goal_navigation",
    "blocking_chain": "existing_map -> global_planner -> local_planner -> cmd_vel -> ThunderV4 -> goal_arrival",
    "sensor_accuracy": "evidence_only",
    "rolling_scan_and_slam_accuracy_gate": "separate_sensor_acceptance",
    "navigation_state_provider": "mujoco_navigation_fixture",
    "navigation_imu_rate_hz": 100.0,
    "full_sensor_imu_rate_hz": 200.0
  },
  "domain_id_base": 226,
  "world": "sim/worlds/mujoco/industrial_park_scene.xml",
  "start": [3.0, 4.0, 0.48, 0.0],
  "goal": [56.0, 32.0, 0.3, 0.0],
  "map_dir": "artifacts/mujoco_industrial_park_saved_map_plan_60m/same_source_map",
  "asset_builder": {
    "kind": "saved_map_plan_gate",
    "scene_preset": "industrial_park",
    "length": 60.0,
    "width": 40.0,
    "spacing": 0.2,
    "hits_per_cell": 4,
    "resolution": 0.2,
    "map_source": "synthetic_hits"
  },
  "map_files": {
    "slam": "map.pcd",
    "planner": "octomap.ot",
    "metadata": "metadata.json"
  },
  "paths": {
    "slam_config": "src/localization/fastlio2/config/mid360_mujoco_native_dds_navigation_prior.yaml",
    "path_library": "src/nav/services/plan/local_planner/paths",
    "sensor_runner": "sim/scripts/mujoco/native_dds_sensors.py"
  },
  "slam_runtime": {
    "provider": "mujoco_navigation_fixture",
    "mode": "mapping",
    "role": "disabled in this navigation functional gate; MuJoCo truth is published through native DDS while SLAM accuracy remains a separate acceptance"
  },
  "traversability_runtime": {
    "publish_hz": 10.0,
    "slow_hz": 2.0
  },
  "navigation_runtime": {
    "corridor_lookahead_m": 1.2,
    "max_obstacle_points": 4000,
    "status_period_s": 0.5
  },
  "telemetry_log": {
    "enabled": true,
    "hz": 10.0,
    "lidar_points": 640
  },
  "binaries": {
    "sensor_publisher": {
      "env": "LINGTU_MUJOCO_NATIVE_DDS_PUBLISHER_BIN",
      "candidates": [
        "build/mujoco_native_livox/livox_sdk2_stream",
        "build/livox_sdk2_stream/livox_sdk2_stream"
      ]
    },
    "slam": {
      "env": "LINGTU_MUJOCO_SLAM_BIN",
      "candidates": [
        "build/slam_core_wsl_fresh_20260713/lingtu_slam_cyclone_runtime",
        "build/mujoco_native_slam/lingtu_slam_cyclone_runtime",
        "build/slam_core/lingtu_slam_cyclone_runtime"
      ]
    },
    "traversability": {
      "env": "LINGTU_MUJOCO_TRAVERSABILITY_BIN",
      "candidates": [
        "build/nav_endpoint_wsl/lingtu_traversability_dds",
        "build/mujoco_native_nav/lingtu_traversability_dds"
      ]
    },
    "navigation": {
      "env": "LINGTU_MUJOCO_NAV_BIN",
      "candidates": [
        "build/nav_endpoint_wsl/lingtu_nav_native_endpoint",
        "build/mujoco_native_nav/lingtu_nav_native_endpoint"
      ]
    },
    "navigation_control": {
      "env": "LINGTU_MUJOCO_NAV_CONTROL_BIN",
      "candidates": [
        "build/nav_endpoint_wsl/lingtu_nav_control",
        "build/mujoco_native_nav/lingtu_nav_control"
      ]
    },
    "cmd_vel_tap": {
      "env": "LINGTU_MUJOCO_CMD_VEL_TAP_BIN",
      "candidates": [
        "build/mujoco_native_dds/lingtu_mujoco_cmd_vel_tap"
      ]
    }
  },
  "planner_constraints": {
    "robot_radius_m": 0.95,
    "max_iterations": 300000,
    "require_ground_support": true,
    "strict_ground_support": true,
    "ground_support_xy_radius_cells": 1,
    "ground_support_depth_cells": 2,
    "support_height_m": 0.3,
    "support_height_tolerance_m": 0.11,
    "enable_preblocked_costmap": false,
    "preblocked_radius_cells": 0,
    "lowest_traversable_only": true,
    "same_floor_preference": true,
    "same_floor_z_tolerance_m": 0.4,
    "max_same_floor_z_excursion_m": 0.8,
    "obstacle_clearance_radius_cells": 0,
    "obstacle_clearance_weight": 0.0,
    "terminal_goal_xy_tolerance_m": 0.6,
    "terminal_goal_z_tolerance_m": 0.4
  },
  "sensor_runtime": {
    "publish_hz": 10.0,
    "imu_hz": 100.0,
    "mid360_samples_per_frame": 10000,
    "scan_time_profile": "instantaneous",
    "publish_odom_prior": true,
    "odom_prior_velocity_window_s": 0.1,
    "navigation_fixture_cloud_points": 4000,
    "stop_on_nav_goal_reached": true
  },
  "phases": {
    "no_motion": {
      "duration_s": 45.0,
      "warmup_s": 20.0,
      "start_anchor": "run",
      "publish_cmd_vel": false,
      "require_nonzero_cmd_vel": false
    },
    "motion": {
      "duration_s": 600.0,
      "warmup_s": 20.0,
      "start_anchor": "warmup",
      "publish_cmd_vel": true,
      "require_nonzero_cmd_vel": true
    }
  },
  "thresholds": {
    "startup_timeout_s": 120.0,
    "startup_ready_stable_s": 3.0,
    "plan_timeout_s": 60.0,
    "min_global_path_points": 200,
    "min_local_path_points": 2,
    "min_cmd_vel_samples": 3,
    "require_slam_tracking": false,
    "require_slam_accuracy": false,
    "navigation_state_provider": "mujoco_navigation_fixture",
    "require_navigation_safety_contracts": true,
    "require_video_artifact": true,
    "allow_degraded_slam_for_navigation_isolation": true,
    "require_continuous_map_tracking": false,
    "min_track_against_map_successes": 1,
    "max_track_against_map_success_age_s": 6.0,
    "max_consecutive_track_against_map_failures": 3,
    "min_input_gate_ready_fraction": 0.98,
    "max_odom_tf_rejections": 5,
    "max_cloud_pose_rejections": 5,
    "max_consecutive_input_stale_s": 1.0,
    "max_navigation_loop_overrun_p99_ms": 100.0,
    "max_navigation_loop_overrun_peak_ms": 250.0,
    "min_forward_linear_command_fraction": 0.8,
    "max_reverse_linear_command_fraction": 0.1,
    "min_motion_m": 50.0,
    "min_goal_distance_reduction_m": 50.0,
    "require_goal_reached": true,
    "max_goal_error_m": 0.5
  },
  "runtime_tolerances": {
    "sim_hardware_realtime_factor": 1.0,
    "odom_max_age_s": 1.0,
    "tf_max_age_s": 1.0,
    "cloud_max_age_s": 1.5,
    "cloud_pose_max_gap_s": 0.2,
    "traversability_max_age_s": 2.0,
    "localization_health_max_age_s": 1.5,
    "terrain_map_max_age_s": 1.5,
    "input_future_tolerance_s": 0.05,
    "input_recovery_frames": 1,
    "track_against_map_period_s": 5.0
  },
  "frame_contract": {
    "traversability_geometry_frame_current": "map",
    "traversability_header_frame_current": "map",
    "navigation_query_frame": "map",
    "max_map_odom_tf_age_s": 0.6,
    "map_odom_identity_translation_tolerance_m": 0.05,
    "map_odom_identity_rotation_tolerance_rad": 0.05,
    "required_fix": ""
  },
  "contracts": {
    "sensor_inputs": ["rt/lidar/raw_frame", "rt/imu/raw"],
    "navigation_fixture_outputs": [
      "rt/slam/odometry",
      "rt/tf",
      "rt/slam/registered_cloud",
      "rt/slam/localization_health"
    ],
    "terrain_output": "rt/nav/traversability",
    "navigation_inputs": [
      "rt/nav/command/request",
      "rt/slam/odometry",
      "rt/tf",
      "rt/slam/registered_cloud",
      "rt/slam/localization_health",
      "rt/nav/traversability"
    ],
    "navigation_command_ack": "rt/nav/command/ack",
    "navigation_command_transport": "typed_dds_request_ack",
    "navigation_telemetry": ["rt/nav/global_path", "rt/nav/local_path"],
    "locomotion_input": "rt/nav/cmd_vel",
    "local_path_role": "dds_telemetry_and_preview",
    "path_follower_role": "embedded_before_cmd_vel_gate",
    "forbidden_compute": [
      "Python global planner",
      "Python local planner",
      "Python path follower"
    ]
  }
}
