[Unit]
Description=LEGACY local Robot Brainstem example (not used by Thunder field runtime)
Documentation=https://github.com/Kitjesen/lingtu
After=network.target

[Service]
Type=simple
User=sunrise
WorkingDirectory=/home/sunrise/data/inovxio/brainstem
Environment="PATH=/home/sunrise/data/dart-sdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/sunrise/data/dart-sdk/bin/dart han_dog/bin/server.dart
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s

[Install]
# Intentionally not installable by the current Thunder field runtime.
