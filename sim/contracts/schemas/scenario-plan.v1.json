{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.scenario-plan.v1",
  "title": "LingTu simulation scenario plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authority_policy",
    "backend",
    "clock",
    "entities",
    "env",
    "model_generation",
    "package",
    "reset_generation",
    "schema",
    "seed",
    "session_id"
  ],
  "properties": {
    "schema": {
      "const": "lingtu.sim.scenario-plan.v1"
    },
    "env": {
      "enum": [
        "real",
        "sim"
      ]
    },
    "backend": {
      "enum": [
        "mujoco",
        "ue5"
      ]
    },
    "model_generation": {
      "type": "integer",
      "minimum": 0
    },
    "reset_generation": {
      "type": "integer",
      "minimum": 0
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "package": {
      "$ref": "#/$defs/package_ref"
    },
    "clock": {
      "$ref": "#/$defs/simulation_clock"
    },
    "authority_policy": {
      "$ref": "#/$defs/authority_policy"
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
    "maxLength": 63,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "backend": {
            "const": "ue5"
          }
        },
        "required": [
          "backend"
        ]
      },
      "then": {
        "properties": {
          "env": {
            "const": "sim"
          }
        }
      }
    }
  ],
  "$defs": {
    "simulation_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "source",
        "sim_time_ns"
      ],
      "properties": {
        "unit": {
          "const": "ns"
        },
        "source": {
          "const": "mujoco_sim_time"
        },
        "sim_time_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "scenario"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_m",
        "quaternion_wxyz"
      ],
      "properties": {
        "position_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "quaternion_wxyz": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "authority_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robot_physics_owner",
        "dynamic_behavior_owner",
        "visual_animation_owner"
      ],
      "properties": {
        "robot_physics_owner": {
          "const": "mujoco"
        },
        "dynamic_behavior_owner": {
          "const": "scenario"
        },
        "visual_animation_owner": {
          "const": "ue_animation"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type",
        "authority",
        "source_epoch",
        "initial_transform"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "enum": [
            "robot",
            "pedestrian",
            "vehicle",
            "door",
            "elevator",
            "obstacle",
            "terrain",
            "prop"
          ]
        },
        "authority": {
          "enum": [
            "mujoco",
            "scenario",
            "ue_animation"
          ]
        },
        "source_epoch": {
          "type": "integer",
          "minimum": 0
        },
        "initial_transform": {
          "$ref": "#/$defs/transform"
        },
        "physics_proxy": {
          "oneOf": [
            {
              "enum": [
                "mujoco",
                "kinematic",
                "none"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "body_stable_id"
              ],
              "properties": {
                "mode": {
                  "const": "kinematic"
                },
                "body_stable_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile",
            "seed",
            "parameters"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                ]
              }
            }
          }
        },
        "semantic_class": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
