{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.sensor-rig-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "kind",
    "sensors"
  ],
  "properties": {
    "schema": {
      "const": "lingtu.sim.sensor-rig-package.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "sensor_rig"
    },
    "description": {
      "type": "string"
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package",
          "parent_frame",
          "runtime"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "parent_frame": {
            "$ref": "#/$defs/frame_id"
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "source"
            ],
            "properties": {
              "owner": {
                "enum": [
                  "physics",
                  "visual",
                  "sensor_runtime"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "frequency_hz": {
            "$ref": "#/$defs/frequency_hz"
          },
          "configuration": {
            "$ref": "#/$defs/configuration_override"
          },
          "extrinsic": {
            "$ref": "#/$defs/extrinsic"
          }
        },
        "allOf": [
          {
            "if": {"required": ["configuration"], "properties": {"configuration": {"required": ["measurement"]}}},
            "then": {"properties": {"runtime": {"properties": {
              "owner": {"const": "physics"}, "source": {"const": "mujoco_measurement"}
            }}}}
          },
          {
            "if": {"properties": {"package": {"pattern": "^gnss@"}}},
            "then": {
              "required": ["configuration"],
              "properties": {
                "configuration": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["gnss"],
                  "properties": {"gnss": {"$ref": "#/$defs/gnss_configuration"}}
                },
                "runtime": {
                  "properties": {
                    "owner": {"const": "physics"},
                    "source": {"const": "mujoco_gnss"}
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "package": {
                  "pattern": "^rgb_camera@"
                }
              }
            },
            "then": {
              "properties": {
                "configuration": {
                  "$ref": "#/$defs/rgb_configuration_override"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "package": {
                  "pattern": "^depth_camera@"
                }
              }
            },
            "then": {
              "properties": {
                "configuration": {
                  "$ref": "#/$defs/depth_configuration_override"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "package": {
                  "pattern": "^imu@"
                }
              }
            },
            "then": {
              "properties": {
                "configuration": {
                  "$ref": "#/$defs/imu_configuration_override"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "package": {
                  "pattern": "^mid360@"
                }
              }
            },
            "then": {
              "required": [
                "configuration"
              ],
              "properties": {
                "configuration": {
                  "$ref": "#/$defs/mid360_configuration_override"
                }
              }
            },
            "else": {
              "properties": {
                "configuration": {
                  "not": {"required": ["navigation_fixture_raw_overlay"]}
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "package": {
                  "pattern": "^truth_odom@"
                }
              }
            },
            "then": {
              "properties": {
                "configuration": {
                  "$ref": "#/$defs/truth_odom_configuration_override"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "package": {
                  "pattern": "^rgb_camera@"
                }
              }
            },
            "then": {
              "properties": {
                "frequency_hz": {
                  "$ref": "#/$defs/camera_frequency_hz"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "package": {
                  "pattern": "^depth_camera@"
                }
              }
            },
            "then": {
              "properties": {
                "frequency_hz": {
                  "$ref": "#/$defs/camera_frequency_hz"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "package": {
                  "pattern": "^imu@"
                }
              }
            },
            "then": {
              "properties": {
                "frequency_hz": {
                  "const": 200
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "package": {
                  "pattern": "^mid360@"
                }
              }
            },
            "then": {
              "properties": {
                "frequency_hz": {
                  "const": 10
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "package": {
                  "pattern": "^truth_odom@"
                }
              }
            },
            "then": {
              "properties": {
                "frequency_hz": {
                  "const": 100
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "gnss_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_latitude_deg", "origin_longitude_deg", "origin_altitude_m", "body_frame_id"],
      "properties": {
        "origin_latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "origin_longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "origin_altitude_m": {"type": "number"},
        "body_frame_id": {"$ref": "#/$defs/frame_id"},
        "antenna_offset_m": {"$ref": "#/$defs/vector3"},
        "world_origin_m": {"$ref": "#/$defs/vector3"},
        "world_to_enu_yaw_deg": {"type": "number"},
        "noise_enabled": {"type": "boolean"},
        "horizontal_std_m": {"type": "number", "minimum": 0},
        "vertical_std_m": {"type": "number", "minimum": 0},
        "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "fix_available": {"type": "boolean"}
      }
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "extrinsic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_m",
        "quaternion_wxyz"
      ],
      "properties": {
        "position_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "quaternion_wxyz": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "configuration_override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "measurement": {"$ref": "#/$defs/measurement_configuration_override"},
        "gnss": {"$ref": "#/$defs/gnss_configuration"},
        "width": {
          "$ref": "#/$defs/image_dimension"
        },
        "height": {
          "$ref": "#/$defs/image_dimension"
        },
        "encoding": {
          "enum": [
            "rgb8",
            "32FC1",
            "16UC1"
          ]
        },
        "unit": {
          "const": "m"
        },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "enum": [
              "orientation",
              "angular_velocity",
              "linear_acceleration"
            ]
          }
        },
        "point_fields": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "enum": [
              "x",
              "y",
              "z",
              "offset_time_ns",
              "reflectivity",
              "tag",
              "line"
            ]
          }
        },
        "offset_time_unit": {
          "const": "ns"
        },
        "line_semantics": {
          "enum": [
            "livox_channel",
            "unknown"
          ]
        },
        "raycast_frame": {
          "$ref": "#/$defs/frame_id"
        },
        "navigation_fixture_raw_overlay": {
          "type": "boolean"
        },
        "estimator_input": {
          "type": "boolean"
        }
      }
    },
    "measurement_configuration_override": {
      "type": "object", "additionalProperties": false, "required": ["body_frame_id"],
      "properties": {
        "body_frame_id": {"$ref": "#/$defs/frame_id"},
        "camera": {"$ref": "lingtu.sim.sensor-plan.v1#/$defs/measurement_camera"},
        "gimbal": {"$ref": "lingtu.sim.sensor-plan.v1#/$defs/measurement_gimbal"},
        "thermal": {"$ref": "lingtu.sim.sensor-plan.v1#/$defs/measurement_thermal"},
        "microphone": {"$ref": "lingtu.sim.sensor-plan.v1#/$defs/measurement_microphone"},
        "noise": {"$ref": "lingtu.sim.sensor-plan.v1#/$defs/measurement_configuration/properties/noise"},
        "max_distance_m": {"type": "number", "exclusiveMinimum": 0.001, "maximum": 1.7976931348623157e308}
      },
      "oneOf": [
        {
          "required": ["camera", "thermal"], "not": {"required": ["microphone"]},
          "properties": {"noise": {"properties": {"unit": {"const": "K"}}}}
        },
        {
          "required": ["camera"], "not": {"anyOf": [{"required": ["thermal"]}, {"required": ["microphone"]}]},
          "properties": {"noise": {"properties": {"unit": {"const": "label"}, "enabled": {"const": false}}}}
        },
        {
          "required": ["microphone"], "not": {"anyOf": [{"required": ["camera"]}, {"required": ["thermal"]},
            {"required": ["gimbal"]}, {"required": ["max_distance_m"]}]},
          "properties": {"noise": {"properties": {"unit": {"const": "Pa"}}}}
        }
      ]
    },
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]*$"
    },
    "frequency_hz": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10000
    },
    "image_dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "rgb_configuration_override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "$ref": "#/$defs/image_dimension"
        },
        "height": {
          "$ref": "#/$defs/image_dimension"
        },
        "encoding": {
          "const": "rgb8"
        }
      }
    },
    "depth_configuration_override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "$ref": "#/$defs/image_dimension"
        },
        "height": {
          "$ref": "#/$defs/image_dimension"
        },
        "encoding": {
          "enum": [
            "32FC1",
            "16UC1"
          ]
        },
        "unit": {
          "const": "m"
        }
      }
    },
    "imu_configuration_override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "enum": [
              "orientation",
              "angular_velocity",
              "linear_acceleration"
            ]
          }
        }
      }
    },
    "mid360_configuration_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raycast_frame"
      ],
      "properties": {
        "raycast_frame": {
          "$ref": "#/$defs/frame_id"
        },
        "navigation_fixture_raw_overlay": {
          "type": "boolean"
        },
        "point_fields": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "enum": [
              "x",
              "y",
              "z",
              "offset_time_ns",
              "reflectivity",
              "tag",
              "line"
            ]
          }
        },
        "offset_time_unit": {
          "const": "ns"
        },
        "line_semantics": {
          "enum": [
            "livox_channel",
            "unknown"
          ]
        }
      }
    },
    "truth_odom_configuration_override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "estimator_input": {
          "type": "boolean"
        }
      }
    },
    "camera_frequency_hz": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 240
    }
  }
}
