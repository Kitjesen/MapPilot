{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.entity-visual-projection.v1",
  "title": "LingTu instance-agnostic scenario entity visual projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binding",
    "package",
    "mjcf",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "lingtu.sim.entity-visual-projection.v1"
    },
    "binding": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "mjcf": {
      "$ref": "#/$defs/mjcf"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "robot-visual.v1.json#/$defs/component"
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*\\\\)(?!.*\\s)(?!.*//)(?!.*\\/$)(?!\\.\\.?(/|$))(?!.*(/\\.\\.?)(/|$)).+$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "mjcf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        }
      }
    }
  }
}
