{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.measurement-scene.v1",
  "title": "Explicit simulation measurement scene (empty means undeclared properties)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "thermal_surfaces": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/physical_name"},
      "additionalProperties": {"$ref": "#/$defs/thermal_surface"}
    },
    "semantic_labels": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/physical_name"},
      "additionalProperties": {"$ref": "#/$defs/semantic_label"}
    },
    "acoustic_sources": {"type": "array", "items": {"$ref": "#/$defs/acoustic_source"}}
  },
  "$defs": {
    "physical_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]*$"},
    "finite_number": {"type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
    "temperature": {"type": "number", "exclusiveMinimum": 0, "maximum": 3.4028234663852886e38},
    "vector3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/finite_number"}},
    "thermal_surface": {
      "type": "object", "additionalProperties": false, "required": ["temperature_k", "emissivity"],
      "properties": {
        "temperature_k": {"$ref": "#/$defs/temperature"},
        "emissivity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "semantic_label": {
      "type": "object", "additionalProperties": false, "required": ["class_id", "instance_id"],
      "properties": {
        "class_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "instance_id": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    },
    "acoustic_source": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "body_name", "pressure_pa", "sample_rate_hz", "start_sim_time_ns", "reference_distance_m"],
      "properties": {
        "source_id": {"$ref": "#/$defs/physical_name"},
        "body_name": {"$ref": "#/$defs/physical_name"},
        "pressure_pa": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finite_number"}},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "start_sim_time_ns": {"type": "integer", "minimum": 0},
        "reference_distance_m": {"type": "number", "exclusiveMinimum": 0, "maximum": 1.7976931348623157e308},
        "local_offset_m": {"$ref": "#/$defs/vector3"},
        "loop": {"type": "boolean", "default": false}
      }
    }
  }
}
