{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.robot-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "kind",
    "physics",
    "visual",
    "semantic",
    "frames",
    "interfaces",
    "defaults",
    "declared_capabilities"
  ],
  "properties": {
    "schema": {
      "const": "lingtu.sim.robot-package.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "robot"
    },
    "description": {
      "type": "string"
    },
    "compatibility": {
      "type": "object"
    },
    "qualification": {
      "type": "object"
    },
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mjcf",
        "attach_root",
        "root_joint",
        "global_options"
      ],
      "properties": {
        "mjcf": {
          "type": "string",
          "minLength": 1
        },
        "attach_root": {
          "type": "string",
          "minLength": 1
        },
        "root_joint": {
          "type": "string",
          "minLength": 1
        },
        "global_options": {
          "const": "inherit_session"
        },
        "initial_keyframe": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding",
        "projection"
      ],
      "properties": {
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "$ref": "#/$defs/relative_path"
        },
        "source_mesh_root": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "role"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/frame_id"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "parent_frame": {
            "$ref": "#/$defs/frame_id"
          },
          "extrinsic": {
            "$ref": "#/$defs/extrinsic"
          }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "command"
      ],
      "properties": {
        "state": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controller",
        "sensor_rig"
      ],
      "properties": {
        "controller": {
          "type": [
            "string",
            "null"
          ]
        },
        "sensor_rig": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "declared_capabilities": {
      "type": "object"
    }
  },
  "$defs": {
    "extrinsic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_m",
        "quaternion_wxyz"
      ],
      "properties": {
        "position_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "quaternion_wxyz": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "frame_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]*$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*\\\\)(?!.*\\s)(?!.*//)(?!.*\\/$)(?!\\.\\.?(/|$))(?!.*(/\\.\\.?)(/|$)).+$"
    }
  }
}
