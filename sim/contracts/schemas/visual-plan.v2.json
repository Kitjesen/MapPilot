{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.visual-plan.v2",
  "title": "LingTu deterministic simulation visual plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backends",
    "binding_policy",
    "coordinate_system",
    "robots",
    "schema",
    "session_id",
    "world"
  ],
  "properties": {
    "schema": {
      "const": "lingtu.sim.visual-plan.v2"
    },
    "backends": {
      "$ref": "#/$defs/backends"
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "position_scale",
        "axis_mapping",
        "quaternion_order"
      ],
      "properties": {
        "source": {
          "const": "mujoco_rh_z_up_m"
        },
        "target": {
          "const": "unreal_lh_z_up_cm"
        },
        "position_scale": {
          "const": 100.0
        },
        "axis_mapping": {
          "type": "array",
          "prefixItems": [
            {
              "const": "x"
            },
            {
              "const": "-y"
            },
            {
              "const": "z"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "quaternion_order": {
          "const": "wxyz"
        }
      }
    },
    "binding_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_asset",
        "data_asset_is_projection"
      ],
      "properties": {
        "missing_asset": {
          "enum": [
            "fail",
            "debug_proxy"
          ]
        },
        "data_asset_is_projection": {
          "const": true
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "binding",
        "level"
      ],
      "properties": {
        "package": {
          "$ref": "#/$defs/worldPackageRef"
        },
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "string",
          "pattern": "^/Game/(?!\\.\\.?(?:/|$))(?!.*\\\\)(?!.*\\s)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/](?:.*[^/])?$"
        },
        "projection": {
          "$ref": "#/$defs/worldProjection"
        }
      }
    },
    "robots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_id",
          "namespace",
          "package",
          "binding",
          "projection",
          "spawn"
        ],
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "$ref": "#/$defs/robotPackageRef"
          },
          "binding": {
            "type": "string",
            "minLength": 1
          },
          "projection": {
            "$ref": "#/$defs/robotProjection"
          },
          "spawn": {
            "$ref": "#/$defs/spawn"
          },
          "payloads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/payload"
            }
          }
        }
      }
    },
    "scenario_entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "namespace",
          "package",
          "binding",
          "projection",
          "spawn"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "package": {
            "$ref": "#/$defs/scenarioPackageRef"
          },
          "binding": {
            "type": "string",
            "minLength": 1
          },
          "projection": {
            "$ref": "#/$defs/entityProjection"
          },
          "spawn": {
            "$ref": "#/$defs/spawn"
          }
        }
      }
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
    "maxLength": 63,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"
    }
  },
  "$defs": {
    "backends": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physics",
        "visual"
      ],
      "properties": {
        "physics": {
          "const": "mujoco"
        },
        "visual": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "unreal",
            null
          ]
        }
      }
    },
    "robotPackageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "robot"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "worldPackageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "world"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scenarioPackageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "scenario"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "robotProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path"
      ],
      "properties": {
        "schema": {
          "const": "lingtu.sim.robot-visual-projection.v1"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "namespace",
        "robot_instance_id",
        "package",
        "parent_frame",
        "mount_transform",
        "binding",
        "projection",
        "authority",
        "ue_collision",
        "frames"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "robot_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "$ref": "#/$defs/payloadPackageRef"
        },
        "parent_frame": {
          "type": "string",
          "minLength": 1
        },
        "mount_transform": {
          "$ref": "#/$defs/spawn"
        },
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "$ref": "#/$defs/payloadProjection"
        },
        "authority": {
          "const": "mujoco"
        },
        "ue_collision": {
          "const": "disabled"
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "payloadPackageRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "payload"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "payloadProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path"
      ],
      "properties": {
        "schema": {
          "const": "lingtu.sim.payload-visual-projection.v1"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "entityProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path"
      ],
      "properties": {
        "schema": {
          "const": "lingtu.sim.entity-visual-projection.v1"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "worldProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "path"
      ],
      "properties": {
        "schema": {
          "const": "lingtu.sim.world-visual-projection.v1"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*\\\\)(?!.*\\s)(?!.*//)(?!.*\\/$)(?!\\.\\.?(/|$))(?!.*(/\\.\\.?)(/|$)).+$"
    },
    "spawn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_m",
        "quaternion_wxyz"
      ],
      "properties": {
        "position_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "quaternion_wxyz": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    }
  }
}
