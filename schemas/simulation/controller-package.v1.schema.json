{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.controller-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "kind", "adapter", "policy", "timing", "robot_interface", "actuators"],
  "properties": {
    "schema": {"const": "lingtu.sim.controller-package.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "kind": {"const": "controller"},
    "description": {"type": "string"},
    "adapter": {"type": "object", "additionalProperties": false, "required": ["plugin", "abi"]},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "artifact", "manifest"],
      "properties": {
        "runtime": {"type": "string", "minLength": 1},
        "artifact": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "minLength": 1}
      }
    },
    "timing": {"type": "object", "additionalProperties": false, "required": ["inference_hz", "low_level_hz"]},
    "robot_interface": {"type": "object", "additionalProperties": false, "required": ["requires_state", "produces_command"]},
    "actuators": {"type": "object", "additionalProperties": false, "required": ["channels"], "properties": {"channels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}
  }
}
