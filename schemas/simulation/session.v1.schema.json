{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.session.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "session_id", "mujoco_version", "seed", "world", "robots", "runtime"],
  "properties": {
    "schema": {"const": "lingtu.sim.session.v1"},
    "session_id": {"type": "string", "minLength": 1},
    "mujoco_version": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "world": {"type": "string", "minLength": 1},
    "robots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "package", "spawn"],
        "properties": {
          "instance_id": {"type": "string", "minLength": 1},
          "package": {"type": "string", "minLength": 1},
          "controller": {"type": ["string", "null"]},
          "sensor_rig": {"type": ["string", "null"]},
          "spawn": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position_m", "quaternion_wxyz"],
            "properties": {
              "position_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
              "quaternion_wxyz": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "mode", "required_bindings"],
      "properties": {
        "backend": {"type": "string", "minLength": 1},
        "mode": {"type": "string", "minLength": 1},
        "required_bindings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
