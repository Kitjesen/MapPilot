{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.sensor-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "kind", "sensor_type", "outputs", "timing", "interface"],
  "properties": {
    "schema": {"const": "lingtu.sim.sensor-package.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "kind": {"const": "sensor"},
    "description": {"type": "string"},
    "sensor_type": {"type": "string", "minLength": 1},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "timing": {"type": "object", "additionalProperties": false, "required": ["rate_hz"]},
    "interface": {"type": "object", "additionalProperties": false, "required": ["transport", "message_type"]},
    "noise": {"type": "object"}
  }
}
