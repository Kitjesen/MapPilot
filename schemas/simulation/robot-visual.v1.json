{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.robot-visual-projection.v1",
  "title": "LingTu instance-agnostic robot visual projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binding",
    "package",
    "mjcf",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "lingtu.sim.robot-visual-projection.v1"
    },
    "binding": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "mjcf": {
      "$ref": "#/$defs/mjcf"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*\\\\)(?!.*\\s)(?!.*//)(?!.*\\/$)(?!\\.\\.?(/|$))(?!.*(/\\.\\.?)(/|$)).+$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "mjcf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "finite_vector_3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "finite_vector_4": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "unit_quaternion_wxyz": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "positive_vector_1": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "positive_vector_2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "positive_vector_3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "mesh_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_mesh",
        "mesh",
        "scale"
      ],
      "properties": {
        "kind": {
          "const": "mesh"
        },
        "source_mesh": {
          "$ref": "#/$defs/relative_path"
        },
        "mesh": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "$ref": "#/$defs/finite_vector_3"
        }
      }
    },
    "primitive_geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "primitive",
        "size"
      ],
      "properties": {
        "kind": {
          "const": "primitive"
        },
        "primitive": {
          "enum": [
            "box",
            "cylinder",
            "sphere",
            "capsule"
          ]
        },
        "size": {
          "oneOf": [
            {
              "$ref": "#/$defs/positive_vector_1"
            },
            {
              "$ref": "#/$defs/positive_vector_2"
            },
            {
              "$ref": "#/$defs/positive_vector_3"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "box"
              }
            }
          },
          "then": {
            "properties": {
              "size": {
                "$ref": "#/$defs/positive_vector_3"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "enum": [
                  "cylinder",
                  "capsule"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "size": {
                "$ref": "#/$defs/positive_vector_2"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "primitive": {
                "const": "sphere"
              }
            }
          },
          "then": {
            "properties": {
              "size": {
                "$ref": "#/$defs/positive_vector_1"
              }
            }
          }
        }
      ]
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "#/$defs/mesh_geometry"
        },
        {
          "$ref": "#/$defs/primitive_geometry"
        }
      ]
    },
    "mesh_unreal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "component_class",
        "asset_path"
      ],
      "properties": {
        "representation": {
          "const": "static_mesh"
        },
        "component_class": {
          "const": "/Script/Engine.StaticMeshComponent"
        },
        "asset_path": {
          "type": "string",
          "pattern": "^/Game/(?!.*\\\\)(?!.*\\s)(?!.*//)(?!\\.\\.?(/|$))(?!.*(/\\.\\.?)(/|$))[^/](?:.*[^/])?$"
        }
      }
    },
    "primitive_static_mesh_unreal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "component_class",
        "asset_path",
        "dimensions_m"
      ],
      "properties": {
        "representation": {
          "const": "static_mesh"
        },
        "component_class": {
          "const": "/Script/Engine.StaticMeshComponent"
        },
        "asset_path": {
          "type": "string",
          "pattern": "^/Engine/BasicShapes/(Cube\\.Cube|Cylinder\\.Cylinder|Sphere\\.Sphere)$"
        },
        "dimensions_m": {
          "$ref": "#/$defs/positive_vector_3"
        }
      }
    },
    "capsule_unreal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "component_class",
        "radius_m",
        "cylinder_half_length_m",
        "capsule_half_height_m",
        "dimensions_m"
      ],
      "properties": {
        "representation": {
          "const": "component"
        },
        "component_class": {
          "const": "/Script/Engine.CapsuleComponent"
        },
        "radius_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cylinder_half_length_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "capsule_half_height_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dimensions_m": {
          "$ref": "#/$defs/positive_vector_3"
        }
      }
    },
    "unreal": {
      "oneOf": [
        {
          "$ref": "#/$defs/mesh_unreal"
        },
        {
          "$ref": "#/$defs/primitive_static_mesh_unreal"
        },
        {
          "$ref": "#/$defs/capsule_unreal"
        }
      ]
    },
    "source_geometry_mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_mesh",
        "mesh"
      ],
      "properties": {
        "kind": {
          "const": "mesh"
        },
        "source_mesh": {
          "$ref": "#/$defs/relative_path"
        },
        "mesh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_geometry_primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "primitive"
      ],
      "properties": {
        "kind": {
          "const": "primitive"
        },
        "primitive": {
          "enum": [
            "box",
            "cylinder",
            "sphere",
            "capsule"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_schema",
        "package",
        "mjcf",
        "geometry_source"
      ],
      "properties": {
        "manifest_schema": {
          "enum": [
            "lingtu.sim.robot-visual-manifest.v1",
            "lingtu.sim.scenario-package.v1"
          ]
        },
        "package": {
          "$ref": "#/$defs/package"
        },
        "mjcf": {
          "$ref": "#/$defs/mjcf"
        },
        "geometry_source": {
          "oneOf": [
            {
              "$ref": "#/$defs/source_geometry_mesh"
            },
            {
              "$ref": "#/$defs/source_geometry_primitive"
            }
          ]
        }
      }
    },
    "rgba": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "pbr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_color_rgba",
        "metallic",
        "roughness"
      ],
      "properties": {
        "base_color_rgba": {
          "$ref": "#/$defs/rgba"
        },
        "metallic": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "roughness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "key",
        "pbr"
      ],
      "properties": {
        "source": {
          "enum": [
            "mjcf_geom_rgba",
            "mjcf_material_rgba",
            "compiler_default"
          ]
        },
        "key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "pbr": {
          "$ref": "#/$defs/pbr"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "mjcf_material_rgba"
              }
            }
          },
          "then": {
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "mjcf_geom_rgba",
                  "compiler_default"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "key": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "local_transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_m",
        "quaternion_wxyz",
        "scale"
      ],
      "properties": {
        "position_m": {
          "$ref": "#/$defs/finite_vector_3"
        },
        "quaternion_wxyz": {
          "$ref": "#/$defs/unit_quaternion_wxyz"
        },
        "scale": {
          "$ref": "#/$defs/finite_vector_3"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_body_id",
        "body_frame_id",
        "visual_id",
        "visual_frame_id",
        "asset_key",
        "geometry",
        "unreal",
        "local_transform",
        "material_key",
        "material",
        "source"
      ],
      "properties": {
        "local_body_id": {
          "type": "string",
          "minLength": 1
        },
        "body_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "visual_id": {
          "type": "string",
          "minLength": 1
        },
        "visual_frame_id": {
          "type": "string",
          "minLength": 1
        },
        "asset_key": {
          "type": "string",
          "minLength": 1
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "unreal": {
          "$ref": "#/$defs/unreal"
        },
        "local_transform": {
          "$ref": "#/$defs/local_transform"
        },
        "material_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "material": {
          "$ref": "#/$defs/material"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "geometry": {
                "properties": {
                  "kind": {
                    "const": "mesh"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "unreal": {
                "$ref": "#/$defs/mesh_unreal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "geometry": {
                "properties": {
                  "kind": {
                    "const": "primitive"
                  },
                  "primitive": {
                    "const": "box"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "unreal": {
                "allOf": [
                  {
                    "$ref": "#/$defs/primitive_static_mesh_unreal"
                  },
                  {
                    "properties": {
                      "asset_path": {
                        "const": "/Engine/BasicShapes/Cube.Cube"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "geometry": {
                "properties": {
                  "kind": {
                    "const": "primitive"
                  },
                  "primitive": {
                    "const": "cylinder"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "unreal": {
                "allOf": [
                  {
                    "$ref": "#/$defs/primitive_static_mesh_unreal"
                  },
                  {
                    "properties": {
                      "asset_path": {
                        "const": "/Engine/BasicShapes/Cylinder.Cylinder"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "geometry": {
                "properties": {
                  "kind": {
                    "const": "primitive"
                  },
                  "primitive": {
                    "const": "sphere"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "unreal": {
                "allOf": [
                  {
                    "$ref": "#/$defs/primitive_static_mesh_unreal"
                  },
                  {
                    "properties": {
                      "asset_path": {
                        "const": "/Engine/BasicShapes/Sphere.Sphere"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "geometry": {
                "properties": {
                  "kind": {
                    "const": "primitive"
                  },
                  "primitive": {
                    "const": "capsule"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "unreal": {
                "$ref": "#/$defs/capsule_unreal"
              }
            }
          }
        }
      ]
    }
  }
}
