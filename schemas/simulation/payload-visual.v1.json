{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.payload-visual-projection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "package",
    "binding",
    "authority",
    "visual_policy",
    "source_asset",
    "material_contract",
    "components"
  ],
  "properties": {
    "schema": {
      "const": "lingtu.sim.payload-visual-projection.v1"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "manifest": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "binding": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "mujoco"
    },
    "visual_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collision_enabled",
        "simulate_physics",
        "generate_overlap_events"
      ],
      "properties": {
        "collision_enabled": {
          "const": "no_collision"
        },
        "simulate_physics": {
          "const": false
        },
        "generate_overlap_events": {
          "const": false
        }
      }
    },
    "source_asset": {
      "$ref": "#/$defs/artifact"
    },
    "material_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_format",
        "material_count",
        "required_channels"
      ],
      "properties": {
        "source_format": {
          "const": "gltf2"
        },
        "material_count": {
          "type": "integer",
          "minimum": 1
        },
        "required_channels": {
          "type": "array",
          "prefixItems": [
            {
              "const": "base_color"
            },
            {
              "const": "normal"
            },
            {
              "const": "metallic_roughness"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mesh",
          "body_frame",
          "unreal_asset",
          "local_transform"
        ],
        "properties": {
          "mesh": {
            "type": "string",
            "minLength": 1
          },
          "body_frame": {
            "type": "string",
            "minLength": 1
          },
          "unreal_asset": {
            "type": "string",
            "pattern": "^/Game/[^\\\\\\s]+\\.[^\\\\\\s]+$"
          },
          "local_transform": {
            "$ref": "#/$defs/transform"
          }
        }
      }
    }
  },
  "$defs": {
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*\\\\)(?!.*\\s)(?!.*//)(?!.*\\/$)(?!\\.\\.?(/|$))(?!.*(/\\.\\.?)(/|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_m",
        "quaternion_wxyz",
        "scale"
      ],
      "properties": {
        "position_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "quaternion_wxyz": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "scale": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
