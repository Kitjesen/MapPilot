{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.sensor-rig-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "kind", "sensors"],
  "properties": {
    "schema": {"const": "lingtu.sim.sensor-rig-package.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "kind": {"const": "sensor_rig"},
    "description": {"type": "string"},
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "package", "parent_frame"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "package": {"type": "string", "minLength": 1},
          "parent_frame": {"type": "string", "minLength": 1},
          "frequency_hz": {"type": "number"},
          "extrinsic": {"type": "object"}
        }
      }
    }
  }
}
