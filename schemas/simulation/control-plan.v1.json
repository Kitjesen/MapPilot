{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.control-plan.v1",
  "title": "LingTu deterministic simulation control plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backends",
    "command_channels",
    "controllers",
    "env",
    "schema",
    "session_id",
    "stale_stop_authority"
  ],
  "properties": {
    "schema": {
      "const": "lingtu.sim.control-plan.v1"
    },
    "env": {
      "const": "sim"
    },
    "backends": {
      "$ref": "#/$defs/backends"
    },
    "controllers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/controller"
      }
    },
    "command_channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command_channel"
      }
    },
    "stale_stop_authority": {
      "$ref": "#/$defs/stale_stop_authority"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
    "maxLength": 63,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$"
    }
  },
  "$defs": {
    "backends": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physics",
        "visual"
      ],
      "properties": {
        "physics": {
          "const": "mujoco"
        },
        "visual": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "unreal",
            null
          ]
        }
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "controller_id",
        "package",
        "adapter",
        "policy",
        "timing",
        "state_channels",
        "command_channels",
        "actuator_channels"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "controller_id": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "$ref": "#/$defs/package_ref"
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "plugin",
            "abi"
          ],
          "properties": {
            "plugin": {
              "type": "string",
              "minLength": 1
            },
            "abi": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "runtime",
            "artifact",
            "manifest"
          ],
          "properties": {
            "runtime": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "manifest": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inference_hz",
            "low_level_hz"
          ],
          "properties": {
            "inference_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "low_level_hz": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "state_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command_channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "actuator_channels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "command_channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel_id",
        "direction",
        "owner",
        "source",
        "transport",
        "message_type",
        "command_type",
        "target"
      ],
      "properties": {
        "channel_id": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "publish",
            "subscribe"
          ]
        },
        "owner": {
          "enum": [
            "physics",
            "simulation",
            "native_service"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "enum": [
            "typed_dds",
            "in_process"
          ]
        },
        "message_type": {
          "type": "string",
          "minLength": 1
        },
        "command_type": {
          "enum": [
            "joint_position",
            "joint_velocity",
            "joint_torque",
            "base_twist",
            "stop"
          ]
        },
        "target": {
          "enum": [
            "actuators",
            "base",
            "safety"
          ]
        }
      }
    },
    "package_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "kind",
        "manifest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "controller"
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "stale_stop_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "hardware_forwarding",
        "safe_stop_on_stale",
        "stale_timeout_ms"
      ],
      "properties": {
        "owner": {
          "const": "simulation"
        },
        "hardware_forwarding": {
          "const": false
        },
        "safe_stop_on_stale": {
          "const": true
        },
        "stale_timeout_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
