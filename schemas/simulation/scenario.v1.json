{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.scenario-package.v1",
  "title": "LingTu simulation scenario package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "kind",
    "world",
    "entities"
  ],
  "properties": {
    "schema": {
      "const": "lingtu.sim.scenario-package.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "scenario"
    },
    "description": {
      "type": "string"
    },
    "world": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_m",
        "quaternion_wxyz"
      ],
      "properties": {
        "position_m": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "quaternion_wxyz": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "seed",
        "parameters"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "entity_type",
        "authority",
        "initial_transform",
        "physics_proxy",
        "semantic_class"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "enum": [
            "pedestrian",
            "vehicle",
            "door",
            "elevator",
            "obstacle",
            "terrain",
            "prop"
          ]
        },
        "authority": {
          "enum": [
            "scenario",
            "ue_animation",
            "mujoco"
          ]
        },
        "initial_transform": {
          "$ref": "#/$defs/transform"
        },
        "physics_proxy": {
          "oneOf": [
            {
              "enum": [
                "mujoco",
                "kinematic",
                "none"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "mjcf",
                "attach_root"
              ],
              "properties": {
                "mode": {
                  "const": "kinematic"
                },
                "mjcf": {
                  "type": "string",
                  "minLength": 1
                },
                "attach_root": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binding",
            "projection"
          ],
          "properties": {
            "binding": {
              "type": "string",
              "minLength": 1
            },
            "projection": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*\\\\)(?!.*\\s)(?!.*//)(?!.*\\/$)(?!\\.\\.?(/|$))(?!.*(/\\.\\.?)(/|$)).+$"
            }
          }
        },
        "behavior": {
          "$ref": "#/$defs/behavior"
        },
        "semantic_class": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
