{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lingtu.sim.robot-package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "kind", "physics", "visual", "frames", "interfaces", "defaults", "declared_capabilities"],
  "properties": {
    "schema": {"const": "lingtu.sim.robot-package.v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "kind": {"const": "robot"},
    "description": {"type": "string"},
    "compatibility": {"type": "object"},
    "qualification": {"type": "object"},
    "physics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mjcf", "attach_root", "root_joint"],
      "properties": {
        "mjcf": {"type": "string", "minLength": 1},
        "attach_root": {"type": "string", "minLength": 1},
        "root_joint": {"type": "string", "minLength": 1}
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding"],
      "properties": {"binding": {"type": "string", "minLength": 1}}
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {"name": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}}
      }
    },
    "interfaces": {"type": "object", "additionalProperties": false, "required": ["state", "command"]},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "sensor_rig"],
      "properties": {"controller": {"type": ["string", "null"]}, "sensor_rig": {"type": ["string", "null"]}}
    },
    "declared_capabilities": {"type": "object"}
  }
}
