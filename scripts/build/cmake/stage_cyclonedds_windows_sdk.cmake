cmake_minimum_required(VERSION 3.27)

foreach(_required IN ITEMS INSTALL_ROOT SOURCE_ROOT RECEIPT_ROOT LOCK_PATH FINAL_SDK_ROOT EXPECTED_VERSION)
  if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
    message(FATAL_ERROR "${_required} is required")
  endif()
  if(NOT _required MATCHES "^EXPECTED_" AND NOT IS_ABSOLUTE "${${_required}}")
    message(FATAL_ERROR "${_required} must be absolute: ${${_required}}")
  endif()
endforeach()
foreach(_dir IN ITEMS INSTALL_ROOT SOURCE_ROOT RECEIPT_ROOT)
  if(NOT IS_DIRECTORY "${${_dir}}")
    message(FATAL_ERROR "${_dir} is not a directory: ${${_dir}}")
  endif()
endforeach()
if(NOT EXISTS "${LOCK_PATH}" OR IS_DIRECTORY "${LOCK_PATH}")
  message(FATAL_ERROR "LOCK_PATH is not a file: ${LOCK_PATH}")
endif()

set(_quarantine "${FINAL_SDK_ROOT}.incoming")
set(_staging "${FINAL_SDK_ROOT}.incoming.staging")

file(REAL_PATH "${INSTALL_ROOT}" _install_real)
file(REAL_PATH "${SOURCE_ROOT}" _source_real)
file(REAL_PATH "${RECEIPT_ROOT}" _receipt_real)
function(_canonicalize_future_path _input _output)
  get_filename_component(_parent "${_input}" DIRECTORY)
  get_filename_component(_name "${_input}" NAME)
  if(NOT IS_DIRECTORY "${_parent}")
    message(FATAL_ERROR "SDK output parent must already exist for canonicalization: ${_parent}")
  endif()
  file(REAL_PATH "${_parent}" _parent_real)
  cmake_path(SET _canonical NORMALIZE "${_parent_real}/${_name}")
  set(${_output} "${_canonical}" PARENT_SCOPE)
endfunction()
_canonicalize_future_path("${FINAL_SDK_ROOT}" _final_real)
_canonicalize_future_path("${_quarantine}" _quarantine_real)
_canonicalize_future_path("${_staging}" _staging_real)
set(_boundary_names install source receipts final quarantine staging)
set(_boundary_paths "${_install_real}" "${_source_real}" "${_receipt_real}"
                    "${_final_real}" "${_quarantine_real}" "${_staging_real}")
list(LENGTH _boundary_paths _boundary_count)
math(EXPR _boundary_last "${_boundary_count} - 1")
foreach(_left RANGE 0 ${_boundary_last})
  math(EXPR _right_start "${_left} + 1")
  if(_right_start GREATER _boundary_last)
    continue()
  endif()
  foreach(_right RANGE ${_right_start} ${_boundary_last})
    list(GET _boundary_names ${_left} _left_name)
    list(GET _boundary_names ${_right} _right_name)
    list(GET _boundary_paths ${_left} _left_path)
    list(GET _boundary_paths ${_right} _right_path)
    file(TO_CMAKE_PATH "${_left_path}" _left_path)
    file(TO_CMAKE_PATH "${_right_path}" _right_path)
    string(TOLOWER "${_left_path}" _left_lower)
    string(TOLOWER "${_right_path}" _right_lower)
    string(REGEX REPLACE "/+$" "" _left_lower "${_left_lower}")
    string(REGEX REPLACE "/+$" "" _right_lower "${_right_lower}")
    if(_left_lower STREQUAL _right_lower)
      message(FATAL_ERROR "SDK staging paths overlap: ${_left_name}=${_left_path}, ${_right_name}=${_right_path}")
    endif()
    string(FIND "${_left_lower}/" "${_right_lower}/" _left_under_right)
    string(FIND "${_right_lower}/" "${_left_lower}/" _right_under_left)
    if(_left_under_right EQUAL 0 OR _right_under_left EQUAL 0)
      message(FATAL_ERROR "SDK staging paths overlap: ${_left_name}=${_left_path}, ${_right_name}=${_right_path}")
    endif()
  endforeach()
endforeach()

foreach(_forbidden_path IN ITEMS "${FINAL_SDK_ROOT}" "${_quarantine}" "${_staging}")
  if(EXISTS "${_forbidden_path}")
    message(FATAL_ERROR "Refusing to overwrite SDK path: ${_forbidden_path}")
  endif()
endforeach()
get_filename_component(_stage_parent "${FINAL_SDK_ROOT}" DIRECTORY)
if(NOT IS_DIRECTORY "${_stage_parent}")
  message(FATAL_ERROR "SDK parent must already exist: ${_stage_parent}")
endif()

foreach(_relative IN ITEMS
    "include/dds/dds.h" "lib/ddsc.lib" "bin/ddsc.dll" "bin/idlc.exe"
    "lib/cmake/CycloneDDS/CycloneDDSConfig.cmake")
  if(NOT EXISTS "${INSTALL_ROOT}/${_relative}" OR IS_DIRECTORY "${INSTALL_ROOT}/${_relative}")
    message(FATAL_ERROR "CycloneDDS install is missing required SDK file: ${_relative}")
  endif()
endforeach()
foreach(_receipt IN ITEMS source.json toolchain.json build.json)
  if(NOT EXISTS "${RECEIPT_ROOT}/${_receipt}" OR IS_DIRECTORY "${RECEIPT_ROOT}/${_receipt}")
    message(FATAL_ERROR "CycloneDDS build receipt is missing: ${_receipt}")
  endif()
  file(READ "${RECEIPT_ROOT}/${_receipt}" _receipt_json)
  string(JSON _schema ERROR_VARIABLE _json_error GET "${_receipt_json}" schema_version)
  if(_json_error OR NOT _schema EQUAL 1)
    message(FATAL_ERROR "CycloneDDS build receipt is invalid: ${_receipt}")
  endif()
endforeach()

# Microsoft redistributables are prerequisites, never SDK payload. This covers the
# UCRT, VC runtime, STL, OpenMP, PGO, ATL and MFC families rather than a short list.
file(GLOB_RECURSE _installed_files LIST_DIRECTORIES FALSE "${INSTALL_ROOT}/*")
foreach(_installed IN LISTS _installed_files)
  get_filename_component(_name "${_installed}" NAME)
  string(TOLOWER "${_name}" _name_lower)
  if(_name_lower MATCHES "^(api-ms-|ext-ms-|ucrtbase|msvcp|msvcr|vcruntime|concrt|concret|vcomp|vcamp|atl|mfc|mfcm|openmp|pgort|pgosweep|clang_rt)[a-z0-9_.-]*\\.dll$")
    message(FATAL_ERROR "Refusing to stage Microsoft runtime DLL; install VC Redist separately: ${_installed}")
  endif()
endforeach()

set(_license "${SOURCE_ROOT}/LICENSE")
set(_notice "${SOURCE_ROOT}/NOTICE.md")
foreach(_legal IN ITEMS _license _notice)
  if(NOT EXISTS "${${_legal}}" OR IS_DIRECTORY "${${_legal}}")
    message(FATAL_ERROR "Missing upstream legal file: ${${_legal}}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${_staging}")
file(COPY "${INSTALL_ROOT}/" DESTINATION "${_staging}")
file(MAKE_DIRECTORY "${_staging}/licenses" "${_staging}/evidence")
file(COPY_FILE "${_license}" "${_staging}/licenses/LICENSE")
file(COPY_FILE "${_notice}" "${_staging}/licenses/NOTICE.md")
file(COPY_FILE "${LOCK_PATH}" "${_staging}/evidence/source-lock.json")
foreach(_receipt IN ITEMS source.json toolchain.json build.json)
  file(COPY_FILE "${RECEIPT_ROOT}/${_receipt}" "${_staging}/evidence/${_receipt}")
endforeach()

file(READ "${RECEIPT_ROOT}/source.json" _source_receipt)
string(JSON _source_commit ERROR_VARIABLE _source_error GET "${_source_receipt}" commit)
string(LENGTH "${_source_commit}" _source_commit_length)
if(_source_error OR NOT _source_commit MATCHES "^[0-9a-f]+$" OR NOT _source_commit_length EQUAL 40)
  message(FATAL_ERROR "source.json has no valid source commit")
endif()

# Describe every package payload file except the SBOM and its external integrity
# manifest. SPDX 2.3 packageVerificationCode is SHA-1(concat(sorted(file SHA-1))).
file(GLOB_RECURSE _payload_files RELATIVE "${_staging}" LIST_DIRECTORIES FALSE "${_staging}/*")
list(SORT _payload_files)
set(_spdx_files "")
set(_relationships "{\"spdxElementId\":\"SPDXRef-DOCUMENT\",\"relationshipType\":\"DESCRIBES\",\"relatedSpdxElement\":\"SPDXRef-Package-CycloneDDS\"}")
set(_file_sha1s)
set(_separator "")
set(_index 0)
foreach(_relative IN LISTS _payload_files)
  if(_relative MATCHES "^evidence/(files\\.sha256|sbom\\.spdx\\.json)$")
    continue()
  endif()
  file(SHA1 "${_staging}/${_relative}" _sha1)
  file(SHA256 "${_staging}/${_relative}" _sha256)
  list(APPEND _file_sha1s "${_sha1}")
  math(EXPR _index "${_index} + 1")
  string(REPLACE "\\" "/" _spdx_relative "${_relative}")
  set(_file_id "SPDXRef-File-${_index}")
  string(APPEND _spdx_files
    "${_separator}{\"SPDXID\":\"${_file_id}\",\"fileName\":\"./${_spdx_relative}\",\"checksums\":[{\"algorithm\":\"SHA1\",\"checksumValue\":\"${_sha1}\"},{\"algorithm\":\"SHA256\",\"checksumValue\":\"${_sha256}\"}],\"licenseConcluded\":\"NOASSERTION\",\"licenseInfoInFiles\":[\"NOASSERTION\"],\"copyrightText\":\"NOASSERTION\"}")
  string(APPEND _relationships ",{\"spdxElementId\":\"SPDXRef-Package-CycloneDDS\",\"relationshipType\":\"CONTAINS\",\"relatedSpdxElement\":\"${_file_id}\"}")
  set(_separator ",")
endforeach()
list(SORT _file_sha1s)
string(JOIN "" _verification_input ${_file_sha1s})
string(SHA1 _verification_code "${_verification_input}")
string(TIMESTAMP _created "%Y-%m-%dT%H:%M:%SZ" UTC)
string(RANDOM LENGTH 32 ALPHABET 0123456789abcdef _namespace_nonce)
string(UUID _document_uuid NAMESPACE 6ba7b810-9dad-11d1-80b4-00c04fd430c8
       NAME "${EXPECTED_VERSION};${_source_commit};${_created};${_namespace_nonce}" TYPE SHA1)
file(WRITE "${_staging}/evidence/sbom.spdx.json"
  "{\"spdxVersion\":\"SPDX-2.3\",\"SPDXID\":\"SPDXRef-DOCUMENT\",\"dataLicense\":\"CC0-1.0\",\"name\":\"cyclonedds-windows-x64-sdk\",\"documentNamespace\":\"https://inovxio.example/spdx/cyclonedds/${EXPECTED_VERSION}/${_source_commit}/${_document_uuid}\",\"creationInfo\":{\"created\":\"${_created}\",\"creators\":[\"Tool: LingTu-stage-cyclonedds-windows-sdk\"]},\"packages\":[{\"SPDXID\":\"SPDXRef-Package-CycloneDDS\",\"name\":\"Eclipse Cyclone DDS\",\"versionInfo\":\"${EXPECTED_VERSION}\",\"downloadLocation\":\"https://github.com/eclipse-cyclonedds/cyclonedds.git\",\"filesAnalyzed\":true,\"packageVerificationCode\":{\"packageVerificationCodeValue\":\"${_verification_code}\"},\"licenseConcluded\":\"EPL-2.0 OR BSD-3-Clause\",\"licenseDeclared\":\"EPL-2.0 OR BSD-3-Clause\",\"copyrightText\":\"NOASSERTION\"}],\"files\":[${_spdx_files}],\"relationships\":[${_relationships}]}\n")

# This manifest is external to the SBOM and covers the SBOM itself. Only the
# manifest is self-excluded to avoid a circular digest.
file(GLOB_RECURSE _sdk_files RELATIVE "${_staging}" LIST_DIRECTORIES FALSE "${_staging}/*")
list(SORT _sdk_files)
set(_hash_manifest "")
foreach(_relative IN LISTS _sdk_files)
  if(_relative STREQUAL "evidence/files.sha256")
    continue()
  endif()
  file(SHA256 "${_staging}/${_relative}" _sha256)
  string(REPLACE "\\" "/" _manifest_relative "${_relative}")
  string(APPEND _hash_manifest "${_sha256}  ${_manifest_relative}\n")
endforeach()
file(WRITE "${_staging}/evidence/files.sha256" "${_hash_manifest}")

file(RENAME "${_staging}" "${_quarantine}")
message(STATUS "Staged CycloneDDS ${EXPECTED_VERSION} SDK quarantine at ${_quarantine}")
