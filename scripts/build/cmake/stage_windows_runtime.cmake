  "payload=${_stage_payload_receipt}\ndependency-tool=${DEPENDENCY_TOOL}|${_dependency_tool_sha256}\nwindows-system-directory=${_windows_system_directory}\napi-set-schema=${_apiset_schema}|${_apiset_schema_sha256}\nvc-runtime=${_vc_runtime_receipt}\npolicy=windows-system-and-vc-runtime-v1\n")

