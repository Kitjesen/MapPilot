get_filename_component(_slamd_dir "${SLAMD_EXECUTABLE}" DIRECTORY)
get_filename_component(_slamctl_dir "${SLAMCTL_EXECUTABLE}" DIRECTORY)
file(TO_CMAKE_PATH "${_slamd_dir}" _slamd_dir)
file(TO_CMAKE_PATH "${_slamctl_dir}" _slamctl_dir)
string(TOLOWER "${_slamd_dir}/" _slamd_dir_lower)
string(TOLOWER "${_slamctl_dir}/" _slamctl_dir_lower)

set(_copy_runtime)
set(_runtime_metadata)
set(_vcpkg_copyrights)
file(GLOB _vcpkg_ownership_lists "${_dependency_prefix}/../vcpkg/info/*_x64-windows.list")
foreach(_direct_port IN ITEMS eigen3 pcl yaml-cpp)
  file(GLOB _direct_port_lists
       "${_dependency_prefix}/../vcpkg/info/${_direct_port}_*_x64-windows.list")
  list(LENGTH _direct_port_lists _direct_port_list_count)
  if(NOT _direct_port_list_count EQUAL 1)
    message(FATAL_ERROR
      "Direct dependency ${_direct_port} must have exactly one installed vcpkg ownership list; found ${_direct_port_list_count}")
  endif()
  list(GET _direct_port_lists 0 _direct_port_list)
  get_filename_component(_direct_port_list_name "${_direct_port_list}" NAME)
  string(REGEX REPLACE "^${_direct_port}_|_x64-windows\\.list$" "" _direct_port_version
         "${_direct_port_list_name}")
  set(_direct_port_copyright "${_dependency_prefix}/share/${_direct_port}/copyright")
  if(NOT EXISTS "${_direct_port_copyright}")
    message(FATAL_ERROR
      "Real vcpkg copyright evidence is missing for ${_direct_port}: ${_direct_port_copyright}")
  endif()
  list(APPEND _vcpkg_copyrights
       "${_direct_port}|${_direct_port_version}|${_direct_port_copyright}")
endforeach()
foreach(_runtime IN LISTS _resolved)
  file(REAL_PATH "${_runtime}" _runtime_real)
  file(TO_CMAKE_PATH "${_runtime_real}" _runtime_real)
  string(TOLOWER "${_runtime_real}" _runtime_lower)
  if(_runtime_lower MATCHES "^[a-z]:/windows/syswow64/")
    message(FATAL_ERROR "Resolved x86 SysWOW64 dependency is forbidden: ${_runtime_real}")
  endif()
  if(_runtime_lower MATCHES "^[a-z]:/windows/system32/")
    _assert_x64_pe("${_runtime_real}" "Resolved Windows system dependency")
    continue()
  endif()
  string(FIND "${_runtime_lower}" "${_dependency_prefix_lower}" _dependency_index)
  string(FIND "${_runtime_lower}" "${_cyclonedds_prefix_lower}" _cyclone_index)
  string(FIND "${_runtime_lower}" "${_slamd_dir_lower}" _slamd_index)
  string(FIND "${_runtime_lower}" "${_slamctl_dir_lower}" _slamctl_index)
  if(NOT _dependency_index EQUAL 0 AND NOT _cyclone_index EQUAL 0 AND
     NOT _slamd_index EQUAL 0 AND NOT _slamctl_index EQUAL 0)
    message(FATAL_ERROR "Runtime dependency is outside the approved closure: ${_runtime_real}")
  endif()
  _assert_x64_pe("${_runtime_real}" "Resolved runtime dependency")
  get_filename_component(_runtime_name "${_runtime_real}" NAME)
  string(TOLOWER "x64-windows/bin/${_runtime_name}" _runtime_vcpkg_path_lower)
  set(_owners)
  foreach(_ownership_list IN LISTS _vcpkg_ownership_lists)
    file(STRINGS "${_ownership_list}" _owned_files)
    set(_owns_runtime FALSE)
    foreach(_owned_file IN LISTS _owned_files)
      string(REPLACE "\\" "/" _owned_file "${_owned_file}")
      string(TOLOWER "${_owned_file}" _owned_file_lower)
      if(_owned_file_lower STREQUAL _runtime_vcpkg_path_lower)
        set(_owns_runtime TRUE)
      endif()
    endforeach()
    if(_owns_runtime)
      get_filename_component(_ownership_name "${_ownership_list}" NAME)
      if(NOT _ownership_name MATCHES "^([^_]+)_([^_]+)_x64-windows\\.list$")
        message(FATAL_ERROR "Cannot parse vcpkg package/version ownership from ${_ownership_name}")
      endif()
      list(APPEND _owners "${CMAKE_MATCH_1}|${CMAKE_MATCH_2}")
    endif()
  endforeach()
  list(LENGTH _owners _owner_count)
  if(_owner_count GREATER 1)
    message(FATAL_ERROR
      "Runtime DLL ${_runtime_name} must map to at most one installed vcpkg package; found ${_owner_count}")
  endif()
  if(_owner_count EQUAL 1)
    list(GET _owners 0 _owner)
    string(REPLACE "|" ";" _owner_parts "${_owner}")
    list(GET _owner_parts 0 _package)
    list(GET _owner_parts 1 _version)
    set(_authoritative_runtime "${_dependency_prefix}/bin/${_runtime_name}")
    if(NOT EXISTS "${_authoritative_runtime}" OR IS_DIRECTORY "${_authoritative_runtime}")
      message(FATAL_ERROR
        "vcpkg-owned runtime DLL has no authoritative dependency-prefix original: ${_authoritative_runtime}")
    endif()
    file(SHA256 "${_runtime_real}" _resolved_runtime_sha256)
    file(SHA256 "${_authoritative_runtime}" _authoritative_runtime_sha256)
    if(NOT _resolved_runtime_sha256 STREQUAL _authoritative_runtime_sha256)
      message(FATAL_ERROR
        "App-local runtime DLL does not match its authoritative vcpkg original: ${_runtime_real}")
    endif()
    set(_copyright "${_dependency_prefix}/share/${_package}/copyright")
    if(NOT EXISTS "${_copyright}")
      message(FATAL_ERROR "Real vcpkg copyright evidence is missing for ${_package}: ${_copyright}")
    endif()
    list(APPEND _vcpkg_copyrights "${_package}|${_version}|${_copyright}")
  elseif(_dependency_index EQUAL 0)
    message(FATAL_ERROR
      "Runtime DLL under the vcpkg dependency prefix has no installed ownership record: ${_runtime_real}")
  elseif(_cyclone_index EQUAL 0)
    set(_package "CycloneDDS")
    set(_version "${CYCLONEDDS_VERSION}")
    set(_authoritative_runtime "${_runtime_real}")
  else()
    set(_package "LingTu")
    set(_version "local-build")
    set(_authoritative_runtime "${_runtime_real}")
  endif()
  list(APPEND _runtime_metadata
       "bin/${_runtime_name}|${_authoritative_runtime}|${_package}|${_version}")
endforeach()

_assert_x64_pe("${SLAMD_EXECUTABLE}" "slamd executable")
_assert_x64_pe("${SLAMCTL_EXECUTABLE}" "slamctl executable")
set(_source_pairs "bin/slamd.exe|${SLAMD_EXECUTABLE}|LingTu|local-build|x64"
                  "bin/slamctl.exe|${SLAMCTL_EXECUTABLE}|LingTu|local-build|x64")
foreach(_metadata IN LISTS _runtime_metadata)
  list(APPEND _source_pairs "${_metadata}|x64")
endforeach()

list(APPEND _source_pairs "licenses/cyclonedds/LICENSE|${_cyclonedds_license}|CycloneDDS|${CYCLONEDDS_VERSION}|n/a")
list(APPEND _source_pairs "licenses/cyclonedds/NOTICE.md|${_cyclonedds_notice}|CycloneDDS|${CYCLONEDDS_VERSION}|n/a")
list(APPEND _source_pairs "licenses/cyclonedds/sdk-receipt.json|${_cyclonedds_receipt}|CycloneDDS|${CYCLONEDDS_VERSION}|n/a")
list(REMOVE_DUPLICATES _vcpkg_copyrights)
foreach(_entry IN LISTS _vcpkg_copyrights)
  string(REPLACE "|" ";" _parts "${_entry}")
  list(GET _parts 0 _port)
  list(GET _parts 1 _version)
  list(GET _parts 2 _copyright)
  list(APPEND _source_pairs "licenses/vcpkg/${_port}.txt|${_copyright}|${_port}|${_version}|n/a")
endforeach()

list(SORT _source_pairs)
set(_evidence "relative_path\tsha256\tsource_path\tpackage\tversion\tarch\n")
set(_spdx_files "")
set(_packages)
set(_package_file_memberships)
set(_separator "")
set(_file_index 0)
foreach(_pair IN LISTS _source_pairs)
  string(REPLACE "|" ";" _parts "${_pair}")
  list(GET _parts 0 _relative)
  list(GET _parts 1 _source)
  list(GET _parts 2 _package)
  list(GET _parts 3 _version)
  list(GET _parts 4 _arch)
  list(APPEND _packages "${_package}|${_version}")
  file(SHA256 "${_source}" _sha256)
  file(SHA1 "${_source}" _sha1)
  string(APPEND _evidence "${_relative}\t${_sha256}\t${_source}\t${_package}\t${_version}\t${_arch}\n")
  math(EXPR _file_index "${_file_index} + 1")
  string(APPEND _spdx_files "${_separator}{\"SPDXID\":\"SPDXRef-File-${_file_index}\",\"fileName\":\"./${_relative}\",\"checksums\":[{\"algorithm\":\"SHA256\",\"checksumValue\":\"${_sha256}\"}],\"licenseConcluded\":\"NOASSERTION\",\"licenseInfoInFiles\":[\"NOASSERTION\"],\"copyrightText\":\"NOASSERTION\"}")
  list(APPEND _package_file_memberships "${_package}|${_file_index}|${_sha1}|${_relative}")
  set(_separator ",")
endforeach()
list(REMOVE_DUPLICATES _packages)
set(_spdx_packages "")
set(_spdx_relationships "")
set(_package_separator "")
set(_relationship_separator "")
set(_package_index 0)
foreach(_package_entry IN LISTS _packages)
  string(REPLACE "|" ";" _package_parts "${_package_entry}")
  list(GET _package_parts 0 _package)
  list(GET _package_parts 1 _version)
  math(EXPR _package_index "${_package_index} + 1")
  set(_package_sha1s)
  set(_package_file_ids)
  set(_package_has_runtime FALSE)
  foreach(_membership IN LISTS _package_file_memberships)
    string(REPLACE "|" ";" _membership_parts "${_membership}")
    list(GET _membership_parts 0 _member_package)
    if(_member_package STREQUAL _package)
      list(GET _membership_parts 1 _member_file_index)
      list(GET _membership_parts 2 _member_sha1)
      list(GET _membership_parts 3 _member_relative)
      list(APPEND _package_sha1s "${_member_sha1}")
      list(APPEND _package_file_ids "SPDXRef-File-${_member_file_index}")
      if(_member_relative MATCHES "^bin/")
        set(_package_has_runtime TRUE)
      endif()
    endif()
  endforeach()
  if(NOT _package_sha1s)
    message(FATAL_ERROR "SPDX package ${_package} has no staged files")
  endif()
  list(SORT _package_sha1s)
  list(JOIN _package_sha1s "" _package_verification_input)
  string(SHA1 _package_verification_code "${_package_verification_input}")
  set(_package_spdx_id "SPDXRef-Package-${_package_index}")
  if(_package_has_runtime)
    set(_package_analysis_json
      "\"filesAnalyzed\":true,\"packageVerificationCode\":{\"packageVerificationCodeValue\":\"${_package_verification_code}\"}")
  else()
    set(_package_analysis_json "\"filesAnalyzed\":false")
  endif()
  string(APPEND _spdx_packages "${_package_separator}{\"SPDXID\":\"${_package_spdx_id}\",\"name\":\"${_package}\",\"versionInfo\":\"${_version}\",\"downloadLocation\":\"NOASSERTION\",${_package_analysis_json},\"licenseConcluded\":\"NOASSERTION\",\"licenseDeclared\":\"NOASSERTION\",\"copyrightText\":\"NOASSERTION\"}")
  if(_package STREQUAL "LingTu")
    set(_lingtu_package_spdx_id "${_package_spdx_id}")
  elseif(_package STREQUAL "CycloneDDS")
    set(_cyclonedds_package_spdx_id "${_package_spdx_id}")
  elseif(_package STREQUAL "eigen3")
    set(_eigen3_package_spdx_id "${_package_spdx_id}")
  elseif(_package STREQUAL "pcl")
    set(_pcl_package_spdx_id "${_package_spdx_id}")
    set(_pcl_has_runtime "${_package_has_runtime}")
  elseif(_package STREQUAL "yaml-cpp")
    set(_yaml_cpp_package_spdx_id "${_package_spdx_id}")
    set(_yaml_cpp_has_runtime "${_package_has_runtime}")
  endif()
  string(APPEND _spdx_relationships
    "${_relationship_separator}{\"spdxElementId\":\"SPDXRef-DOCUMENT\",\"relationshipType\":\"DESCRIBES\",\"relatedSpdxElement\":\"${_package_spdx_id}\"}")
  set(_relationship_separator ",")
  foreach(_package_file_id IN LISTS _package_file_ids)
    string(APPEND _spdx_relationships
      "${_relationship_separator}{\"spdxElementId\":\"${_package_spdx_id}\",\"relationshipType\":\"CONTAINS\",\"relatedSpdxElement\":\"${_package_file_id}\"}")
  endforeach()
  set(_package_separator ",")
endforeach()
foreach(_required_spdx_id IN ITEMS _lingtu_package_spdx_id _cyclonedds_package_spdx_id
                                   _eigen3_package_spdx_id _pcl_package_spdx_id
                                   _yaml_cpp_package_spdx_id)
  if(NOT DEFINED ${_required_spdx_id})
    message(FATAL_ERROR "SPDX direct-dependency relationship is missing ${_required_spdx_id}")
  endif()
endforeach()
string(APPEND _spdx_relationships
  "${_relationship_separator}{\"spdxElementId\":\"${_lingtu_package_spdx_id}\",\"relationshipType\":\"DEPENDS_ON\",\"relatedSpdxElement\":\"${_eigen3_package_spdx_id}\"}")
set(_relationship_separator ",")
string(APPEND _spdx_relationships
  "${_relationship_separator}{\"spdxElementId\":\"${_lingtu_package_spdx_id}\",\"relationshipType\":\"DYNAMIC_LINK\",\"relatedSpdxElement\":\"${_cyclonedds_package_spdx_id}\"}")
if(_yaml_cpp_has_runtime)
  set(_yaml_cpp_relationship "DYNAMIC_LINK")
else()
  set(_yaml_cpp_relationship "STATIC_LINK")
endif()
string(APPEND _spdx_relationships
  "${_relationship_separator}{\"spdxElementId\":\"${_lingtu_package_spdx_id}\",\"relationshipType\":\"${_yaml_cpp_relationship}\",\"relatedSpdxElement\":\"${_yaml_cpp_package_spdx_id}\"}")
if(_pcl_has_runtime)
  set(_pcl_relationship "DYNAMIC_LINK")
else()
  set(_pcl_relationship "STATIC_LINK")
endif()
string(APPEND _spdx_relationships
  "${_relationship_separator}{\"spdxElementId\":\"${_lingtu_package_spdx_id}\",\"relationshipType\":\"${_pcl_relationship}\",\"relatedSpdxElement\":\"${_pcl_package_spdx_id}\"}")
if(_reuse_existing_stage)
  set(_existing_sbom "${STAGE_ROOT}/evidence/sbom.spdx.json")
  if(NOT EXISTS "${_existing_sbom}")
    message(FATAL_ERROR "Existing stage SPDX evidence is missing: ${_existing_sbom}")
  endif()
  file(READ "${_existing_sbom}" _existing_sbom_json)
  string(JSON _created ERROR_VARIABLE _created_error GET "${_existing_sbom_json}" creationInfo created)
  string(JSON _document_namespace ERROR_VARIABLE _namespace_error GET "${_existing_sbom_json}" documentNamespace)
  if(NOT _created_error STREQUAL "NOTFOUND" OR
     NOT _created MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z$" OR
     NOT _namespace_error STREQUAL "NOTFOUND" OR
     NOT _document_namespace MATCHES "^https://inovxio[.]invalid/spdx/lingtu-slam-windows/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z$")
    message(FATAL_ERROR "Existing stage SPDX creation identity is invalid")
  endif()
else()
  string(TIMESTAMP _created "%Y-%m-%dT%H:%M:%SZ" UTC)
  string(TIMESTAMP _namespace_id "%Y%m%dT%H%M%SZ" UTC)
  set(_document_namespace "https://inovxio.invalid/spdx/lingtu-slam-windows/${_namespace_id}")
endif()
set(_prerequisites_json
  "{\"prerequisites\":[{\"name\":\"Microsoft Visual C++ Redistributable\",\"architecture\":\"x64\",\"runtime\":\"/MD\"}]}\n")
set(_stage_receipt_text "${_stage_input_receipt}\n")
set(_stage_receipt_json
  "{\"schema_version\":1,\"reuse_key_sha256\":\"${_stage_input_receipt}\",\"payload_sha256\":\"${_stage_payload_receipt}\",\"architecture\":\"x64\",\"policy\":\"windows-system-and-vc-runtime-v1\"}\n")
set(_sbom_json
  "{\"spdxVersion\":\"SPDX-2.3\",\"SPDXID\":\"SPDXRef-DOCUMENT\",\"name\":\"lingtu-slam-windows-runtime\",\"dataLicense\":\"CC0-1.0\",\"documentNamespace\":\"${_document_namespace}\",\"creationInfo\":{\"created\":\"${_created}\",\"creators\":[\"Tool: LingTu stage_windows_runtime.cmake\"]},\"packages\":[${_spdx_packages}],\"files\":[${_spdx_files}],\"relationships\":[${_spdx_relationships}]}\n")

if(_reuse_existing_stage)
  _verify_existing_stage()
  foreach(_pair IN LISTS _source_pairs)
    string(REPLACE "|" ";" _parts "${_pair}")
    list(GET _parts 0 _relative)
    list(GET _parts 1 _source)
    set(_staged_source_copy "${STAGE_ROOT}/${_relative}")
    if(NOT EXISTS "${_staged_source_copy}")
      message(FATAL_ERROR "Existing staged file is missing for current authoritative input: ${_relative}")
    endif()
    file(SHA256 "${_source}" _expected_source_sha256)
    file(SHA256 "${_staged_source_copy}" _actual_staged_sha256)
    if(NOT _actual_staged_sha256 STREQUAL _expected_source_sha256)
      message(FATAL_ERROR "Existing staged file does not match current authoritative input: ${_relative}")
    endif()
  endforeach()
  foreach(_expected_evidence IN ITEMS
      "evidence/runtime-dependencies.tsv|${_evidence}"
      "evidence/prerequisites.json|${_prerequisites_json}"
      "evidence/vc-runtime-files.tsv|${_vc_runtime_receipt}"
      "evidence/stage-receipt.sha256|${_stage_receipt_text}"
      "evidence/stage-receipt.json|${_stage_receipt_json}"
      "evidence/sbom.spdx.json|${_sbom_json}")
    string(REPLACE "|" ";" _expected_evidence_parts "${_expected_evidence}")
    list(GET _expected_evidence_parts 0 _evidence_relative)
    list(REMOVE_AT _expected_evidence_parts 0)
    list(JOIN _expected_evidence_parts "|" _expected_evidence_text)
    file(READ "${STAGE_ROOT}/${_evidence_relative}" _actual_evidence_text)
    if(NOT _actual_evidence_text STREQUAL _expected_evidence_text)
      message(FATAL_ERROR "Existing stage evidence does not match current authoritative input: ${_evidence_relative}")
    endif()
  endforeach()
  set(_expected_stage_entries)
  foreach(_pair IN LISTS _source_pairs)
    string(REPLACE "|" ";" _parts "${_pair}")
    list(GET _parts 0 _relative)
    list(GET _parts 1 _source)
    file(SHA256 "${_source}" _expected_sha256)
    list(APPEND _expected_stage_entries "${_relative}|${_expected_sha256}")
  endforeach()
  foreach(_expected_evidence IN ITEMS
      "evidence/runtime-dependencies.tsv|${_evidence}"
      "evidence/prerequisites.json|${_prerequisites_json}"
      "evidence/vc-runtime-files.tsv|${_vc_runtime_receipt}"
      "evidence/stage-receipt.sha256|${_stage_receipt_text}"
      "evidence/stage-receipt.json|${_stage_receipt_json}"
      "evidence/sbom.spdx.json|${_sbom_json}")
    string(REPLACE "|" ";" _expected_evidence_parts "${_expected_evidence}")
    list(GET _expected_evidence_parts 0 _evidence_relative)
    list(REMOVE_AT _expected_evidence_parts 0)
    list(JOIN _expected_evidence_parts "|" _expected_evidence_text)
    string(REPLACE "\n" "\r\n" _expected_evidence_file_bytes "${_expected_evidence_text}")
    string(SHA256 _expected_evidence_sha256 "${_expected_evidence_file_bytes}")
    list(APPEND _expected_stage_entries "${_evidence_relative}|${_expected_evidence_sha256}")
  endforeach()
  list(SORT _expected_stage_entries)
  set(_expected_stage_manifest "")
  set(_expected_stage_paths "evidence/stage-files.sha256")
  foreach(_expected_stage_entry IN LISTS _expected_stage_entries)
    string(REPLACE "|" ";" _expected_stage_parts "${_expected_stage_entry}")
    list(GET _expected_stage_parts 0 _expected_stage_relative)
    list(GET _expected_stage_parts 1 _expected_stage_sha256)
    list(APPEND _expected_stage_paths "${_expected_stage_relative}")
    string(APPEND _expected_stage_manifest "${_expected_stage_sha256}  ${_expected_stage_relative}\n")
  endforeach()
  file(READ "${STAGE_ROOT}/evidence/stage-files.sha256" _actual_stage_manifest)
  if(NOT _actual_stage_manifest STREQUAL _expected_stage_manifest)
    message(FATAL_ERROR "Existing stage manifest is not derived from current authoritative inputs")
  endif()
  file(GLOB_RECURSE _actual_stage_paths LIST_DIRECTORIES false RELATIVE "${STAGE_ROOT}"
       "${STAGE_ROOT}/*")
  list(SORT _actual_stage_paths)
  list(SORT _expected_stage_paths)
  if(NOT _actual_stage_paths STREQUAL _expected_stage_paths)
    message(FATAL_ERROR "Existing stage file coverage is not derived from current authoritative inputs")
  endif()
  message(STATUS "Existing stage already matches verified receipt and current authoritative inputs: ${STAGE_ROOT}")
  return()
endif()

