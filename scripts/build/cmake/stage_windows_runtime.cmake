file(GET_RUNTIME_DEPENDENCIES
  EXECUTABLES "${SLAMD_EXECUTABLE}" "${SLAMCTL_EXECUTABLE}"
  DIRECTORIES "${_dependency_prefix}/bin" "${_cyclonedds_prefix}/bin"
  RESOLVED_DEPENDENCIES_VAR _resolved
  UNRESOLVED_DEPENDENCIES_VAR _unresolved
  CONFLICTING_DEPENDENCIES_PREFIX _conflicts
  PRE_EXCLUDE_REGEXES ${_system_pre_exclude_regexes}
  POST_EXCLUDE_REGEXES "${_windows_system_path_regex}"
  POST_EXCLUDE_FILES ${_system_post_exclude_files})

if(_unresolved)
  set(_unverified_unresolved)
  foreach(_missing IN LISTS _unresolved)
    set(_system_candidate "${_windows_system_directory}/${_missing}")
    if(EXISTS "${_system_candidate}" AND NOT IS_DIRECTORY "${_system_candidate}")
      _assert_x64_pe("${_system_candidate}" "Resolved Windows system prerequisite")
      file(SHA256 "${_system_candidate}" _system_sha256)
      list(APPEND _verified_system_contracts "${_missing}|${_system_candidate}|${_system_sha256}|x64")
    elseif(_missing MATCHES "^(api-ms-|ext-ms-)")
      list(APPEND _verified_system_contracts "${_missing}|${_apiset_schema}|api-set-schema|x64")
    else()
      list(APPEND _unverified_unresolved "${_missing}")
    endif()
  endforeach()
  set(_unresolved ${_unverified_unresolved})
endif()
if(_unresolved)
  list(JOIN _unresolved ", " _unresolved_text)
  message(FATAL_ERROR "Unresolved Windows runtime dependencies: ${_unresolved_text}")
endif()
if(_conflicts_FILENAMES)
  list(JOIN _conflicts_FILENAMES ", " _conflicts_text)
