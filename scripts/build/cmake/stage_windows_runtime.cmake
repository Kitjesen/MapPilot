function(_verify_existing_stage)
  set(_existing_receipt "${STAGE_ROOT}/evidence/stage-receipt.sha256")
  if(NOT EXISTS "${_existing_receipt}")
    message(FATAL_ERROR "Existing stage has no verified input receipt: ${STAGE_ROOT}")
  endif()
  file(READ "${_existing_receipt}" _existing_receipt_value)
  string(STRIP "${_existing_receipt_value}" _existing_receipt_value)
  if(NOT _existing_receipt_value STREQUAL _stage_input_receipt)
    message(FATAL_ERROR "Existing stage receipt does not match current inputs: ${STAGE_ROOT}")
  endif()
  set(_existing_stage_manifest "${STAGE_ROOT}/evidence/stage-files.sha256")
  if(NOT EXISTS "${_existing_stage_manifest}")
    message(FATAL_ERROR "Existing stage exact-set manifest is missing: ${_existing_stage_manifest}")
  endif()
  file(STRINGS "${_existing_stage_manifest}" _existing_stage_manifest_lines)
  set(_existing_stage_manifest_paths)
  foreach(_stage_manifest_line IN LISTS _existing_stage_manifest_lines)
    if(NOT _stage_manifest_line MATCHES "^([0-9a-f]+)  (.+)$")
      message(FATAL_ERROR "Malformed existing stage manifest line: ${_stage_manifest_line}")
    endif()
    set(_expected_stage_file_sha256 "${CMAKE_MATCH_1}")
    set(_stage_manifest_relative "${CMAKE_MATCH_2}")
    if(IS_ABSOLUTE "${_stage_manifest_relative}" OR
       _stage_manifest_relative MATCHES "(^|/)\\.\\.(/|$)" OR
       _stage_manifest_relative IN_LIST _existing_stage_manifest_paths OR
       _stage_manifest_relative STREQUAL "evidence/stage-files.sha256")
      message(FATAL_ERROR "Unsafe or duplicate existing stage manifest path: ${_stage_manifest_relative}")
    endif()
    set(_stage_manifest_file "${STAGE_ROOT}/${_stage_manifest_relative}")
    if(NOT EXISTS "${_stage_manifest_file}" OR IS_DIRECTORY "${_stage_manifest_file}")
      message(FATAL_ERROR "Existing staged manifest file is missing: ${_stage_manifest_relative}")
    endif()
    file(SHA256 "${_stage_manifest_file}" _actual_stage_file_sha256)
    if(NOT _actual_stage_file_sha256 STREQUAL _expected_stage_file_sha256)
      message(FATAL_ERROR "Existing staged manifest file hash mismatch: ${_stage_manifest_relative}")
    endif()
    list(APPEND _existing_stage_manifest_paths "${_stage_manifest_relative}")
  endforeach()
  file(GLOB_RECURSE _existing_stage_files LIST_DIRECTORIES false RELATIVE "${STAGE_ROOT}" "${STAGE_ROOT}/*")
  foreach(_existing_stage_relative IN LISTS _existing_stage_files)
    string(REPLACE "\\" "/" _existing_stage_relative "${_existing_stage_relative}")
    if(_existing_stage_relative STREQUAL "evidence/stage-files.sha256")
      continue()
    endif()
    if(NOT _existing_stage_relative IN_LIST _existing_stage_manifest_paths)
      message(FATAL_ERROR "Existing staged file is not covered by exact-set manifest: ${_existing_stage_relative}")
    endif()
  endforeach()
  set(_existing_evidence "${STAGE_ROOT}/evidence/runtime-dependencies.tsv")
  if(NOT EXISTS "${_existing_evidence}")
    message(FATAL_ERROR "Existing stage runtime evidence is missing: ${_existing_evidence}")
  endif()
  file(STRINGS "${_existing_evidence}" _existing_evidence_lines)
  list(REMOVE_AT _existing_evidence_lines 0)
  foreach(_evidence_line IN LISTS _existing_evidence_lines)
    if(NOT _evidence_line MATCHES "^([^\t]+)\t([0-9a-fA-F]+)\t")
      message(FATAL_ERROR "Malformed existing stage evidence line: ${_evidence_line}")
    endif()
    set(_existing_relative "${CMAKE_MATCH_1}")
    string(TOLOWER "${CMAKE_MATCH_2}" _expected_existing_sha256)
    if(IS_ABSOLUTE "${_existing_relative}" OR _existing_relative MATCHES "(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "Unsafe path in existing stage evidence: ${_existing_relative}")
    endif()
    set(_existing_file "${STAGE_ROOT}/${_existing_relative}")
    if(NOT EXISTS "${_existing_file}" OR IS_DIRECTORY "${_existing_file}")
      message(FATAL_ERROR "Existing staged file is missing: ${_existing_file}")
    endif()
    file(SHA256 "${_existing_file}" _actual_existing_sha256)
    if(NOT _actual_existing_sha256 STREQUAL _expected_existing_sha256)
      message(FATAL_ERROR "Existing staged file hash mismatch: ${_existing_file}")
    endif()
  endforeach()
endfunction()

set(_pe_candidates "${SLAMD_EXECUTABLE}" "${SLAMCTL_EXECUTABLE}")
file(GLOB _dependency_pe "${_dependency_prefix}/bin/*.dll")
file(GLOB _cyclonedds_pe "${_cyclonedds_prefix}/bin/*.dll")
list(APPEND _pe_candidates ${_dependency_pe} ${_cyclonedds_pe})
set(_system_post_exclude_files)
set(_system_pre_exclude_regexes)
set(_verified_system_contracts)
set(_system_scan_queue)
foreach(_candidate IN LISTS _pe_candidates)
  if(NOT EXISTS "${_candidate}")
    continue()
  endif()
  execute_process(
    COMMAND "${DEPENDENCY_TOOL}" /DEPENDENTS "${_candidate}"
    RESULT_VARIABLE _dependents_result
    OUTPUT_VARIABLE _dependents_output
    ERROR_VARIABLE _dependents_error)
  if(NOT _dependents_result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect PE dependencies for ${_candidate}: ${_dependents_error}")
  endif()
  string(REGEX MATCHALL "[A-Za-z0-9_.-]+\\.dll" _import_names "${_dependents_output}")
  foreach(_import_name IN LISTS _import_names)
    if(EXISTS "${_windows_system_directory}/${_import_name}")
      file(REAL_PATH "${_windows_system_directory}/${_import_name}" _system_import)
      _assert_x64_pe("${_system_import}" "Direct Windows system prerequisite")
      string(TOLOWER "${_system_import}" _system_import_lower)
      string(TOUPPER "${_system_import}" _system_import_upper)
      file(TO_NATIVE_PATH "${_system_import}" _system_import_native)
      file(TO_NATIVE_PATH "${_system_import_lower}" _system_import_lower_native)
      file(TO_NATIVE_PATH "${_system_import_upper}" _system_import_upper_native)
      list(APPEND _system_post_exclude_files
           "${_system_import}" "${_system_import_lower}" "${_system_import_upper}"
           "${_system_import_native}" "${_system_import_lower_native}"
           "${_system_import_upper_native}")
      _case_insensitive_filename_regex("${_import_name}" _system_import_regex)
      list(APPEND _system_pre_exclude_regexes "${_system_import_regex}")
    elseif(_import_name MATCHES "^(api-ms-|ext-ms-)")
      list(APPEND _verified_system_contracts "${_import_name}")
      _case_insensitive_filename_regex("${_import_name}" _api_set_regex)
      list(APPEND _system_pre_exclude_regexes "${_api_set_regex}")
    endif()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES _system_post_exclude_files)
list(REMOVE_DUPLICATES _system_pre_exclude_regexes)

