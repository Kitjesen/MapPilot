function(_assert_x64_pe _path _description)
  execute_process(
    COMMAND "${DEPENDENCY_TOOL}" /HEADERS "${_path}"
    RESULT_VARIABLE _headers_result
    OUTPUT_VARIABLE _headers_output
    ERROR_VARIABLE _headers_error)
  if(NOT _headers_result EQUAL 0 OR
     NOT _headers_output MATCHES "8664 machine")
    message(FATAL_ERROR "${_description} is not a verified Windows x64 PE: ${_path}; ${_headers_error}")
  endif()
endfunction()

function(_case_insensitive_filename_regex _name _out_var)
  string(LENGTH "${_name}" _name_length)
  set(_regex "^")
  math(EXPR _last_index "${_name_length} - 1")
  foreach(_index RANGE 0 ${_last_index})
    string(SUBSTRING "${_name}" ${_index} 1 _character)
    string(TOLOWER "${_character}" _lower)
    string(TOUPPER "${_character}" _upper)
    if(_lower MATCHES "^[a-z]$")
      string(APPEND _regex "[${_lower}${_upper}]")
    elseif(_character STREQUAL ".")
      string(APPEND _regex "\\.")
    else()
      string(APPEND _regex "${_character}")
    endif()
  endforeach()
  string(APPEND _regex "$")
  set(${_out_var} "${_regex}" PARENT_SCOPE)
endfunction()

function(_compute_tree_sha256 _prefix _out_var)
  set(_tree_files)
  foreach(_root IN LISTS ARGN)
    file(GLOB_RECURSE _root_files LIST_DIRECTORIES false RELATIVE "${_prefix}"
         "${_prefix}/${_root}/*")
    list(APPEND _tree_files ${_root_files})
  endforeach()
  list(REMOVE_DUPLICATES _tree_files)
  list(SORT _tree_files)
  set(_tree_receipt "")
  foreach(_relative IN LISTS _tree_files)
    file(SHA256 "${_prefix}/${_relative}" _file_sha256)
    string(APPEND _tree_receipt "${_relative}|${_file_sha256}\n")
  endforeach()
  string(SHA256 _tree_sha256 "${_tree_receipt}")
  set(${_out_var} "${_tree_sha256}" PARENT_SCOPE)
endfunction()

