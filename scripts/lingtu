# -- Subcommand: gateway-runtime-acceptance --
cmd_gateway_runtime_acceptance() {
    local repo_root python_bin
    repo_root="$(lingtu_repo_root)"
    python_bin="$(lingtu_python)"
    case "${1:-}" in
        -h|--help)
            cmd_gateway_runtime_acceptance_usage
            return 0 ;;
    esac
    local -a cmd=("$python_bin" "$repo_root/lingtu.py" gateway-runtime-acceptance)
    if ! lingtu_has_option "--gateway-url" "$@"; then
        cmd+=(--gateway-url "$GW")
    fi
    cmd+=("$@")
    "${cmd[@]}"
}

