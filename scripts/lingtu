# -- Subcommand: evidence --
cmd_evidence_usage() {
    echo "Usage: lingtu evidence [--duration SEC] [--min-motion-m M] [--min-cmd-vel-norm V] [--json] [--json-out PATH] [--expected-command-subscriber NAME] [--no-validate]"
    echo "Collect read-only Thunder field runtime evidence for topics, frames, data flow, and command boundary."
    echo "Requires an active real run publishing /slam/odometry, /slam/map_cloud, /slam/localization_health, and /slam/localization_quality."
}

cmd_evidence() {
    local duration="20"
    local out_path=""
    local json_flag=0
    local no_validate=0
    local repo_root
    local python_bin
    local min_motion_m=""
    local min_cmd_vel_norm=""
    local -a expected_subscribers=()

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --duration|--duration-sec)
                [ -n "${2:-}" ] || { cmd_evidence_usage; return 1; }
                duration="$2"
                shift 2 ;;
            --duration=*|--duration-sec=*)
                duration="${1#*=}"
                shift ;;
            --json)
                json_flag=1
                shift ;;
            --min-motion-m)
                [ -n "${2:-}" ] || { cmd_evidence_usage; return 1; }
                min_motion_m="$2"
                shift 2 ;;
            --min-motion-m=*)
                min_motion_m="${1#*=}"
                shift ;;
            --min-cmd-vel-norm)
                [ -n "${2:-}" ] || { cmd_evidence_usage; return 1; }
                min_cmd_vel_norm="$2"
                shift 2 ;;
            --min-cmd-vel-norm=*)
                min_cmd_vel_norm="${1#*=}"
                shift ;;
            --json-out)
                [ -n "${2:-}" ] || { cmd_evidence_usage; return 1; }
                out_path="$2"
                shift 2 ;;
            --json-out=*)
                out_path="${1#*=}"
                shift ;;
            --expected-command-subscriber)
                [ -n "${2:-}" ] || { cmd_evidence_usage; return 1; }
                expected_subscribers+=("$2")
                shift 2 ;;
            --expected-command-subscriber=*)
                expected_subscribers+=("${1#*=}")
                shift ;;
            --no-validate)
                no_validate=1
                shift ;;
            -h|--help)
                cmd_evidence_usage
                return 0 ;;
            *)
                cmd_evidence_usage
                return 1 ;;
        esac
    done

    case "$duration" in
        ''|*[!0-9.]*)
            echo "duration must be a numeric number of seconds" >&2
            return 1 ;;
    esac

    repo_root="$(lingtu_repo_root)"
    python_bin="$(lingtu_python)"
    if [ -z "$out_path" ]; then
        out_path="$repo_root/artifacts/real_runtime/report.json"
    fi
    mkdir -p "$(dirname "$out_path")"

    local -a cmd=(
        "$python_bin" "$repo_root/lingtu.py" real-runtime-evidence
        --duration-sec "$duration"
        --json-out "$out_path"
    )
    local subscriber
    for subscriber in "${expected_subscribers[@]}"; do
        cmd+=(--expected-command-subscriber "$subscriber")
    done
    [ -n "$min_motion_m" ] && cmd+=(--min-motion-m "$min_motion_m")
    [ -n "$min_cmd_vel_norm" ] && cmd+=(--min-cmd-vel-norm "$min_cmd_vel_norm")
    [ "$json_flag" = "1" ] && cmd+=(--json)
    [ "$no_validate" = "1" ] && cmd+=(--no-validate)

    echo "Collecting read-only real runtime evidence..." >&2
    echo "Report: $out_path" >&2
    "${cmd[@]}"
}

