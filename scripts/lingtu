#!/usr/bin/env bash
# lingtu — unified CLI for Lingtu operations + monitoring.
#
# 所有日常运维 + 建图/导航切换 + 状态查询的唯一入口。取代:
#   - scripts/mapping_status.sh
#   - scripts/lingtu_status.sh
#   - 零散 curl / systemctl 命令
#
# 用法:
#   lingtu status              # 一次状态快照
#   lingtu status --explain    # 当前 Product/session/systemd 参数来源
#   lingtu inspect nav --explain # 解析 Product 参数及其来源，不启动进程
#   lingtu watch               # 持续监控 (watch -c -n 1)
#   lingtu map start           # 进 mapping 模式
#   lingtu map save <name>     # 保存地图 (PGO + DUFOMap + tomogram)
#   lingtu map end             # 结束当前 session → idle
#   lingtu map list            # 列出已保存地图
#   lingtu map restore <name>  # 恢复 DUFOMap 清洗前的备份 (.predufo → map.pcd)
#   lingtu nav start <map>     # 进 navigating 模式, 加载指定地图
#   lingtu nav stop            # 结束 (同 map end)
#   lingtu nav goal X Y [YAW]  # 发导航目标 (map frame)
#   lingtu explore start [--map MAP] # 激活 explore Product，保持任务未启动
#   lingtu explore task start  # readiness 通过后显式启动自主探索任务
#   lingtu explore status      # 查看当前探索任务状态
#   lingtu explore stop        # 通过 ProductControl 停稳并停止当前 Product
#   lingtu svc status          # RunPlan logical process status
#   lingtu svc restart slam    # restart active Product's logical SLAM process
#   lingtu svc restart all     # reapply the committed active Product
#   lingtu log drift           # 看 drift watchdog 日志
#   lingtu log dufomap         # 看 DUFOMap 保存日志
#   lingtu log error           # 看最近报错
#   lingtu log tail            # 实时滚动 (journalctl -f)
#   lingtu health              # REST /api/v1/health 详情
#   lingtu --env real|sim ...  # outer runtime environment (default: real)
#
# 本机使用 (Windows/Mac SSH 到 Thunder):
#   ssh sunrise@192.168.66.13 "bash ~/data/SLAM/navigation/scripts/lingtu status"
#
# 建议设 alias 到本机 ~/.bashrc:
#   alias lingtu='ssh sunrise@192.168.66.13 "bash ~/data/SLAM/navigation/scripts/lingtu"'
#   alias lingwatch='ssh -t sunrise@192.168.66.13 "bash ~/data/SLAM/navigation/scripts/lingtu watch"'
#
# Current Product process operations:
#   lingtu svc status          # current RunPlan process state (read-only)
#   lingtu svc restart slam    # restart one logical process from the active RunPlan
#   lingtu svc restart all     # reapply the exact committed active Product
#   lingtu doctor              # read-only service/topic/Gateway diagnostics
#   lingtu doctor --non-motion --json --strict
#   lingtu soak --duration 120 --json --strict # non-motion readiness soak
#   lingtu runtime-spec sim --json # resolved local Profile data-flow/frame contract
#   lingtu runtime-contract --json # canonical topics, frames, and runtime contracts
#   lingtu runtime-audit --json # static runtime contract guard
#   lingtu dataflow [topic] # Gateway + ModulePorts runtime flow, no ROS2 topic inspection
#   lingtu gateway-runtime-acceptance --acceptance-mode field # Gateway-only product acceptance
#   lingtu field-check [map-dir] # one-screen field readiness, optional saved-map provenance
#   lingtu inspection-check [map-dir] --point lobby # non-motion inspection-point acceptance pack
#   lingtu saved-map-artifact-gate <map-dir> # same-source saved-map/tomogram/occupancy gate
#   lingtu teleop-preflight --stage contract --pretty --strict # read-only teleop_avoid gate
#   lingtu system-acceptance --map <name> --goal X Y YAW # That-nav parity gate, no motion by default
#   lingtu evidence --duration 20 --json-out report.json # read-only runtime data-flow/frame evidence
#   lingtu record [SESSION_DIR] [--camera] [native options] # foreground DDS recording; Ctrl-C stops
#   lingtu record topics       # list supported native DDS topics and replay policy
#   lingtu replay SESSION_DIR|MCAP [player options] # isolated DDS replay (domain 84)
#   lingtu bag [SESSION_DIR]    # short alias for record
#   lingtu play SESSION_DIR|MCAP # short alias for replay
set -u
GW="${GW:-http://localhost:5050}"
MAP_DIR="${MAP_DIR:-${NAV_MAP_DIR:-$HOME/data/nova/maps}}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LINGTU_ENV="${LINGTU_ENV:-real}"

case "${1:-}" in
    --env)
        [ "$#" -ge 2 ] || { echo "--env requires real or sim" >&2; exit 2; }
        LINGTU_ENV="$2"
        shift 2
        ;;
    --env=*)
        LINGTU_ENV="${1#*=}"
        shift
        ;;
esac
case "$LINGTU_ENV" in
    real|sim) ;;
    *) echo "invalid --env: $LINGTU_ENV (expected real or sim)" >&2; exit 2 ;;
esac
export LINGTU_ENV

lingtu_repo_root() {
    cd "$SCRIPT_DIR/.." && pwd
}

lingtu_python() {
    printf "%s\n" "${LINGTU_PYTHON:-python3}"
}

lingtu_control() {
    local repo py
    repo="$(lingtu_repo_root)"
    py="$(lingtu_python)"
    PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
        "$py" -m lingtu.control "$@" --json
}

gateway_operator_request() {
    local api_key="${LINGTU_API_KEY:-}"
    if [ -n "$api_key" ]; then
        if [[ ! "$api_key" =~ ^[A-Za-z0-9_-]{64,}$ ]]; then
            echo "LINGTU_API_KEY must contain at least 64 URL-safe characters" >&2
            return 1
        fi
        printf 'header = "X-API-Key: %s"\n' "$api_key" \
            | curl --disable --config - "$@"
        return $?
    fi
    if [ "$LINGTU_ENV" != "real" ]; then
        curl --disable "$@"
        return $?
    fi

    case "$GW" in
        http://127.0.0.1:*|http://localhost:*|http://\[::1\]:*) ;;
        *)
            echo "LINGTU_API_KEY is required for remote operator Gateway commands" >&2
            return 1 ;;
    esac

    local session_id="${LINGTU_PRODUCT_SESSION_ID:-}"
    local session_file="${LINGTU_SESSION_ROOT:-/run/lingtu}/session.env"
    if [ -z "$session_id" ] && [ -r "$session_file" ]; then
        local line
        while IFS= read -r line; do
            line="${line%$'\r'}"
            case "$line" in
                LINGTU_PRODUCT_SESSION_ID=*)
                    session_id="${line#LINGTU_PRODUCT_SESSION_ID=}"
                    session_id="${session_id#\"}"
                    session_id="${session_id%\"}"
                    break ;;
            esac
        done < "$session_file"
    fi
    if [[ ! "$session_id" =~ ^[A-Za-z0-9_.-]{1,96}$ ]]; then
        echo "Current Product session credential is unavailable" >&2
        return 1
    fi
    printf 'header = "X-LingTu-Product-Session: %s"\n' "$session_id" \
        | curl --disable --config - "$@"
}

run_python_gate() {
    local gate="$1" repo py maps_root
    shift
    repo="$(lingtu_repo_root)"
    py="$(lingtu_python)"
    maps_root="$(lingtu_maps_root)"
    PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
        "$py" "$repo/scripts/gates/$gate" \
        --env "$LINGTU_ENV" --gateway-url "$GW" --maps-root "$maps_root" "$@"
}

lingtu_has_option() {
    local opt="$1"
    shift || true
    local arg
    for arg in "$@"; do
        case "$arg" in
            "$opt"|"$opt"=*)
                return 0 ;;
        esac
    done
    return 1
}

# Colors (stripped when piping / non-tty)
if [ -t 1 ]; then
    B='\033[1m'; G='\033[32m'; Y='\033[33m'; R='\033[31m'; C='\033[36m'; M='\033[35m'; D='\033[2m'; N='\033[0m'
else
    B=''; G=''; Y=''; R=''; C=''; M=''; D=''; N=''
fi

# ── JSON helper (feed blob via stdin, run python snippet) ──
pjson() { echo "$1" | python3 -c "
import sys,json,math
try: d=json.load(sys.stdin)
except Exception:
    print('-'); sys.exit(0)
$2
" 2>/dev/null || echo '-'; }

resolve_relocation_map_name() {
    python3 - "$1" "$2" <<'PY'
import sys
from pathlib import Path

root = Path(sys.argv[1]).expanduser().resolve()
raw = sys.argv[2]
if not raw:
    sys.exit(1)
raw_path = Path(raw).expanduser()
candidate = raw_path if raw_path.is_absolute() else root / raw_path
try:
    rel = candidate.resolve(strict=False).relative_to(root)
except Exception:
    sys.exit(1)
if len(rel.parts) != 1:
    sys.exit(1)
name = rel.parts[0]
if not name or name in (".", "..") or "/" in name or "\\" in name:
    sys.exit(1)
print(name)
PY
}

lingtu_maps_root() {
    if [ -n "${NAV_MAP_DIR:-}" ]; then
        printf "%s\n" "$NAV_MAP_DIR"
        return 0
    fi
    if [ -n "${MAP_DIR:-}" ] && [ "$MAP_DIR" != "$HOME/data/nova/maps" ]; then
        printf "%s\n" "$MAP_DIR"
        return 0
    fi
    if [ -d "$HOME/data/nova/maps" ]; then
        printf "%s\n" "$HOME/data/nova/maps"
        return 0
    fi
    if [ -d "$HOME/data/lingtu/maps" ]; then
        printf "%s\n" "$HOME/data/lingtu/maps"
        return 0
    fi
    printf "%s\n" "${MAP_DIR:-$HOME/data/nova/maps}"
}

format_nav_goal_payload() {
    python3 - "$1" "$2" "$3" <<'PY'
import json
import math
import sys

try:
    x, y, yaw = (float(v) for v in sys.argv[1:4])
except Exception:
    sys.exit(1)
if not all(math.isfinite(v) for v in (x, y, yaw)):
    sys.exit(1)
print(json.dumps({"x": x, "y": y, "z": 0.0, "yaw": yaw}, separators=(",", ":")))
PY
}

nav_forward_goal_args() {
    local distance="${1:-0.08}" path_json loc_json
    path_json=$(curl -s --max-time 5 "$GW/api/v1/path" 2>/dev/null || echo '{}')
    loc_json=$(curl -s --max-time 5 "$GW/api/v1/localization/status" 2>/dev/null || echo '{}')
    python3 - "$distance" "$path_json" "$loc_json" <<'PY'
import json
import math
import sys

try:
    distance = float(sys.argv[1])
    path = json.loads(sys.argv[2])
    loc = json.loads(sys.argv[3])
except Exception:
    sys.exit(1)
robot = path.get("robot") if isinstance(path, dict) else {}
tf = loc.get("map_odom_tf") if isinstance(loc, dict) else {}
try:
    ox = float(robot.get("x"))
    oy = float(robot.get("y"))
    oyaw = float(robot.get("yaw", 0.0))
except Exception:
    sys.exit(1)
if not all(math.isfinite(v) for v in (distance, ox, oy, oyaw)):
    sys.exit(1)
tx = ty = tyaw = 0.0
if isinstance(tf, dict) and tf.get("valid", True):
    try:
        tx = float(tf.get("tx", 0.0))
        ty = float(tf.get("ty", 0.0))
        qx = float(tf.get("qx", 0.0))
        qy = float(tf.get("qy", 0.0))
        qz = float(tf.get("qz", 0.0))
        qw = float(tf.get("qw", 1.0))
        tyaw = math.atan2(2.0 * (qw * qz + qx * qy), 1.0 - 2.0 * (qy * qy + qz * qz))
    except Exception:
        tx = ty = tyaw = 0.0
c = math.cos(tyaw)
s = math.sin(tyaw)
mx = tx + c * ox - s * oy
my = ty + s * ox + c * oy
myaw = oyaw + tyaw
gx = mx + math.cos(myaw) * distance
gy = my + math.sin(myaw) * distance
print(f"{gx:.3f} {gy:.3f} {myaw:.3f}")
PY
}

nav_goal_precheck() {
    local payload="$1"
    local NAVJ CAN BLOCKERS ADVISORIES STATE PLANJ FEASIBLE COUNT PLANNER REASONS POLICY SAFETY_OK FALLBACK REJECTED
    NAVJ=$(curl -s --max-time 3 "$GW/api/v1/navigation/status" 2>/dev/null || echo '{}')
    CAN=$(pjson "$NAVJ" 'r=d.get("readiness") or {}; print(str(r.get("can_accept_goal", d.get("can_accept_goal", False))).lower())')
    BLOCKERS=$(pjson "$NAVJ" 'r=d.get("readiness") or {}; b=r.get("blockers") or []; print(",".join(map(str,b)) if isinstance(b,list) else str(b or ""))')
    ADVISORIES=$(pjson "$NAVJ" 'r=d.get("readiness") or {}; a=r.get("advisories") or []; print(",".join(map(str,a)) if isinstance(a,list) else str(a or ""))')
    STATE=$(pjson "$NAVJ" 'print(d.get("state","unknown"))')
    if [ "$CAN" != "true" ]; then
        printf "${R}FAIL${N}: navigation is not ready for goals (state=%s blockers=%s advisories=%s)\n" \
            "$STATE" "${BLOCKERS:-unknown}" "${ADVISORIES:-unknown}"
        return 1
    fi

    # S100P OctoPlanner3D previews on saved 3D maps are commonly ~6-7s.
    # Keep this above normal planner latency so field gates fail on planner
    # results, not on a tight CLI transport timeout.
    PLANJ=$(curl -s --max-time 30 -X POST -H "Content-Type: application/json" \
        -d "$payload" "$GW/api/v1/navigation/plan" 2>/dev/null || echo '{}')
    FEASIBLE=$(pjson "$PLANJ" 'print(str(bool(d.get("feasible"))).lower())')
    COUNT=$(pjson "$PLANJ" 'print(d.get("count","-"))')
    PLANNER=$(pjson "$PLANJ" 'print(d.get("selected_planner") or d.get("planner") or "-")')
    POLICY=$(pjson "$PLANJ" 'print(d.get("plan_safety_policy") or "-")')
    SAFETY_OK=$(pjson "$PLANJ" 's=d.get("path_safety") if isinstance(d.get("path_safety"),dict) else {}; v=s.get("ok","-"); print(str(v).lower() if isinstance(v,bool) else v)')
    FALLBACK=$(pjson "$PLANJ" 'print(d.get("fallback_reason") or "-")')
    REJECTED=$(pjson "$PLANJ" 'r=d.get("rejected_plans") or []; print(len(r) if isinstance(r,list) else 0)')
    REASONS=$(pjson "$PLANJ" 'r=d.get("reasons") or []; print(",".join(map(str,r)) if isinstance(r,list) else str(r or ""))')
    if [ "$FEASIBLE" != "true" ]; then
        printf "${R}FAIL${N}: navigation plan preview is not feasible (points=%s planner=%s policy=%s safety=%s fallback=%s rejected=%s reasons=%s)\n" \
            "$COUNT" "$PLANNER" "$POLICY" "$SAFETY_OK" "$FALLBACK" "$REJECTED" "${REASONS:-unknown}"
        return 1
    fi
    printf "${D}plan preview feasible: points=%s planner=%s policy=%s safety=%s fallback=%s rejected=%s${N}\n" \
        "$COUNT" "$PLANNER" "$POLICY" "$SAFETY_OK" "$FALLBACK" "$REJECTED"
    return 0
}

saved_map_plan_precheck() {
    local map_name="$1" payload="$2" json_out="${3:-}"
    local PLANJ MAP_OK EXEC_OK COUNT PLANNER REASONS POLICY SAFETY_OK FALLBACK REJECTED
    PLANJ=$(curl -s --max-time 30 -X POST -H "Content-Type: application/json" \
        -d "$payload" "$GW/api/v1/maps/$map_name/validate_plan" 2>/dev/null || echo '{}')
    if [ -n "$json_out" ]; then
        printf '%s\n' "$PLANJ" > "$json_out"
        printf '%s\n' "$PLANJ" | python3 -m json.tool > "${json_out%.json}.pretty.json" 2>/dev/null || true
    fi
    MAP_OK=$(pjson "$PLANJ" 'print(str(bool(d.get("map_plan_ok", d.get("success", d.get("ok", False))))).lower())')
    EXEC_OK=$(pjson "$PLANJ" 'print(str(bool(d.get("executable_feasible", False))).lower())')
    COUNT=$(pjson "$PLANJ" 'p=d.get("preview") if isinstance(d.get("preview"),dict) else {}; print(p.get("count", d.get("count","-")))')
    PLANNER=$(pjson "$PLANJ" 'p=d.get("preview") if isinstance(d.get("preview"),dict) else {}; print(p.get("selected_planner") or p.get("planner") or "-")')
    POLICY=$(pjson "$PLANJ" 'e=d.get("executable_preview") if isinstance(d.get("executable_preview"),dict) else {}; print(e.get("plan_safety_policy") or "-")')
    SAFETY_OK=$(pjson "$PLANJ" 's=d.get("live_path_safety") if isinstance(d.get("live_path_safety"),dict) else {}; v=s.get("ok","-"); print(str(v).lower() if isinstance(v,bool) else v)')
    FALLBACK=$(pjson "$PLANJ" 'e=d.get("executable_preview") if isinstance(d.get("executable_preview"),dict) else {}; p=d.get("preview") if isinstance(d.get("preview"),dict) else {}; print(e.get("fallback_reason") or p.get("fallback_reason") or "-")')
    REJECTED=$(pjson "$PLANJ" 'p=d.get("preview") if isinstance(d.get("preview"),dict) else {}; r=p.get("rejected_plans") or []; print(len(r) if isinstance(r,list) else 0)')
    REASONS=$(pjson "$PLANJ" 'g=d.get("no_motion_gate") if isinstance(d.get("no_motion_gate"),dict) else {}; r=g.get("blockers") or []; print(",".join(map(str,r)) if isinstance(r,list) else str(r or ""))')
    if [ "$MAP_OK" != "true" ]; then
        printf "${R}FAIL${N}: saved-map plan validation failed (map_plan_ok=%s executable_feasible=%s points=%s planner=%s policy=%s safety=%s fallback=%s rejected=%s reasons=%s)\n" \
            "$MAP_OK" "$EXEC_OK" "$COUNT" "$PLANNER" "$POLICY" "$SAFETY_OK" "$FALLBACK" "$REJECTED" "${REASONS:-unknown}"
        return 1
    fi
    printf "${D}saved-map plan valid: map_plan_ok=%s executable_feasible=%s points=%s planner=%s policy=%s safety=%s fallback=%s rejected=%s${N}\n" \
        "$MAP_OK" "$EXEC_OK" "$COUNT" "$PLANNER" "$POLICY" "$SAFETY_OK" "$FALLBACK" "$REJECTED"
    if [ "$EXEC_OK" != "true" ]; then
        printf "${Y}WARN${N}: map plan is valid but live safety/costmap says not executable yet (reasons=%s)\n" \
            "${REASONS:-unknown}"
    fi
    return 0
}

# ── Subcommand: status (one-shot status board) ──
cmd_status() {
    if [ "${1:-}" = "--explain" ]; then
        shift
        [ "$#" -eq 0 ] || { echo "Usage: lingtu status [--explain]" >&2; return 2; }
        local repo py
        repo="$(lingtu_repo_root)"
        py="$(lingtu_python)"
        PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
            "$py" -m lingtu.explain status --explain
        return $?
    fi
    [ "$#" -eq 0 ] || { echo "Usage: lingtu status [--explain]" >&2; return 2; }
    echo -e "${B}=== Lingtu @ $(date '+%H:%M:%S') ===${N}"
    local SESS HEALTH STATE PATHJ LOCJ
    SESS=$(curl -s --max-time 2 "$GW/api/v1/session" 2>/dev/null || echo '{}')
    LOCJ=$(curl -s --max-time 2 "$GW/api/v1/localization/status" 2>/dev/null || echo '{}')
    HEALTH=$(curl -s --max-time 2 "$GW/api/v1/health" 2>/dev/null || echo '{}')
    STATE=$(curl -s --max-time 2 "$GW/api/v1/state" 2>/dev/null || echo '{}')
    PATHJ=$(curl -s --max-time 2 "$GW/api/v1/path" 2>/dev/null || echo '{}')

    local MODE MAP CAN_M MC
    MODE=$(pjson "$SESS" 'print(d.get("mode","?"))')
    MAP=$(pjson "$SESS" 'print(d.get("active_map") or "-")')
    CAN_M=$(pjson "$SESS" 'print(d.get("can_start_mapping",False))')
    case "$MODE" in
        mapping|exploring) MC="${G}${MODE}${N}" ;;
        navigating)        MC="${C}${MODE}${N}" ;;
        idle)              MC="${D}${MODE}${N}" ;;
        *)                 MC="${R}${MODE}${N}" ;;
    esac
    printf "${B}[1] Session${N}   mode=%b  map=${C}%s${N}  can_map=%s\n" "$MC" "$MAP" "$CAN_M"

    local HZ LIVE LOC LOC_CAUSE HZC LOCC SLAM_BACKEND HEALTH_SOURCE RELOC_STATE
    local RECOVERY_SIGNAL SAVED_RELOC RESTART_RECOVERY RECOVERY_METHOD SLAM_EXTRA
    HZ=$(pjson "$HEALTH" 'print(d["sensors"]["slam"].get("hz","?"))')
    LIVE=$(pjson "$HEALTH" 'print(d.get("map_points",0))')
    LOC=$(pjson "$STATE" 'print(d.get("dialogue",{}).get("localization","-"))')
    LOC_CAUSE=$(pjson "$STATE" 'print(d.get("dialogue",{}).get("loc_root_cause","") or "")')
    SLAM_BACKEND=$(pjson "$LOCJ" 'print(d.get("backend") or d.get("localization_backend") or "-")')
    [ "$SLAM_BACKEND" = "-" ] && SLAM_BACKEND=$(pjson "$SESS" 'print(d.get("localization_backend") or "-")')
    HEALTH_SOURCE=$(pjson "$LOCJ" 'print(d.get("health_source") or d.get("localizer_health_source") or "-")')
    [ "$HEALTH_SOURCE" = "-" ] && HEALTH_SOURCE=$(pjson "$SESS" 'print(d.get("health_source") or "-")')
    RELOC_STATE=$(pjson "$LOCJ" 'print(d.get("relocalization_state") or "-")')
    [ "$RELOC_STATE" = "-" ] && RELOC_STATE=$(pjson "$SESS" 'print(d.get("relocalization_state") or "-")')
    RECOVERY_SIGNAL=$(pjson "$LOCJ" 'print(d.get("recovery_signal") or "-")')
    [ "$RECOVERY_SIGNAL" = "-" ] && RECOVERY_SIGNAL=$(pjson "$SESS" 'print(d.get("recovery_signal") or "-")')
    SAVED_RELOC=$(pjson "$LOCJ" 'v=d.get("saved_map_relocalization_supported", d.get("relocalization_supported")); print(v if v is not None else "-")')
    [ "$SAVED_RELOC" = "-" ] && SAVED_RELOC=$(pjson "$SESS" 'v=d.get("saved_map_relocalization_supported", d.get("relocalization_supported")); print(v if v is not None else "-")')
    RESTART_RECOVERY=$(pjson "$LOCJ" 'v=d.get("restart_recovery_supported"); print(v if v is not None else "-")')
    [ "$RESTART_RECOVERY" = "-" ] && RESTART_RECOVERY=$(pjson "$SESS" 'v=d.get("restart_recovery_supported"); print(v if v is not None else "-")')
    RECOVERY_METHOD=$(pjson "$LOCJ" 'print(d.get("recovery_method") or "-")')
    [ "$RECOVERY_METHOD" = "-" ] && RECOVERY_METHOD=$(pjson "$SESS" 'print(d.get("recovery_method") or "-")')
    SLAM_EXTRA=""
    case "$SLAM_BACKEND" in ""|-|None|null) ;; *) SLAM_EXTRA="${SLAM_EXTRA}  backend=${SLAM_BACKEND}" ;; esac
    case "$HEALTH_SOURCE" in ""|-|None|null) ;; *) SLAM_EXTRA="${SLAM_EXTRA}  health_src=${HEALTH_SOURCE}" ;; esac
    case "$RELOC_STATE" in ""|-|None|null) ;; *) SLAM_EXTRA="${SLAM_EXTRA}  relocal=${RELOC_STATE}" ;; esac
    case "$RECOVERY_SIGNAL" in ""|-|None|null) ;; *) SLAM_EXTRA="${SLAM_EXTRA}  recover=${RECOVERY_SIGNAL}" ;; esac
    case "$SAVED_RELOC" in ""|-|None|null) ;; *) SLAM_EXTRA="${SLAM_EXTRA}  saved_reloc=${SAVED_RELOC}" ;; esac
    case "$RESTART_RECOVERY" in ""|-|None|null) ;; *) SLAM_EXTRA="${SLAM_EXTRA}  restart_rec=${RESTART_RECOVERY}" ;; esac
    case "$RECOVERY_METHOD" in ""|-|None|null) ;; *) SLAM_EXTRA="${SLAM_EXTRA}  recovery_method=${RECOVERY_METHOD}" ;; esac
    if awk "BEGIN{exit !($HZ < 5)}" 2>/dev/null; then HZC="${R}${HZ}${N}"
    elif awk "BEGIN{exit !($HZ < 20)}" 2>/dev/null; then HZC="${Y}${HZ}${N}"
    else HZC="${G}${HZ}${N}"; fi
    case "$LOC" in
        GOOD|OK)  LOCC="${G}${LOC}${N}" ;;
        DEGRADED) LOCC="${Y}${LOC}${N}${D} (${LOC_CAUSE})${N}" ;;
        LOST)     LOCC="${R}${LOC}${N}${D} (${LOC_CAUSE})${N}" ;;
        *)        LOCC="$LOC" ;;
    esac
    printf "${B}[2] SLAM${N}      hz=${HZC}Hz  live_pts=%s  loc=%b%s\n" "$LIVE" "$LOCC" "$SLAM_EXTRA"

    local RX RY RZ YAW VX WZ ABSURD
    RX=$(pjson "$STATE" 'print(round(float(d["odometry"].get("x",0)),2))')
    RY=$(pjson "$STATE" 'print(round(float(d["odometry"].get("y",0)),2))')
    RZ=$(pjson "$STATE" 'print(round(float(d["odometry"].get("z",0)),2))')
    YAW=$(pjson "$STATE" 'print(round(math.degrees(float(d["odometry"].get("yaw",0))),1))')
    VX=$(pjson "$STATE" 'print(round(float(d["odometry"].get("vx",0)),2))')
    WZ=$(pjson "$STATE" 'print(round(float(d["odometry"].get("wz",0)),2))')
    ABSURD=$(pjson "$STATE" 'o=d["odometry"]; print(1 if max(abs(float(o.get("x",0))),abs(float(o.get("y",0))))>10000 else 0)')
    if [ "$ABSURD" = "1" ]; then
        printf "${B}[3] Robot${N}     ${R}ODOM DIVERGED${N} x=%s y=%s — watchdog 60s 内会救\n" "$RX" "$RY"
    else
        printf "${B}[3] Robot${N}     xy=(%s,%s) z=%s yaw=%s°  v=%sm/s w=%srad/s\n" "$RX" "$RY" "$RZ" "$YAW" "$VX" "$WZ"
    fi

    local MSTATE WP_I WP_T REPLAN SPEED DEG MSC DEGC
    MSTATE=$(pjson "$STATE" 'print(d.get("mission",{}).get("state","?"))')
    WP_I=$(pjson "$STATE" 'print(d.get("mission",{}).get("wp_index",0))')
    WP_T=$(pjson "$STATE" 'print(d.get("mission",{}).get("wp_total",0))')
    REPLAN=$(pjson "$HEALTH" 'print(d["sensors"]["navigation"].get("replan_count",0))')
    SPEED=$(pjson "$STATE" 'print(d.get("mission",{}).get("speed_scale",1.0))')
    DEG=$(pjson "$STATE" 'print(d.get("mission",{}).get("degeneracy","-"))')
    case "$MSTATE" in
        EXECUTING|PLANNING|SUCCEEDED) MSC="${G}${MSTATE}${N}" ;;
        FAILED|ABORTED)               MSC="${R}${MSTATE}${N}" ;;
        IDLE|STANDBY)                 MSC="${D}${MSTATE}${N}" ;;
        *)                            MSC="${Y}${MSTATE}${N}" ;;
    esac
    case "$DEG" in
        NONE|OK)  DEGC="${G}${DEG}${N}" ;;
        WARN)     DEGC="${Y}${DEG}${N}" ;;
        CRITICAL) DEGC="${R}${DEG}${N}" ;;
        *)        DEGC="$DEG" ;;
    esac
    printf "${B}[4] Mission${N}   state=%b  wp=%s/%s  replan=%s  speed=%s  deg=%b\n" "$MSC" "$WP_I" "$WP_T" "$REPLAN" "$SPEED" "$DEGC"

    local PPTS PSTATS
    PPTS=$(pjson "$PATHJ" 'p=d.get("path",[]); print(len(p) if isinstance(p,list) else 0)')
    if [ "$PPTS" = "0" ] || [ "$PPTS" = "-" ]; then
        printf "${B}[5] Path${N}      ${D}(no active plan)${N}\n"
    else
        PSTATS=$(echo "$PATHJ" | python3 -c "
import sys,json,math
try:
    d=json.load(sys.stdin); pts=d.get('path',[]); r=d.get('robot',{}) or {}
    if not pts: print('- - -'); sys.exit(0)
    L=sum(math.hypot(pts[i-1].get('x',0)-pts[i].get('x',0), pts[i-1].get('y',0)-pts[i].get('y',0)) for i in range(1,len(pts)))
    f=math.hypot(r.get('x',0)-pts[0].get('x',0), r.get('y',0)-pts[0].get('y',0))
    g=math.hypot(r.get('x',0)-pts[-1].get('x',0), r.get('y',0)-pts[-1].get('y',0))
    print(f'{L:.1f} {f:.2f} {g:.2f}')
except Exception: print('- - -')
" 2>/dev/null)
        read PLEN DN DGOAL <<< "$PSTATS"
        printf "${B}[5] Path${N}      pts=%s  len=%sm  next=%sm  goal=%sm\n" "$PPTS" "$PLEN" "$DN" "$DGOAL"
    fi

    local TELE TELE_N SAFETY SC
    TELE=$(pjson "$STATE" 'print(d.get("teleop",{}).get("active",False))')
    TELE_N=$(pjson "$STATE" 'print(d.get("teleop",{}).get("clients",0))')
    SAFETY=$(pjson "$STATE" 'print(d.get("safety",{}).get("level","-"))')
    case "$SAFETY" in
        0)   SC="${G}OK${N}" ;;
        1)   SC="${Y}WARN${N}" ;;
        2|3) SC="${R}STOP${N}" ;;
        *)   SC="$SAFETY" ;;
    esac
    printf "${B}[6] Ctrl${N}      teleop=%s(%s)  safety=%b\n" "$TELE" "$TELE_N" "$SC"

    local LATEST NAME MTIME PCD BAK BAK_FILE PAT CLEAN_TAG CLEAN DIRTY DROP PCT MAP_SAVE_SOURCE MAP_EXTRA
    MAP_SAVE_SOURCE=$(pjson "$LOCJ" 'print(d.get("map_save_source") or "-")')
    [ "$MAP_SAVE_SOURCE" = "-" ] && MAP_SAVE_SOURCE=$(pjson "$SESS" 'print(d.get("map_save_source") or "-")')
    MAP_EXTRA=""
    case "$MAP_SAVE_SOURCE" in ""|-|None|null) ;; *) MAP_EXTRA="  save_src=${MAP_SAVE_SOURCE}" ;; esac
    LATEST=$(ls -dt "$MAP_DIR"/*/ 2>/dev/null | head -1)
    if [ -n "$LATEST" ]; then
        NAME=$(basename "$LATEST")
        MTIME=$(stat -c '%y' "$LATEST" 2>/dev/null | cut -d' ' -f2 | cut -d. -f1)
        PCD="-"; BAK="-"; BAK_FILE=""; PAT="-"; CLEAN_TAG=""
        [ -f "$LATEST/map.pcd" ]         && PCD=$(du -h "$LATEST/map.pcd" | cut -f1)
        [ -f "$LATEST/map.pcd.preclean" ] && BAK_FILE="$LATEST/map.pcd.preclean"
        [ -z "$BAK_FILE" ] && [ -f "$LATEST/map.pcd.predufo" ] && BAK_FILE="$LATEST/map.pcd.predufo"
        [ -n "$BAK_FILE" ] && BAK=$(du -h "$BAK_FILE" | cut -f1)
        [ -d "$LATEST/patches" ]         && PAT=$(ls "$LATEST/patches" 2>/dev/null | wc -l)
        if [ -f "$LATEST/map.pcd" ] && [ -n "$BAK_FILE" ]; then
            CLEAN=$(stat -c %s "$LATEST/map.pcd" | awk '{printf "%d",$1/16}')
            DIRTY=$(stat -c %s "$BAK_FILE" | awk '{printf "%d",$1/16}')
            DROP=$((DIRTY-CLEAN))
            [ "$DIRTY" -gt 0 ] && PCT=$(awk -v d=$DROP -v t=$DIRTY 'BEGIN{printf "%.1f",100*d/t}') || PCT=0
            CLEAN_TAG="${G}clean -${DROP}pts (${PCT}%)${N}"
        fi
        printf "${B}[7] Map${N}       %s ${D}@%s${N}  map=%s  bak=%s  patches=%s%s  %b\n" "$NAME" "$MTIME" "$PCD" "$BAK" "$PAT" "$MAP_EXTRA" "$CLEAN_TAG"
    else
        printf "${B}[7] Map${N}       ${D}(no maps)${N}%s\n" "$MAP_EXTRA"
    fi

    local LOG
    LOG=$(journalctl -u lingtu.service --since '10 min ago' --no-pager 2>/dev/null \
        | grep -iE 'drift_watchdog|dufomap|static_cleaner|dynamic_filter|\[ERROR\]' \
        | grep -vE 'VectorMemory|sentence_trans|webrtc.*dispose' | tail -3)
    if [ -n "$LOG" ]; then
        printf "${B}[8] Log${N}       ${D}(recent drift/cleanup/error)${N}\n"
        echo "$LOG" | sed "s/^/             /"
    fi
}

cmd_inspect() {
    [ "$#" -ge 1 ] || { echo "Usage: lingtu inspect <product> --explain [--set KEY=VALUE]" >&2; return 2; }
    local repo py
    repo="$(lingtu_repo_root)"
    py="$(lingtu_python)"
    PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
        "$py" -m lingtu.explain inspect "$@" --env "$LINGTU_ENV"
}

# ── Subcommand: watch (persistent refresh) ──
cmd_watch() { exec watch -c -n "${1:-1}" bash "${BASH_SOURCE[0]}" status; }

# -- Subcommand: mode --
mode_switch_usage() {
    echo "Usage: lingtu --env real|sim mode switch <product> [--map NAME] [--current PRODUCT] [--relocalize|--no-relocalize] [--initial-pose X Y YAW]"
    echo "       lingtu mode stop-session"
    echo "ProductControl owns preflight, motion stop, map/SLAM staging, process launch, readiness, and fail-closed cleanup."
}

cmd_mode() {
    local action="${1:-}"
    case "$action" in
        switch)
            shift
            local target="${1:-}" repo py
            [ -n "$target" ] || { mode_switch_usage; return 1; }
            shift
            repo="$(lingtu_repo_root)"
            py="$(lingtu_python)"
            PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
                "$py" -m lingtu.control switch "$target" --env "$LINGTU_ENV" "$@" --json
            ;;
        stop-session)
            shift
            local repo py
            repo="$(lingtu_repo_root)"
            py="$(lingtu_python)"
            PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
                "$py" -m lingtu.control stop-session "$@" --json
            ;;
        -h|--help|"")
            mode_switch_usage
            ;;
        *)
            mode_switch_usage
            return 1
            ;;
    esac
}
format_map_save_payload() {
    python3 - "$1" "$2" <<'PY'
import json
import re
import sys

name, request_id = sys.argv[1:3]
if re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_-]{0,127}", request_id) is None:
    sys.exit(1)
print(json.dumps({"name": name, "request_id": request_id}, ensure_ascii=False, separators=(",", ":")))
PY
}

map_save_classify_response() {
    local phase="$1" expected_request_id="$2" expected_operation_id="$3"
    python3 - "$phase" "$expected_request_id" "$expected_operation_id" 3<&0 <<'PY'
import json
import os
import sys

phase, expected_request_id, expected_operation_id = sys.argv[1:4]
try:
    payload = json.load(os.fdopen(3))
except Exception:
    sys.exit(2)
if not isinstance(payload, dict):
    sys.exit(2)

operation = payload.get("operation")
if not isinstance(operation, dict) and phase == "status":
    status_payload = payload.get("status")
    operation = status_payload if isinstance(status_payload, dict) else {}
operation = operation if isinstance(operation, dict) else {}
state = str(operation.get("state") or "").upper()

def identity_values(value, field):
    if isinstance(value, dict):
        for key, item in value.items():
            if key == field:
                yield item
            else:
                yield from identity_values(item, field)
    elif isinstance(value, list):
        for item in value:
            yield from identity_values(item, field)

request_ids = list(identity_values(payload, "request_id"))
operation_ids = list(identity_values(payload, "operation_id"))
if not request_ids and not operation_ids:
    print("MISSING_IDENTITY")
    sys.exit(0)
if any(value != expected_request_id for value in request_ids):
    print("IDENTITY_MISMATCH")
    sys.exit(0)
if expected_operation_id and not operation_ids:
    print("MISSING_IDENTITY")
    sys.exit(0)
if expected_operation_id and any(value != expected_operation_id for value in operation_ids):
    print("IDENTITY_MISMATCH")
    sys.exit(0)

if phase == "status":
    if payload.get("ok") is not True or payload.get("success") is not True or not operation:
        print("QUERY_FAILED")
    elif state in {"WAITING_SNAPSHOT", "QUEUED", "RUNNING"}:
        print("RUNNING")
    elif state == "SUCCEEDED":
        print("REPLAY")
    elif state == "FAILED":
        print("FAILED")
    elif state == "CANCELLED":
        print("CANCELLED")
    else:
        print("UNKNOWN_STATE")
    sys.exit(0)

status = str(payload.get("status") or "").lower()
if state in {"WAITING_SNAPSHOT", "QUEUED", "RUNNING"} or (
    not state and payload.get("accepted") is True and status == "running"
):
    print("RUNNING" if payload.get("ok") is True and payload.get("accepted") is True and status == "running" else "FAILED")
elif state == "FAILED":
    print("FAILED")
elif state == "CANCELLED":
    print("CANCELLED")
elif state != "SUCCEEDED":
    print("MISSING_DURABLE_SUCCESS")
elif payload.get("ok") is not True or payload.get("success") is not True:
    print("FAILED")
elif status == "partial" or payload.get("navigation_ready") is not True:
    print("PARTIAL")
elif payload.get("compatibility_ready") is not True:
    print("COMPATIBILITY_DEGRADED")
elif status != "ready":
    print("NOT_READY")
else:
    print("SUCCESS")
PY
}

map_save_extract_operation_id() {
    python3 - 3<&0 <<'PY'
import json
import os
import sys

try:
    payload = json.load(os.fdopen(3))
except Exception:
    sys.exit(2)

values = []

def collect(value):
    if isinstance(value, dict):
        for key, item in value.items():
            if key == "operation_id" and isinstance(item, str) and item.strip():
                values.append(item.strip())
            else:
                collect(item)
    elif isinstance(value, list):
        for item in value:
            collect(item)

collect(payload)
unique = set(values)
if len(unique) != 1:
    sys.exit(1)
print(unique.pop())
PY
}

map_save_print_json() {
    printf '%s\n' "$1" | python3 -m json.tool 2>/dev/null || printf '%s\n' "$1"
}

map_save_response_kind() {
    local phase="$1" request_id="$2" operation_id="$3" response="$4"
    printf '%s' "$response" | map_save_classify_response "$phase" "$request_id" "$operation_id"
}

gateway_map_request() {
    local credential_file="${LINGTU_MAP_CLIENT_ENV_FILE:-/etc/lingtu/map-client.env}"
    local link_count map_api_key=""
    local -a credential_lines=()

    if [ -L "$credential_file" ]; then
        echo -e "${R}FAIL${N}: unsafe map client credential file" >&2
        return 1
    fi
    if [ ! -e "$credential_file" ]; then
        if [ "$LINGTU_ENV" = "real" ]; then
            echo -e "${R}FAIL${N}: a map client credential file is required in env=real" >&2
            return 1
        fi
        curl --disable "$@"
        return $?
    fi
    if [ ! -f "$credential_file" ] || [ ! -r "$credential_file" ]; then
        echo -e "${R}FAIL${N}: unsafe map client credential file" >&2
        return 1
    fi
    link_count=$(stat -c '%h' -- "$credential_file" 2>/dev/null) || {
        echo -e "${R}FAIL${N}: unable to inspect the map client credential file" >&2
        return 1
    }
    if [ "$link_count" != "1" ]; then
        echo -e "${R}FAIL${N}: unsafe map client credential file" >&2
        return 1
    fi
    if ! mapfile -t credential_lines < "$credential_file"; then
        echo -e "${R}FAIL${N}: unable to read the map client credential file" >&2
        return 1
    fi
    if [ "${#credential_lines[@]}" -ne 1 ]; then
        echo -e "${R}FAIL${N}: malformed map client credential file" >&2
        return 1
    fi
    if [[ ! "${credential_lines[0]}" =~ ^LINGTU_MAP_API_KEY=([A-Za-z0-9_-]{64,})$ ]]; then
        echo -e "${R}FAIL${N}: malformed map client credential file" >&2
        return 1
    fi
    map_api_key="${BASH_REMATCH[1]}"

    printf 'header = "X-API-Key: %s"\n' "$map_api_key" \
        | curl --disable --config - "$@"
}

map_save_post() {
    local payload="$1" http_timeout_s="$2"
    gateway_map_request -fsS --max-time "$http_timeout_s" -X POST \
        -H "Content-Type: application/json" \
        --data-binary "$payload" \
        "$GW/api/v1/map/save"
}

cmd_map_save() {
    local name="$1" request_id="${LINGTU_MAP_SAVE_REQUEST_ID:-}"
    local timeout_s="${LINGTU_MAP_SAVE_TIMEOUT_SEC:-600}"
    local http_timeout_s="${LINGTU_MAP_SAVE_HTTP_TIMEOUT_SEC:-600}"
    local poll_interval_s="${LINGTU_MAP_SAVE_POLL_INTERVAL_SEC:-1}"
    local payload response kind parse_status deadline operation_id last_response=""

    case "$timeout_s" in ''|*[!0-9]*) echo "LINGTU_MAP_SAVE_TIMEOUT_SEC must be a non-negative integer" >&2; return 1 ;; esac
    case "$http_timeout_s" in ''|0|*[!0-9]*) echo "LINGTU_MAP_SAVE_HTTP_TIMEOUT_SEC must be a positive integer" >&2; return 1 ;; esac
    if ! python3 - "$poll_interval_s" <<'PY'
import math
import sys

try:
    value = float(sys.argv[1])
except Exception:
    sys.exit(1)
sys.exit(0 if math.isfinite(value) and value > 0.0 else 1)
PY
    then
        echo "LINGTU_MAP_SAVE_POLL_INTERVAL_SEC must be a positive number" >&2
        return 1
    fi

    if [ -z "$request_id" ]; then
        request_id=$(python3 - <<'PY'
import secrets
import time

alphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
timestamp_ms = (time.time_ns() // 1_000_000) & ((1 << 48) - 1)
value = (timestamp_ms << 80) | secrets.randbits(80)
encoded = ["0"] * 26
for index in range(25, -1, -1):
    encoded[index] = alphabet[value & 0x1F]
    value >>= 5
print("".join(encoded))
PY
) || return 1
    fi
    payload=$(format_map_save_payload "$name" "$request_id") || {
        echo "Invalid map save request_id: $request_id" >&2
        return 1
    }

    echo "Save request_id: $request_id"
    echo "Reuse LINGTU_MAP_SAVE_REQUEST_ID=$request_id to replay this exact save request idempotently."
    response=$(map_save_post "$payload" "$http_timeout_s") || {
        echo -e "${R}FAIL${N}: map save request failed (network, timeout, or HTTP error); request_id=$request_id" >&2
        return 1
    }
    kind=$(map_save_response_kind submit "$request_id" "" "$response")
    parse_status=$?
    if [ "$parse_status" -ne 0 ]; then
        echo -e "${R}FAIL${N}: map save returned invalid JSON; request_id=$request_id" >&2
        printf '%s\n' "$response" >&2
        return 1
    fi
    operation_id=$(printf '%s' "$response" | map_save_extract_operation_id) || {
        echo -e "${R}FAIL${N}: map save response did not return one stable operation_id; request_id=$request_id" >&2
        return 1
    }
    case "$kind" in
        SUCCESS)
            map_save_print_json "$response"
            echo -e "${G}PASS${N}: durable navigation map is ready; request_id=$request_id"
            return 0
            ;;
        RUNNING)
            echo "Map save operation accepted: $operation_id; waiting for durable terminal state..."
            ;;
        *)
            map_save_print_json "$response"
            echo -e "${R}FAIL${N}: map save did not produce a durable navigation-ready result ($kind); request_id=$request_id" >&2
            return 1
            ;;
    esac

    deadline=$((SECONDS + timeout_s))
    while [ "$SECONDS" -lt "$deadline" ]; do
        response=$(gateway_map_request -fsS --max-time "$http_timeout_s" \
            "$GW/api/v1/maps/operations/$operation_id") || {
            echo -e "${R}FAIL${N}: map save status query failed (network, timeout, or HTTP error); operation_id=$operation_id" >&2
            return 1
        }
        last_response="$response"
        kind=$(map_save_response_kind status "$request_id" "$operation_id" "$response")
        parse_status=$?
        if [ "$parse_status" -ne 0 ]; then
            echo -e "${R}FAIL${N}: map save status returned invalid JSON; request_id=$request_id" >&2
            printf '%s\n' "$response" >&2
            return 1
        fi
        case "$kind" in
            RUNNING)
                sleep "$poll_interval_s"
                ;;
            REPLAY)
                response=$(map_save_post "$payload" "$http_timeout_s") || {
                    echo -e "${R}FAIL${N}: terminal save replay failed (network, timeout, or HTTP error); request_id=$request_id" >&2
                    return 1
                }
                kind=$(map_save_response_kind replay "$request_id" "$operation_id" "$response")
                parse_status=$?
                if [ "$parse_status" -ne 0 ]; then
                    echo -e "${R}FAIL${N}: terminal save replay returned invalid JSON; request_id=$request_id" >&2
                    printf '%s\n' "$response" >&2
                    return 1
                fi
                if [ "$kind" = "SUCCESS" ]; then
                    map_save_print_json "$response"
                    echo -e "${G}PASS${N}: durable navigation map is ready; request_id=$request_id"
                    return 0
                fi
                if [ "$kind" != "RUNNING" ]; then
                    map_save_print_json "$response"
                    echo -e "${R}FAIL${N}: terminal save is not navigation-ready ($kind); request_id=$request_id" >&2
                    return 1
                fi
                sleep "$poll_interval_s"
                ;;
            *)
                map_save_print_json "$response"
                echo -e "${R}FAIL${N}: durable map save operation ended without success ($kind); request_id=$request_id" >&2
                return 1
                ;;
        esac
    done

    [ -n "$last_response" ] && map_save_print_json "$last_response"
    echo -e "${R}FAIL${N}: timed out waiting for durable map save; request_id=$request_id timeout_s=$timeout_s" >&2
    return 1
}
# ── Subcommand: map ──
cmd_map() {
    local action="${1:-}"
    case "$action" in
        start)
            cmd_mode switch map ;;
        save)
            local name="${2:-}"
            [ -z "$name" ] && { echo "Usage: lingtu map save <name>"; exit 1; }
            echo -e "${D}Saving durable map artifacts (PGO + cleanup + tomogram + occupancy)...${N}"
            cmd_map_save "$name" ;;
        end|stop)
            cmd_mode stop-session ;;
        list|ls)
            local maps_json formatted_maps
            maps_json=$(gateway_map_request -fsS "$GW/api/v1/slam/maps") || {
                echo -e "${R}FAIL${N}: map list request failed (network or HTTP error)" >&2
                return 1
            }
            formatted_maps=$(printf '%s\n' "$maps_json" | python3 -m json.tool 2>/dev/null) || {
                echo -e "${R}FAIL${N}: map list returned invalid JSON" >&2
                return 1
            }
            printf '%s\n' "$formatted_maps" | head -60 ;;
        check)
            local name="${2:-}" forward="0.08" goal_x="" goal_y="" goal_yaw="" maps_root raw_name payload build_json build_ok
            [ -z "$name" ] && { echo "Usage: lingtu map check <name> [--goal X Y YAW|--forward M]"; exit 1; }
            if [ "$LINGTU_ENV" = "real" ]; then
                echo -e "${R}FAIL${N}: map check is not migrated to typed native map control in env=real" >&2
                return 1
            fi
            shift 2
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --goal)
                        [ "$#" -ge 4 ] || { echo "Usage: lingtu map check <name> --goal X Y YAW"; exit 1; }
                        goal_x="$2"; goal_y="$3"; goal_yaw="$4"; shift 4 ;;
                    --forward)
                        forward="${2:-}"; [ -n "$forward" ] || { echo "Usage: lingtu map check <name> --forward M"; exit 1; }
                        shift 2 ;;
                    -h|--help)
                        echo "Usage: lingtu map check <name> [--goal X Y YAW|--forward M]"
                        return 0 ;;
                    *)
                        echo "Usage: lingtu map check <name> [--goal X Y YAW|--forward M]"
                        exit 1 ;;
                esac
            done
            maps_root="$(lingtu_maps_root)"
            raw_name="$name"
            name=$(resolve_relocation_map_name "$maps_root" "$raw_name") || {
                echo -e "${R}FAIL${N}: unsafe map name: $raw_name"
                exit 1
            }
            [ -d "$maps_root/$name" ] || { echo -e "${R}FAIL${N}: map not found: $maps_root/$name"; exit 1; }
            if [ -z "$goal_x" ]; then
                read -r goal_x goal_y goal_yaw < <(nav_forward_goal_args "$forward") || {
                    echo -e "${R}FAIL${N}: cannot derive current forward goal from Gateway pose"
                    exit 1
                }
            fi
            payload=$(format_nav_goal_payload "$goal_x" "$goal_y" "$goal_yaw") || { echo "goal must be numeric X Y YAW"; exit 1; }
            echo -e "${B}=== Lingtu map check: $name ===${N}"
            cmd_saved_map_artifact_gate "$maps_root/$name" --require-occupancy --expected-frame-id map || exit 1
            build_json=$(curl -s --max-time 30 -X POST "$GW/api/v1/maps/$name/build_octomap" 2>/dev/null || echo '{}')
            build_ok=$(pjson "$build_json" 'print(str(bool(d.get("success", d.get("ok", False)))).lower())')
            [ "$build_ok" = "true" ] || { echo -e "${R}FAIL${N}: build_octomap failed"; echo "$build_json" | python3 -m json.tool 2>/dev/null || echo "$build_json"; exit 1; }
            saved_map_plan_precheck "$name" "$payload" || exit 1
            echo -e "${G}PASS${N}: map flow ok: $name goal=$goal_x,$goal_y,$goal_yaw" ;;
        restore)
            local name="${2:-}"
            [ -z "$name" ] && { echo "Usage: lingtu map restore <name>"; exit 1; }
            if [ "$LINGTU_ENV" = "real" ]; then
                echo -e "${R}FAIL${N}: map restore is not migrated to typed native map control in env=real" >&2
                return 1
            fi
            echo -e "${D}Restoring map.pcd from pre-clean backup...${N}"
            local restore_json restore_ok rebuild_action rebuild_json rebuild_ok
            restore_json=$(curl -s -X POST -H "Content-Type: application/json" -d "{\"name\":\"$name\"}" \
                "$GW/api/v1/map/restore_predufo" 2>/dev/null || echo '{}')
            echo "$restore_json" | python3 -m json.tool 2>/dev/null || echo "$restore_json"
            restore_ok=$(pjson "$restore_json" 'print(str(d.get("success", False)).lower())')
            [ "$restore_ok" = "true" ] || { echo -e "${R}FAIL${N}: restore_predufo failed"; exit 1; }
            for rebuild_action in build_octomap build_occupancy; do
                echo -e "${D}Rebuilding ${rebuild_action#build_} for $name...${N}"
                rebuild_json=$(curl -s -X POST \
                    "$GW/api/v1/maps/$name/$rebuild_action" 2>/dev/null || echo '{}')
                echo "$rebuild_json" | python3 -m json.tool 2>/dev/null || echo "$rebuild_json"
                rebuild_ok=$(pjson "$rebuild_json" 'print(str(d.get("success", False)).lower())')
                [ "$rebuild_ok" = "true" ] || { echo -e "${R}FAIL${N}: $rebuild_action failed"; exit 1; }
            done ;;
        *) echo "Usage: lingtu map [start|save <name>|end|list|check <name>|restore <name>]"; exit 1 ;;
    esac
}

# ── Subcommand: nav ──
cmd_nav() {
    local action="${1:-}"
    case "$action" in
        start)
            local map="${2:-}"
            [ -z "$map" ] && { echo "Usage: lingtu nav start <map> [--initial-pose X Y YAW|--relocalize|--no-relocalize]"; return 1; }
            shift 2
            local relocalize=0 initial_pose_explicit=0 initial_x=0 initial_y=0 initial_yaw=0
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --initial-pose|--init-pose)
                        [ "$#" -ge 4 ] || { echo "Usage: lingtu nav start <map> --initial-pose X Y YAW"; return 1; }
                        initial_x="$2"; initial_y="$3"; initial_yaw="$4"; relocalize=1; initial_pose_explicit=1
                        shift 4 ;;
                    --relocalize)
                        relocalize=1
                        shift ;;
                    --no-relocalize)
                        relocalize=0
                        shift ;;
                    -h|--help)
                        echo "Usage: lingtu nav start <map> [--initial-pose X Y YAW|--relocalize|--no-relocalize]"
                        return 0 ;;
                    *)
                        echo "Usage: lingtu nav start <map> [--initial-pose X Y YAW|--relocalize|--no-relocalize]"
                        return 1 ;;
                esac
            done
            if [ "$initial_pose_explicit" = "1" ]; then
                cmd_mode switch nav --map "$map" --initial-pose "$initial_x" "$initial_y" "$initial_yaw"
            elif [ "$relocalize" = "1" ]; then
                cmd_mode switch nav --map "$map" --relocalize
            else
                cmd_mode switch nav --map "$map" --no-relocalize
            fi ;;
        smoke|motion-smoke|motioncheck)
            local map="${2:-}" forward="0.08" goal_x="" goal_y="" goal_yaw="" timeout="25" evidence_duration="12" min_motion_m="0.01" allow_motion=0
            [ -z "$map" ] && { echo "Usage: lingtu nav smoke <map> --allow-motion [--forward M|--goal X Y YAW]"; exit 1; }
            shift 2
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --allow-motion)
                        allow_motion=1; shift ;;
                    --goal)
                        [ "$#" -ge 4 ] || { echo "Usage: lingtu nav smoke <map> --goal X Y YAW"; exit 1; }
                        goal_x="$2"; goal_y="$3"; goal_yaw="$4"; shift 4 ;;
                    --forward)
                        forward="${2:-}"; [ -n "$forward" ] || { echo "Usage: lingtu nav smoke <map> --forward M"; exit 1; }
                        shift 2 ;;
                    --timeout)
                        timeout="${2:-}"; shift 2 ;;
                    --evidence-duration|--evidence-duration-sec)
                        evidence_duration="${2:-}"; shift 2 ;;
                    --min-motion-m)
                        min_motion_m="${2:-}"; shift 2 ;;
                    -h|--help)
                        echo "Usage: lingtu nav smoke <map> --allow-motion [--forward M|--goal X Y YAW]"
                        return 0 ;;
                    *)
                        echo "Usage: lingtu nav smoke <map> --allow-motion [--forward M|--goal X Y YAW]"
                        exit 1 ;;
                esac
            done
            if [ -z "$goal_x" ]; then
                read -r goal_x goal_y goal_yaw < <(nav_forward_goal_args "$forward") || {
                    echo -e "${R}FAIL${N}: cannot derive current forward goal from Gateway pose"
                    exit 1
                }
            fi
            if [ "$allow_motion" != "1" ]; then
                cmd_motion_smoke --map "$map" --goal "$goal_x" "$goal_y" "$goal_yaw"
                exit $?
            fi
            cmd_motion_smoke --map "$map" --goal "$goal_x" "$goal_y" "$goal_yaw" \
                --reuse-tracking --allow-motion --timeout "$timeout" \
                --evidence-duration "$evidence_duration" --min-motion-m "$min_motion_m" ;;
        stop|end)
            cmd_mode stop-session ;;
        relocalize|init-pose|initial-pose)
            local map="${2:-}"; local x="${3:-0}"; local y="${4:-0}"; local yaw="${5:-0}"
            [ -z "$map" ] && { echo "Usage: lingtu nav relocalize <map> [X Y YAW]"; exit 1; }
            cmd_mode switch nav --map "$map" --initial-pose "$x" "$y" "$yaw" ;;
        global-relocalize|global_relocalize|auto-relocalize|auto_relocalize)
            local map="${2:-}"
            [ -z "$map" ] && { echo "Usage: lingtu nav global-relocalize <map>"; exit 1; }
            cmd_mode switch nav --map "$map" --relocalize ;;
        goal)
            local x="${2:-}"; local y="${3:-}"; local yaw="${4:-0}"
            local payload
            [ -z "$x" ] || [ -z "$y" ] && { echo "Usage: lingtu nav goal X Y [YAW]"; exit 1; }
            payload=$(format_nav_goal_payload "$x" "$y" "$yaw") || { echo "goal must be numeric X Y [YAW]"; exit 1; }
            nav_goal_precheck "$payload" || exit 1
            curl -s -X POST -H "Content-Type: application/json" \
                -d "$payload" \
                "$GW/api/v1/goal" | python3 -m json.tool ;;
        *) echo "Usage: lingtu nav [start <map> [--initial-pose X Y YAW|--relocalize]|stop|relocalize <map> [X Y YAW]|global-relocalize [map]|goal X Y [YAW]|smoke <map> --allow-motion]"; exit 1 ;;
    esac
}

# -- Subcommand: explore --
lingtu_new_ulid() {
    python3 - <<'PY'
import secrets
import time

alphabet = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
timestamp_ms = (time.time_ns() // 1_000_000) & ((1 << 48) - 1)
value = (timestamp_ms << 80) | secrets.randbits(80)
encoded = ["0"] * 26
for index in range(25, -1, -1):
    encoded[index] = alphabet[value & 0x1F]
    value >>= 5
print("".join(encoded))
PY
}

explore_command_payload() {
    local request_id="$1" reason="${2:-}"
    python3 - "$request_id" "$reason" <<'PY'
import json
import sys

payload = {"request_id": sys.argv[1]}
if sys.argv[2]:
    payload["reason"] = sys.argv[2]
print(json.dumps(payload, separators=(",", ":")))
PY
}

explore_run_wait_terminal() {
    local exploration_run_id="$1" timeout_s="${2:-60}"
    local deadline response state stopped
    case "$timeout_s" in ''|0|*[!0-9]*) echo "Explore finish timeout must be a positive integer" >&2; return 2 ;; esac
    deadline=$((SECONDS + timeout_s))
    while [ "$SECONDS" -lt "$deadline" ]; do
        response=$(gateway_operator_request -fsS --max-time 10 \
            "$GW/api/v1/explore/runs/$exploration_run_id") || {
            echo "Failed to query Explore run $exploration_run_id" >&2
            return 1
        }
        state=$(pjson "$response" 'print(d.get("state") or "unknown")')
        stopped=$(pjson "$response" 'print("1" if d.get("terminal") is True and (d.get("motion_stop") or {}).get("confirmed") is True else "0")')
        if [ "$stopped" = "1" ]; then
            printf '%s\n' "$response"
            return 0
        fi
        case "$state" in
            failed|cancelled|completed)
                echo "Explore run reported terminal state without confirmed parking: $state" >&2
                printf '%s\n' "$response" >&2
                return 1 ;;
        esac
        sleep 1
    done
    echo "Timed out waiting for Explore run to stop safely: $exploration_run_id" >&2
    return 1
}

cmd_explore() {
    local action="${1:-}" response
    case "$action" in
        start)
            shift
            case "$#" in
                0) cmd_mode switch explore ;;
                2)
                    [ "$1" = "--map" ] && [ -n "$2" ] || {
                        echo "Usage: lingtu explore start [--map MAP]" >&2
                        return 2
                    }
                    cmd_mode switch explore --map "$2" ;;
                *)
                    echo "Usage: lingtu explore start [--map MAP]" >&2
                    return 2 ;;
            esac ;;
        task)
            shift
            local task_action="${1:-}"
            shift || true
            case "$task_action" in
                start)
                    local request_id="${LINGTU_EXPLORE_REQUEST_ID:-}" payload exploration_run_id
                    while [ "$#" -gt 0 ]; do
                        case "$1" in
                            --request-id)
                                [ "$#" -ge 2 ] || { echo "--request-id requires a value" >&2; return 2; }
                                request_id="$2"; shift 2 ;;
                            *) echo "Usage: lingtu explore task start [--request-id REQUEST_ID]" >&2; return 2 ;;
                        esac
                    done
                    [ -n "$request_id" ] || request_id=$(lingtu_new_ulid) || return 1
                    payload=$(explore_command_payload "$request_id") || return 1
                    echo "Explore start request_id: $request_id" >&2
                    echo "Reuse this request_id only when retrying this exact start." >&2
                    response=$(gateway_operator_request -fsS --max-time 15 -X POST \
                        -H "Content-Type: application/json" --data-binary "$payload" \
                        "$GW/api/v1/explore/start") || {
                        echo "Failed to admit the Explore run; request_id=$request_id" >&2
                        return 1
                    }
                    exploration_run_id=$(pjson "$response" 'print(d.get("exploration_run_id") or "")')
                    [ -n "$exploration_run_id" ] || {
                        echo "Explore start returned no exploration_run_id" >&2
                        printf '%s\n' "$response" >&2
                        return 1
                    }
                    echo "Explore exploration_run_id: $exploration_run_id" >&2
                    printf '%s\n' "$response" | python3 -m json.tool ;;
                pause|resume)
                    local exploration_run_id="${1:-}" request_id="" payload
                    [ -n "$exploration_run_id" ] || {
                        echo "Usage: lingtu explore task $task_action EXPLORATION_RUN_ID [--request-id REQUEST_ID]" >&2
                        return 2
                    }
                    shift
                    if [ "${1:-}" = "--request-id" ] && [ "$#" -eq 2 ]; then
                        request_id="$2"; shift 2
                    fi
                    [ "$#" -eq 0 ] || { echo "Invalid Explore task arguments" >&2; return 2; }
                    [ -n "$request_id" ] || request_id=$(lingtu_new_ulid) || return 1
                    payload=$(explore_command_payload "$request_id" "operator_$task_action") || return 1
                    response=$(gateway_operator_request -fsS --max-time 15 -X POST \
                        -H "Content-Type: application/json" --data-binary "$payload" \
                        "$GW/api/v1/explore/runs/$exploration_run_id/$task_action") || {
                        echo "Failed to $task_action Explore run $exploration_run_id" >&2
                        return 1
                    }
                    printf '%s\n' "$response" | python3 -m json.tool ;;
                finish)
                    local exploration_run_id="${1:-}" request_id="" save_name="" timeout_s="60" payload final
                    [ -n "$exploration_run_id" ] || {
                        echo "Usage: lingtu explore task finish EXPLORATION_RUN_ID [--save MAP] [--timeout SEC] [--request-id REQUEST_ID]" >&2
                        return 2
                    }
                    shift
                    while [ "$#" -gt 0 ]; do
                        case "$1" in
                            --save) [ "$#" -ge 2 ] || return 2; save_name="$2"; shift 2 ;;
                            --timeout) [ "$#" -ge 2 ] || return 2; timeout_s="$2"; shift 2 ;;
                            --request-id) [ "$#" -ge 2 ] || return 2; request_id="$2"; shift 2 ;;
                            *) echo "Invalid Explore finish argument: $1" >&2; return 2 ;;
                        esac
                    done
                    [ -n "$request_id" ] || request_id=$(lingtu_new_ulid) || return 1
                    payload=$(explore_command_payload "$request_id" "operator_finish") || return 1
                    response=$(gateway_operator_request -fsS --max-time 15 -X POST \
                        -H "Content-Type: application/json" --data-binary "$payload" \
                        "$GW/api/v1/explore/runs/$exploration_run_id/finish") || {
                        echo "Failed to request Explore finish for $exploration_run_id" >&2
                        return 1
                    }
                    final=$(explore_run_wait_terminal "$exploration_run_id" "$timeout_s") || return 1
                    printf '%s\n' "$final" | python3 -m json.tool || return 1
                    if [ -n "$save_name" ]; then
                        [ "$(pjson "$final" 'print((d.get("identity") or {}).get("route") or "")')" = "live" ] || {
                            echo "--save is only valid for live mapping exploration; map-route coverage uses an immutable saved map." >&2
                            return 1
                        }
                        cmd_map_save "$save_name"
                    fi ;;
                status)
                    local exploration_run_id="${1:-}"
                    [ -n "$exploration_run_id" ] && [ "$#" -eq 1 ] || {
                        echo "Usage: lingtu explore task status EXPLORATION_RUN_ID" >&2
                        return 2
                    }
                    gateway_operator_request -fsS --max-time 10 \
                        "$GW/api/v1/explore/runs/$exploration_run_id" | python3 -m json.tool ;;
                list)
                    [ "$#" -eq 0 ] || { echo "Usage: lingtu explore task list" >&2; return 2; }
                    gateway_operator_request -fsS --max-time 10 \
                        "$GW/api/v1/explore/runs" | python3 -m json.tool ;;
                *)
                    echo "Usage: lingtu explore task [start|pause|resume|finish|status|list]" >&2
                    return 2 ;;
            esac ;;
        stop)
            shift
            [ "$#" -eq 0 ] || {
                echo "Usage: lingtu explore stop" >&2
                return 2
            }
            lingtu_control stop --expected-product explore ;;
        status)
            shift
            [ "$#" -eq 0 ] || {
                echo "Usage: lingtu explore status" >&2
                return 2
            }
            response=$(gateway_operator_request -fsS --max-time 10 \
                "$GW/api/v1/explore/status") || {
                echo "Failed to read exploration status" >&2
                return 1
            }
            printf '%s\n' "$response" | python3 -m json.tool || {
                echo "Exploration status returned invalid JSON" >&2
                return 1
            } ;;
        *)
            echo "Usage: lingtu explore [start [--map MAP]|task start|pause|resume|finish|status|list|stop|status]" >&2
            return 2 ;;
    esac
}

# ── Subcommand: svc ──
print_service_row() {
    local svc="$1" label="$2" en act
    en=$(systemctl is-enabled "$svc" 2>/dev/null | head -1 || echo '-')
    act=$(systemctl is-active  "$svc" 2>/dev/null | head -1 || echo '-')
    en="${en:-'-'}"
    act="${act:-'-'}"
    case "$act" in
        active)   act="${G}${act}${N}" ;;
        inactive) act="${D}${act}${N}" ;;
        failed)   act="${R}${act}${N}" ;;
    esac
    printf "  %-14s %-36s enabled=%-10s active=%b\n" "$label" "$svc" "$en" "$act"
}

cmd_svc() {
    local action="${1:-status}"
    case "$action" in
        status)
            print_service_row lingtu-livox-dds.service lidar
            print_service_row lingtu-slam-dds.service slam
            print_service_row mapd.service maps
            print_service_row lingtu-traversability-dds.service traversability
            print_service_row lingtu-nav-dds.service nav
            print_service_row lingtu-driver.service driver
            print_service_row lingtu-camera-dds.service camera
            print_service_row lingtu-explore-dds.service explore
            print_service_row lingtu.service host ;;
        restart)
            local target="${2:-}"
            [ "$#" -ge 2 ] && shift 2 || shift
            case "$target" in
                all) lingtu_control reapply "$@" ;;
                lidar|slam|maps|traversability|nav|driver|camera|explore|host)
                    lingtu_control restart --process "$target" "$@" ;;
                *)
                    echo "Usage: lingtu svc restart [lidar|slam|maps|traversability|nav|driver|camera|explore|host|all] [--state-dir DIR]" >&2
                    return 2 ;;
            esac ;;
        reapply)
            shift
            lingtu_control reapply "$@" ;;
        stop)
            local target="${2:-all}"
            [ "$#" -ge 2 ] && shift 2 || shift
            case "$target" in
                all) lingtu_control stop "$@" ;;
                *)
                    echo "Process-level stop is not supported; stop the committed Product with 'lingtu svc stop all'." >&2
                    return 2 ;;
            esac ;;
        *)
            echo "Usage: lingtu svc [status|restart <logical-process>|reapply|stop all]"
            exit 1 ;;
    esac
}

# ── Subcommand: log ──
doctor_usage() {
    echo "Usage: lingtu doctor [--non-motion] [--json] [--strict] [--realtime] [--require-camera] [--ros2]"
}

source_robot_env() {
    set +u
    [ -f /opt/ros/humble/setup.bash ] && source /opt/ros/humble/setup.bash >/dev/null 2>&1
    [ -f /opt/lingtu/current/install/setup.bash ] && source /opt/lingtu/current/install/setup.bash >/dev/null 2>&1
    set -u
}

cmd_doctor() {
    local repo py ros2=0
    local -a doctor_args=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --json|--strict|--non-motion|--realtime|--require-camera)
                doctor_args+=("$1") ;;
            --no-motion)
                doctor_args+=(--non-motion) ;;
            --ros2)
                ros2=1
                doctor_args+=(--ros2) ;;
            -h|--help)
                doctor_usage
                return 0 ;;
            *)
                doctor_usage
                return 1 ;;
        esac
        shift
    done

    [ "$ros2" = "1" ] && source_robot_env
    repo="$(lingtu_repo_root)"
    py="$(lingtu_python)"
    PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
        "$py" -m diagnostics.field.doctor \
        --gateway-url "$GW" --env "$LINGTU_ENV" "${doctor_args[@]}"
}

# -- Subcommand: soak --
soak_usage() {
    echo "Usage: lingtu soak [--duration SEC] [--interval SEC] [--json] [--strict]"
}

cmd_soak() {
    local duration=60 interval=2 json=0 strict=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --duration)
                shift
                [ "$#" -gt 0 ] || { soak_usage; return 1; }
                duration="$1" ;;
            --interval)
                shift
                [ "$#" -gt 0 ] || { soak_usage; return 1; }
                interval="$1" ;;
            --json) json=1 ;;
            --strict) strict=1 ;;
            -h|--help) soak_usage; return 0 ;;
            *) soak_usage; return 1 ;;
        esac
        shift
    done

    local args=(--gateway "$GW" --duration "$duration" --interval "$interval")
    [ "$json" = "1" ] && args+=(--json)
    [ "$strict" = "1" ] && args+=(--strict)
    python3 "$SCRIPT_DIR/diagnostics/soak.py" "${args[@]}"
}

# -- Subcommand: log --
cmd_log() {
    local filter="${1:-all}"
    case "$filter" in
        drift)
            journalctl -u lingtu.service --since '1 hour ago' --no-pager 2>/dev/null \
                | grep -i 'drift_watchdog' | tail -20 ;;
        dufomap)
            journalctl -u lingtu.service --since '1 hour ago' --no-pager 2>/dev/null \
                | grep -iE 'dufomap|static_cleaner|dynamic_filter|map/save.*filter' | tail -20 ;;
        error)
            journalctl -u lingtu.service --since '30 min ago' --no-pager 2>/dev/null \
                | grep -iE '\[ERROR\]|traceback|exception' \
                | grep -vE 'VectorMemory|sentence_trans' | tail -20 ;;
        tail)
            exec journalctl -u lingtu.service -f --no-pager 2>/dev/null ;;
        all)
            journalctl -u lingtu.service --since '10 min ago' --no-pager 2>/dev/null \
                | tail -30 ;;
        *) echo "Usage: lingtu log [drift|dufomap|error|tail|all]"; exit 1 ;;
    esac
}

