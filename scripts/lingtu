# -- Subcommand: teleop_avoid read-only preflight --
cmd_teleop_preflight() {
    local stage="contract"
    case "${1:-}" in
        --stage)
            if [ "$#" -lt 2 ]; then
                echo "teleop-preflight --stage requires contract or motion" >&2
                return 2
            fi
            stage="$2"
            shift 2
            ;;
        --stage=*)
            stage="${1#--stage=}"
            shift
            ;;
        contract|motion)
            stage="$1"
            shift
            ;;
    esac
    case "$stage" in
        contract|motion) ;;
        *)
            echo "teleop-preflight stage must be contract or motion: $stage" >&2
            return 2
            ;;
    esac

    local repo_root python_bin
    repo_root=$(lingtu_repo_root)
    python_bin=$(lingtu_python)
    "$python_bin" "$repo_root/scripts/gates/thunder_service_readiness_collect.py" \
        --teleop-avoid-stage "$stage" "$@"
}
# -- Subcommand: native recording --
lingtu_recording_binary() {
    local name="$1"
    local repo_root candidate
    local -a candidates=()

    repo_root=$(lingtu_repo_root)
    if [ -n "${LINGTU_RECORDING_BIN_DIR:-}" ]; then
        candidates+=("${LINGTU_RECORDING_BIN_DIR%/}/$name")
    fi
    candidates+=(
        "/opt/lingtu/current/build/native-recording/$name"
        "$repo_root/build/native-recording/$name"
    )

    for candidate in "${candidates[@]}"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    if command -v "$name" >/dev/null 2>&1; then
        command -v "$name"
        return 0
    fi

    echo "Native recording binary not found: $name" >&2
    echo "Build it with: bash scripts/build/build_native_recording.sh" >&2
    return 127
}

cmd_record_usage() {
    echo "Usage: lingtu record [start] [SESSION_DIR] [--camera] [native options]"
    echo "       lingtu record status SESSION_DIR"
    echo "       lingtu record stop SESSION_DIR [--timeout-ms MS]"
    echo "       lingtu record verify SESSION_DIR|MCAP"
    echo "       lingtu record info SESSION_DIR|MCAP"
    echo "       lingtu record topics"
}

cmd_record_start() {
    local session_dir=""
    local manager camera_value dds_value camera_option=0
    local -a forwarded=() manager_args=()

    if [ "$#" -gt 0 ] && [[ "$1" != --* ]]; then
        session_dir="$1"
        shift
    fi
    if [ -z "$session_dir" ]; then
        local recording_root="${LINGTU_RECORDING_ROOT:-$HOME/data/lingtu/recordings}"
        session_dir="$recording_root/$(date -u +%Y%m%dT%H%M%SZ)-$$"
    fi

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --camera)
                if [ "${2:-}" = "on" ] || [ "${2:-}" = "off" ]; then
                    forwarded+=("$1" "$2")
                    shift 2
                else
                    forwarded+=("--camera" "on")
                    shift
                fi
                camera_option=1 ;;
            --camera=*)
                camera_value="${1#*=}"
                case "$camera_value" in
                    on|off) ;;
                    *)
                        echo "camera must be on or off: $camera_value" >&2
                        return 2 ;;
                esac
                forwarded+=("--camera" "$camera_value")
                camera_option=1
                shift ;;
            --dds=*)
                dds_value="${1#*=}"
                case "$dds_value" in
                    auto|on|off) ;;
                    *)
                        echo "dds must be auto, on, or off: $dds_value" >&2
                        return 2 ;;
                esac
                forwarded+=("--dds" "$dds_value")
                shift ;;
            *)
                forwarded+=("$1")
                shift ;;
        esac
    done

    manager=$(lingtu_recording_binary lingtu_recorder) || return $?
    manager_args=("record" "--output-dir" "$session_dir")
    if ! lingtu_has_option "--dds" "${forwarded[@]}"; then
        manager_args+=("--dds" "on")
    fi
    if [ "$camera_option" -eq 0 ]; then
        manager_args+=("--camera" "off")
    fi

    echo "Recording session: $session_dir"
    exec "$manager" "${manager_args[@]}" "${forwarded[@]}"
}

cmd_record_status() {
    local manager
    if [ "$#" -lt 1 ]; then
        cmd_record_usage >&2
        return 2
    fi
    manager=$(lingtu_recording_binary lingtu_recorder) || return $?
    exec "$manager" "status" "$@"
}

cmd_record_stop() {
    local manager
    if [ "$#" -lt 1 ]; then
        cmd_record_usage >&2
        return 2
    fi
    manager=$(lingtu_recording_binary lingtu_recorder) || return $?
    exec "$manager" "stop" "$@"
}

cmd_record_verify() {
    local target dds_mcap="" camera_mcap=""
    local dds_player camera_player
    local verified=0
    if [ "$#" -lt 1 ]; then
        cmd_record_usage >&2
        return 2
    fi
    target="$1"
    shift

    if [ -d "$target" ]; then
        dds_mcap="$target/dds/sensors.mcap"
        camera_mcap="$target/camera_color.mcap"
    else
        case "$target" in
            */camera_color.mcap|camera_color.mcap) camera_mcap="$target" ;;
            *) dds_mcap="$target" ;;
        esac
    fi

    if [ -n "$dds_mcap" ] && [ -f "$dds_mcap" ]; then
        dds_player=$(lingtu_recording_binary lingtu_dds_player) || return $?
        "$dds_player" "$dds_mcap" --dry-run "$@" || return $?
        verified=1
    fi
    if [ -n "$camera_mcap" ] && [ -f "$camera_mcap" ]; then
        camera_player=$(lingtu_recording_binary lingtu_camera_player) || return $?
        "$camera_player" "$camera_mcap" --verify || return $?
        verified=1
    fi
    if [ "$verified" -eq 0 ]; then
        echo "No recording artifact found: $target" >&2
        return 2
    fi
}

cmd_record_info() {
    local target dds_mcap="" camera_mcap=""
    local dds_player camera_player
    local inspected=0
    if [ "$#" -lt 1 ]; then
        cmd_record_usage >&2
        return 2
    fi
    target="$1"
    shift

    if [ -d "$target" ]; then
        dds_mcap="$target/dds/sensors.mcap"
        camera_mcap="$target/camera_color.mcap"
    else
        case "$target" in
            */camera_color.mcap|camera_color.mcap) camera_mcap="$target" ;;
            *) dds_mcap="$target" ;;
        esac
    fi

    if [ -n "$dds_mcap" ] && [ -f "$dds_mcap" ]; then
        dds_player=$(lingtu_recording_binary lingtu_dds_player) || return $?
        "$dds_player" --info "$dds_mcap" "$@" || return $?
        inspected=1
    fi
    if [ -n "$camera_mcap" ] && [ -f "$camera_mcap" ]; then
        camera_player=$(lingtu_recording_binary lingtu_camera_player) || return $?
        "$camera_player" "$camera_mcap" --list || return $?
        inspected=1
    fi
    if [ "$inspected" -eq 0 ]; then
        echo "No recording artifact found: $target" >&2
        return 2
    fi
}

cmd_record_topics() {
    local dds_player
    if [ "$#" -ne 0 ]; then
        cmd_record_usage >&2
        return 2
    fi
    dds_player=$(lingtu_recording_binary lingtu_dds_player) || return $?
    exec "$dds_player" --list-topics
}

cmd_replay_usage() {
    echo "Usage: lingtu replay SESSION_DIR|MCAP [player options]"
    echo "DDS replay defaults to isolated domain 84. Live domain replay remains native-player gated."
}

cmd_replay() {
    local target dds_mcap dds_player
    local replay_domain="${LINGTU_REPLAY_DOMAIN:-84}"
    local -a player_args=()
    if [ "$#" -lt 1 ]; then
        cmd_replay_usage >&2
        return 2
    fi
    target="$1"
    shift
    if [ -d "$target" ]; then
        dds_mcap="$target/dds/sensors.mcap"
    else
        dds_mcap="$target"
    fi
    if [ ! -f "$dds_mcap" ]; then
        echo "DDS recording not found: $dds_mcap" >&2
        return 2
    fi

    dds_player=$(lingtu_recording_binary lingtu_dds_player) || return $?
    if ! lingtu_has_option "--domain" "$@"; then
        player_args+=("--domain" "$replay_domain")
    fi
    exec "$dds_player" "$dds_mcap" "${player_args[@]}" "$@"
}

cmd_record() {
    case "${1:-}" in
        start) shift; cmd_record_start "$@" ;;
        "") cmd_record_start ;;
        help|-h|--help) cmd_record_usage ;;
        status) shift; cmd_record_status "$@" ;;
        stop) shift; cmd_record_stop "$@" ;;
        verify) shift; cmd_record_verify "$@" ;;
        info) shift; cmd_record_info "$@" ;;
        topics) shift; cmd_record_topics "$@" ;;
        *) cmd_record_start "$@" ;;
    esac
}

# -- Subcommand: health --

cmd_health() {
    curl -s "$GW/api/v1/health" 2>/dev/null | python3 -m json.tool
}

# ── Top-level dispatch ──
case "${1:-status}" in
    status|s)       shift || true; cmd_status "$@" ;;
    inspect)        shift; cmd_inspect "$@" ;;
    watch|w)        shift; cmd_watch "$@" ;;
    mode)           shift; cmd_mode  "$@" ;;
    map|m)          shift; cmd_map   "$@" ;;
    nav|n)          shift; cmd_nav   "$@" ;;
    explore)        shift; cmd_explore "$@" ;;
    svc)            shift; cmd_svc   "$@" ;;
    doctor|diag)    shift; cmd_doctor "$@" ;;
    soak|field-soak|readiness-soak) shift; cmd_soak "$@" ;;
    motion-smoke|motioncheck|path-follower-check) shift; cmd_motion_smoke "$@" ;;
    log|l)          shift; cmd_log   "$@" ;;
    contract|runtime-contract) shift; cmd_runtime_contract "$@" ;;
    spec|runtime-spec) shift; cmd_runtime_spec "$@" ;;
    audit|runtime-audit) shift; cmd_runtime_audit "$@" ;;
    dataflow|flow) shift; cmd_dataflow "$@" ;;
    gateway-runtime-acceptance|gateway-acceptance|gw-accept) shift; cmd_gateway_runtime_acceptance "$@" ;;
    field-check|field-acceptance|accept) shift; cmd_field_check "$@" ;;
    inspection-check|inspection-acceptance|inspect-accept) shift; cmd_inspection_check "$@" ;;
    saved-map-artifact-gate|map-gate) shift; cmd_saved_map_artifact_gate "$@" ;;
    system-acceptance|that-nav-acceptance|acceptance-gate) shift; cmd_system_acceptance "$@" ;;
    evidence|runtime-evidence|real-runtime-evidence) shift; cmd_evidence "$@" ;;
    teleop-preflight|teleop-avoid-preflight) shift; cmd_teleop_preflight "$@" ;;
    record|rec|bag) shift; cmd_record "$@" ;;
    replay|play) shift; cmd_replay "$@" ;;
    health|h) cmd_health ;;
    help|-h|--help)
        sed -n '2,/^set -u/p' "$0" | sed 's/^# //;s/^#//' ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'lingtu help' for usage."
        exit 1 ;;
esac
