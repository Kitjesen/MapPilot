[Unit]
Description=Thunder ICP Localizer
After=slam.service
Wants=slam.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
TimeoutStopSec=15
Type=simple
User=sunrise
WorkingDirectory=/home/sunrise/data/inovxio/lingtu
ExecStart=/bin/bash -c '\
  source /opt/lingtu/config/ros2-env.sh && \
  MAP_PATH=$${NAV_MAP_PATH:-/home/sunrise/data/nova/maps/active/map}; \
  exec ros2 run localizer localizer_node \
    --ros-args \
    -p config_path:=/home/sunrise/data/inovxio/lingtu/install/localizer/share/localizer/config/localizer.yaml \
    -p static_map_path:=$${MAP_PATH}.pcd \
    -p initial_x:=0.0 \
    -p initial_y:=0.0 \
    -p initial_z:=0.0 \
    -p initial_yaw:=0.0 \
    -r /cloud_registered:=/slam/registered_cloud \
    -r /Odometry:=/slam/odometry \
    -r map_cloud:=/slam/saved_map_cloud \
    -r /localization_quality:=/slam/localization_quality \
    -r relocalize:=/slam/relocalize \
    -r relocalize_check:=/slam/relocalize_check \
    -r global_relocalize:=/slam/global_relocalize \
    -r global_relocalize_status:=/slam/global_relocalize_status'
Restart=on-failure
RestartSec=3
MemoryMax=3G
KillMode=control-group
KillSignal=SIGINT
SuccessExitStatus=130 SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=localizer
Environment=HOME=/home/sunrise
Environment=ROS_DOMAIN_ID=0
Environment=NAV_MAP_PATH=

[Install]
WantedBy=multi-user.target
