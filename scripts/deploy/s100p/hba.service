[Unit]
Description=Thunder HBA offline map optimizer
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
TimeoutStopSec=15
Type=simple
User=sunrise
WorkingDirectory=/home/sunrise/data/inovxio/lingtu
ExecStart=/bin/bash -c '\
  source /opt/lingtu/config/ros2-env.sh && \
  CONFIG="$${HBA_CONFIG:-/home/sunrise/data/inovxio/lingtu/install/hba/share/hba/config/hba.yaml}"; \
  if [ ! -f "$${CONFIG}" ]; then CONFIG="$$(ros2 pkg prefix hba)/share/hba/config/hba.yaml"; fi; \
  exec ros2 run hba hba_node \
    --ros-args \
    -p config_path:="$${CONFIG}" \
    -r refine_map:=/slam/hba/refine_map \
    -r save_poses:=/slam/hba/save_poses \
    -r map_points:=/slam/hba/map_points'
Restart=on-failure
RestartSec=3
MemoryMax=3G
KillMode=control-group
KillSignal=SIGINT
SuccessExitStatus=130 SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hba
Environment=HOME=/home/sunrise
Environment=ROS_DOMAIN_ID=0
Environment=HBA_CONFIG=

[Install]
WantedBy=multi-user.target
