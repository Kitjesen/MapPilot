[Unit]
Description=LingTu native camera DDS publisher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Group=lingtu
WorkingDirectory=/opt/lingtu/current
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_CAMERA_STATUS_FILE=/dev/shm/lingtu/camera_status.json
Environment=LINGTU_CAMERA_FRAME_ID=camera_link
Environment=LINGTU_CAMERA_COLOR_TOPIC=rt/camera/color
Environment=LINGTU_CAMERA_DEPTH_TOPIC=rt/camera/depth
Environment=LINGTU_CAMERA_INFO_TOPIC=rt/camera/info
Environment=LINGTU_CAMERA_COLOR_SHM=/lingtu_camera_color
Environment=LINGTU_CAMERA_DEPTH_SHM=/lingtu_camera_depth
Environment=LINGTU_CAMERA_INFO_SHM=/lingtu_camera_info
Environment=LINGTU_CAMERA_SHM_SLOT_COUNT=16
Environment=LINGTU_CAMERA_SHM_SLOT_CAPACITY_BYTES=1048576
Environment=LINGTU_CAMERA_PUBLISH_IMAGE_DDS=0
Environment=LINGTU_DDS_DOMAIN_ID=0
Environment=LINGTU_CYCLONEDDS_PREFIX=
Environment=LINGTU_ORBBEC_SERIAL_NUMBER=
Environment=LINGTU_ORBBEC_UID=
Environment=LINGTU_ORBBEC_PRODUCT_ID=0x0800
Environment=LINGTU_ORBBEC_DEVICE_INDEX=0
Environment=LINGTU_ORBBEC_CONNECT_TIMEOUT_MS=10000
Environment=LINGTU_ORBBEC_SDK_CONFIG=
Environment=LINGTU_ORBBEC_ENABLE_FRAME_SYNC=0
Environment=LINGTU_CAMERA_COLOR_WIDTH=640
Environment=LINGTU_CAMERA_COLOR_HEIGHT=480
Environment=LINGTU_CAMERA_COLOR_FPS=30
Environment=LINGTU_CAMERA_DEPTH_WIDTH=640
Environment=LINGTU_CAMERA_DEPTH_HEIGHT=480
Environment=LINGTU_CAMERA_DEPTH_FPS=30
Environment=LINGTU_CAMERA_CAPTURE_TIMEOUT_MS=1000
Environment=LINGTU_CAMERA_STARTUP_FRAME_TIMEOUT_MS=10000
Environment=LINGTU_CAMERA_CAPTURE_STALE_TIMEOUT_MS=15000
EnvironmentFile=/run/lingtu/session.env
ExecStartPre=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/require_product_session.sh camera
ExecStart=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/run_camera_dds.sh
KillSignal=SIGINT
TimeoutStopSec=20
