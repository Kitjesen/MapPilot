[Unit]
Description=LingTu C++ CycloneDDS SLAM runtime
After=network-online.target lingtu-livox-dds.service
Wants=network-online.target lingtu-livox-dds.service

[Service]
Type=simple
WorkingDirectory=/opt/lingtu/current
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_SLAM_BIN=/opt/lingtu/current/build/slam_core/lingtu_slam_cyclone_runtime
Environment=LINGTU_SLAM_BACKEND=fastlio2
Environment=LINGTU_SLAM_MODE=mapping
Environment=LINGTU_SLAM_CONFIG=/opt/lingtu/current/src/localization/fastlio2/config/mid360_s100p.yaml
Environment=LINGTU_SLAM_MAP=
Environment=LINGTU_SLAM_TICK_HZ=50
Environment=LINGTU_DDS_DOMAIN_ID=0
Environment=LINGTU_SLAM_LOG_STATUS_S=5
Environment=LINGTU_SLAM_STATUS_JSON=/tmp/lingtu_slam_status.json
Environment=LINGTU_SLAM_STATUS_JSON_HZ=10
Environment=LINGTU_SLAM_CLOUD_SNAPSHOT_DIR=/dev/shm/lingtu_slam
Environment=LINGTU_SLAM_CLOUD_SNAPSHOT_HZ=5
Environment=LINGTU_CYCLONEDDS_PREFIX=
ExecStart=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/run_slam_dds.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
