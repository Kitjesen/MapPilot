[Unit]
Description=Native live maps and map service runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Group=sunrise
RuntimeDirectory=lingtu-mapd
RuntimeDirectoryMode=0770
UMask=0007
WorkingDirectory=/opt/lingtu/current
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_MAPD_BIN=/opt/lingtu/current/build/maps/mapd
Environment=LINGTU_MAPD_STATUS_FILE=/dev/shm/lingtu/mapd_status.json
Environment=LINGTU_MAPD_QUERY_SOCKET=/run/lingtu-mapd/mapd.sock
Environment=LINGTU_MAPD_QUERY_MAX_JSON_BYTES=1048576
Environment=LINGTU_DDS_DOMAIN_ID=0
Environment=LINGTU_MAPD_STATE_HZ=2
Environment=LINGTU_MAPD_CLOUD_HZ=10
Environment=LINGTU_MAPD_MAP_HZ=2
Environment=LINGTU_MAPD_SCENE_HZ=2
Environment=LINGTU_MAPD_MAX_POINTS=300000
Environment=LINGTU_MAPD_MAX_CLOUD_BYTES=16777216
Environment=LINGTU_MAPD_MAX_POINT_FIELDS=16
Environment=LINGTU_MAPD_MAX_POINT_STEP=64
Environment=LINGTU_MAPD_MAX_STRING_BYTES=4096
Environment=LINGTU_MAPD_MAX_SCENE_BYTES=33554432
Environment=LINGTU_MAPD_MAX_VOXEL_SNAPSHOT_POINTS=200000
Environment=LINGTU_MAPD_VOXEL_SNAPSHOT_RADIUS_M=30
Environment=LINGTU_MAPD_MAX_VOXELS=500000
Environment=LINGTU_MAPD_MAX_ACCUMULATED_CELLS=2000000
Environment=LINGTU_MAPD_MAX_ACCUMULATED_BLOCKS=4096
Environment=LINGTU_MAPD_CARVE_MIN_Z_M=-0.7
Environment=LINGTU_MAPD_CARVE_MAX_Z_M=1.8
Environment=LINGTU_MAPD_MIN_RANGE_M=0.25
Environment=LINGTU_MAPD_MAX_RANGE_M=30
Environment=LINGTU_MAPD_DECAY_MS=250
Environment=LINGTU_MAPD_STALE_MS=1000
Environment=LINGTU_CYCLONEDDS_PREFIX=
EnvironmentFile=-/opt/lingtu/current/config/release-runtime.env
EnvironmentFile=-/etc/lingtu/maps.env
ExecStartPre=/bin/rm -f /dev/shm/lingtu/mapd_status.json /run/lingtu-mapd/mapd.sock
EnvironmentFile=/run/lingtu/session.env
ExecStartPre=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/require_product_session.sh maps
ExecStart=/bin/bash -lc 'source /opt/lingtu/config/thunder-runtime-env.sh; if [ -n "${LINGTU_CYCLONEDDS_PREFIX}" ] && [ -d "${LINGTU_CYCLONEDDS_PREFIX}/lib" ]; then export LD_LIBRARY_PATH="${LINGTU_CYCLONEDDS_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"; fi; if [ ! -x "${LINGTU_MAPD_BIN}" ]; then echo "ERROR: native maps runtime is missing or not executable: ${LINGTU_MAPD_BIN}" >&2; echo "Build it with: bash scripts/build/build_mapd.sh" >&2; exit 2; fi; exec "${LINGTU_MAPD_BIN}" --domain-id "${LINGTU_DDS_DOMAIN_ID}" --status-file "${LINGTU_MAPD_STATUS_FILE}" --query-socket "${LINGTU_MAPD_QUERY_SOCKET}" --query-max-json-bytes "${LINGTU_MAPD_QUERY_MAX_JSON_BYTES}" --state-hz "${LINGTU_MAPD_STATE_HZ}" --cloud-hz "${LINGTU_MAPD_CLOUD_HZ}" --map-hz "${LINGTU_MAPD_MAP_HZ}" --scene-hz "${LINGTU_MAPD_SCENE_HZ}" --max-points "${LINGTU_MAPD_MAX_POINTS}" --max-cloud-bytes "${LINGTU_MAPD_MAX_CLOUD_BYTES}" --max-fields "${LINGTU_MAPD_MAX_POINT_FIELDS}" --max-point-step "${LINGTU_MAPD_MAX_POINT_STEP}" --max-string-bytes "${LINGTU_MAPD_MAX_STRING_BYTES}" --max-scene-bytes "${LINGTU_MAPD_MAX_SCENE_BYTES}" --max-voxel-snapshot-points "${LINGTU_MAPD_MAX_VOXEL_SNAPSHOT_POINTS}" --voxel-snapshot-radius "${LINGTU_MAPD_VOXEL_SNAPSHOT_RADIUS_M}" --max-voxels "${LINGTU_MAPD_MAX_VOXELS}" --max-accumulated-cells "${LINGTU_MAPD_MAX_ACCUMULATED_CELLS}" --max-accumulated-blocks "${LINGTU_MAPD_MAX_ACCUMULATED_BLOCKS}" --carve-min-z "${LINGTU_MAPD_CARVE_MIN_Z_M}" --carve-max-z "${LINGTU_MAPD_CARVE_MAX_Z_M}" --min-range "${LINGTU_MAPD_MIN_RANGE_M}" --max-range "${LINGTU_MAPD_MAX_RANGE_M}" --decay-ms "${LINGTU_MAPD_DECAY_MS}" --stale-ms "${LINGTU_MAPD_STALE_MS}"'
KillSignal=SIGINT
TimeoutStopSec=20

