[Unit]
Description=Native live maps and map service runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Group=lingtu
RuntimeDirectory=lingtu-mapd
RuntimeDirectoryMode=0770
UMask=0007
WorkingDirectory=/opt/lingtu/current
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_MAPD_BIN=/opt/lingtu/current/bin/mapd
Environment=LINGTU_PRUNE_BIN=/opt/lingtu/current/bin/prune
Environment=LINGTU_MAPD_STATUS_FILE=/dev/shm/lingtu/mapd_status.json
Environment=LINGTU_MAPD_QUERY_SOCKET=/run/lingtu-mapd/mapd.sock
Environment=LINGTU_DDS_DOMAIN_ID=0
Environment=LINGTU_CYCLONEDDS_PREFIX=
EnvironmentFile=-/opt/lingtu/current/etc/lingtu/release-runtime.env
EnvironmentFile=-/etc/lingtu/maps.env
ExecStartPre=/bin/rm -f /dev/shm/lingtu/mapd_status.json /run/lingtu-mapd/mapd.sock
EnvironmentFile=/run/lingtu/session.env
ExecStartPre=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/require_product_session.sh maps
ExecStart=/bin/bash -lc 'source /opt/lingtu/config/thunder-runtime-env.sh; if [ -n "${LINGTU_CYCLONEDDS_PREFIX}" ] && [ -d "${LINGTU_CYCLONEDDS_PREFIX}/lib" ]; then export LD_LIBRARY_PATH="${LINGTU_CYCLONEDDS_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"; fi; if [ ! -x "${LINGTU_MAPD_BIN}" ]; then echo "ERROR: native maps runtime is missing or not executable: ${LINGTU_MAPD_BIN}" >&2; echo "Build it with: bash scripts/build/build_mapd.sh" >&2; exit 2; fi; if [ ! -x "${LINGTU_PRUNE_BIN}" ]; then echo "ERROR: native map prune runtime is missing or not executable: ${LINGTU_PRUNE_BIN}" >&2; echo "Build it with: bash scripts/build/build_mapd.sh" >&2; exit 2; fi; exec "${LINGTU_MAPD_BIN}" --domain-id "${LINGTU_DDS_DOMAIN_ID}" --status-file "${LINGTU_MAPD_STATUS_FILE}" --query-socket "${LINGTU_MAPD_QUERY_SOCKET}"'
KillSignal=SIGINT
TimeoutStopSec=20
