[Unit]
Description=LingTu Python application host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lingtu
Group=lingtu
WorkingDirectory=/opt/lingtu/current
Environment=HOME=/var/lib/lingtu
Environment=LINGTU_REPO=/opt/lingtu/current
EnvironmentFile=-/etc/lingtu/gateway.env
EnvironmentFile=-/etc/lingtu/map-client.env
EnvironmentFile=-/opt/lingtu/current/config/release-runtime.env
Environment=LINGTU_SYSTEMD_UNIT=lt-host.service
Environment=LINGTU_ENV=real
Environment=LINGTU_MODULE_TRANSPORT=local
Environment=LINGTU_TELEOP_BRIDGE_ADDR=
Environment=LINGTU_NAV_CLIENT_LIB=/opt/lingtu/current/build/nav_endpoint/liblingtu_nav_client.so
Environment=LINGTU_INSPECTION_LIBRARY=/opt/lingtu/current/build/nav_endpoint/inspection/liblingtu_inspection.so
Environment=LINGTU_INSPECTION_DIR=/var/lib/lingtu/inspection
Environment=LINGTU_INSPECTION_EVIDENCE_BRIDGE_LIBRARY=/opt/lingtu/current/build/nav_endpoint/liblingtu_inspection_evidence_bridge.so
Environment=LINGTU_INSPECTION_EVIDENCE_DIR=/var/lib/lingtu/inspection_evidence
Environment=LINGTU_INSPECTION_TASK_JOURNAL=/var/lib/lingtu/task_journal/inspection_tasks.json
Environment=LINGTU_EXPLORE_RUN_JOURNAL=/var/lib/lingtu/task_journal/explore_runs.json
Environment=LINGTU_TASK_LEDGER_PATH=/var/lib/lingtu/task_journal/navigation_tasks.sqlite3
Environment=LINGTU_INSPECTION_EVIDENCE_STATUS_FILE=/dev/shm/lingtu/inspection_evidence_status.json
Environment=LINGTU_NAV_COMMANDS_REQUIRED=1
Environment=LINGTU_NAV_GOAL_TIMEOUT_MS=10000
Environment=LINGTU_NAV_CANCEL_TIMEOUT_MS=2000
Environment=LINGTU_NAV_TELEOP_TIMEOUT_MS=1000
Environment=LINGTU_DDS_DOMAIN_ID=0
Environment=LINGTU_SERVICE_DDS_CHECK=1
Environment=LINGTU_SERVICE_DDS_CHECK_TIMEOUT=2.5
Environment=LINGTU_DDS_PROBE_BIN=/opt/lingtu/current/build/dds_probe/lingtu_dds_probe
Environment=LINGTU_SERVICE_READINESS_JSON=/tmp/lingtu_service_readiness.json
Environment=LINGTU_CLOUD_VIEWER_MAX_HZ=2
Environment=LINGTU_SCAN_VIEWER_MAX_HZ=10
Environment=LINGTU_SCAN_VIEWER_MAX_POINTS=5000
Environment=LINGTU_SLAM_LIDAR_SCAN_INTERVAL_S=0.005
EnvironmentFile=/run/lingtu/session.env
ExecStartPre=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/require_product_session.sh host
ExecStart=/bin/bash -lc 'source /opt/lingtu/config/thunder-runtime-env.sh && exec "$${LINGTU_PYTHON}" -m lingtu.real.host'
KillSignal=SIGINT
TimeoutStopSec=20
