[Unit]
Description=LingTu Thunder typed DDS endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/lingtu/current
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_PROFILE=nav
Environment=LINGTU_MODULE_TRANSPORT=local
Environment=LINGTU_ENDPOINT=thunder_field
Environment=LINGTU_ENDPOINT_TRANSPORT=dds
Environment=LINGTU_ENDPOINT_CONTRACT=thunder_field_dds_v1
Environment=LINGTU_ENDPOINT_SOURCES=thunder_field
Environment=LINGTU_ENDPOINT_SOURCE=
Environment=LINGTU_ENDPOINT_JSONL_PATH=
Environment=LINGTU_ENDPOINT_JSONL_COMMAND=
Environment=LINGTU_ENDPOINT_JSONL_RATE_HZ=0
Environment=LINGTU_BRAINSTEM_HOST=127.0.0.1
Environment=LINGTU_BRAINSTEM_PORT=13145
Environment=LINGTU_BRAINSTEM_REQUIRE_SDK=1
Environment=LINGTU_BRAINSTEM_AUTO_ENABLE=0
Environment=LINGTU_BRAINSTEM_AUTO_STANDUP=0
Environment=LINGTU_BRAINSTEM_SAFE_SITDOWN=0
Environment=LINGTU_BRAINSTEM_SAFE_DISABLE=0
Environment=LINGTU_BRAINSTEM_CMD_TIMEOUT_MS=200
Environment=LINGTU_ENABLE_ROBOT_DRIVER=0
Environment=LINGTU_COMMAND_OUTPUT_MODE=endpoint_only
Environment=LINGTU_HARDWARE_CONTROL_BOUNDARY=dds_endpoint_source
Environment=LINGTU_PYTHON=python3
Environment=LINGTU_FAIL_CLOSED_ON_MISSING_PYTHON_DDS=1
# systemd expands ${VAR} from Environment= before bash runs. Do not use bash-only
# constructs (${VAR:-default}, ${args[@]}); they can become empty and crash-loop.
ExecStart=/bin/bash -c 'source /opt/lingtu/config/thunder-runtime-env.sh && exec "${LINGTU_PYTHON}" scripts/deploy/thunder/run_dds_endpoint_service.py --contract "${LINGTU_ENDPOINT_CONTRACT}" --source "${LINGTU_ENDPOINT_SOURCES}" --fail-closed-on-missing-python-dds'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
