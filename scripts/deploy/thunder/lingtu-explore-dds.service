[Unit]
Description=LingTu native hierarchical exploration endpoint
After=network-online.target lingtu-slam-dds.service lingtu-traversability-dds.service lingtu-nav-dds.service
Wants=network-online.target
Requires=lingtu-traversability-dds.service lingtu-nav-dds.service

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=6s
WatchdogSignal=SIGTERM
KillMode=control-group
StateDirectory=lingtu
WorkingDirectory=/opt/lingtu/current
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_EXPLORE_DDS_BIN=/opt/lingtu/current/build/nav_endpoint/lingtu_explore_dds
Environment=LINGTU_EXPLORE_STATUS_FILE=/dev/shm/lingtu/explore_status.json
Environment=LINGTU_DDS_DOMAIN_ID=0
Environment=LINGTU_CYCLONEDDS_PREFIX=
EnvironmentFile=-/opt/lingtu/current/config/release-runtime.env
EnvironmentFile=-/etc/lingtu/explore.env
ExecStart=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/run_status_file_watchdog.sh --status-file ${LINGTU_EXPLORE_STATUS_FILE} --startup-timeout-s 30 --poll-interval-s 0.5 -- /bin/bash /opt/lingtu/current/scripts/deploy/thunder/run_explore_dds.sh
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
