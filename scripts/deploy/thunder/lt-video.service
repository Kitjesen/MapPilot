[Unit]
Description=LingTu native camera WebRTC preview
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Group=lingtu
WorkingDirectory=/opt/lingtu/current
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_VIDEO_BIN=/opt/lingtu/current/bin/lingtu_camera_webrtc
Environment=LINGTU_VIDEO_RUNTIME_ENV=/opt/lingtu/current/lib/lingtu/video/env.sh
Environment=LINGTU_VIDEO_GST_REGISTRY=/run/lingtu/video-gst-registry.bin
EnvironmentFile=-/opt/lingtu/current/etc/lingtu/release-runtime.env
EnvironmentFile=-/etc/lingtu/video.env
EnvironmentFile=/run/lingtu/session.env
ExecStartPre=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/require_product_session.sh video
ExecStartPre=/bin/rm -f -- ${LINGTU_VIDEO_STATUS_FILE}
ExecStart=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/run_video.sh
KillSignal=SIGINT
TimeoutStopSec=20

