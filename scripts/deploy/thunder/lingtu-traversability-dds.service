[Unit]
Description=LingTu native traversability DDS producer
After=network-online.target lingtu-slam-dds.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/lingtu/current
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_TRAVERSABILITY_DDS_BIN=/opt/lingtu/current/build/nav_endpoint/lingtu_traversability_dds
Environment=LINGTU_DDS_DOMAIN_ID=0
Environment=LINGTU_TRAVERSABILITY_PUBLISH_HZ=10
Environment=LINGTU_TRAVERSABILITY_TICK_HZ=50
Environment=LINGTU_TRAVERSABILITY_RESOLUTION=0.20
Environment=LINGTU_TRAVERSABILITY_RADIUS=15
Environment=LINGTU_TRAVERSABILITY_MAX_POINTS=20000
Environment=LINGTU_TRAVERSABILITY_TERRAIN_DECAY_S=2.0
Environment=LINGTU_TRAVERSABILITY_TERRAIN_MIN_BLOCK_POINTS=10
Environment=LINGTU_TRAVERSABILITY_TERRAIN_QUANTILE=0.25
Environment=LINGTU_TRAVERSABILITY_TERRAIN_CACHE_MAX_POINTS=80000
Environment=LINGTU_TRAVERSABILITY_TERRAIN_CLEAR_DY_OBS=1
Environment=LINGTU_TRAVERSABILITY_TERRAIN_MIN_DY_OBS_DIS=0.30
Environment=LINGTU_TRAVERSABILITY_TERRAIN_MIN_DY_OBS_ANGLE=0.0
Environment=LINGTU_TRAVERSABILITY_TERRAIN_MIN_DY_OBS_REL_Z=-0.5
Environment=LINGTU_TRAVERSABILITY_TERRAIN_ABS_DY_OBS_REL_Z_THRE=0.2
Environment=LINGTU_TRAVERSABILITY_TERRAIN_MIN_DY_OBS_VFOV=-16.0
Environment=LINGTU_TRAVERSABILITY_TERRAIN_MAX_DY_OBS_VFOV=16.0
Environment=LINGTU_TRAVERSABILITY_TERRAIN_MIN_DY_OBS_POINT_NUM=1
Environment=LINGTU_TRAVERSABILITY_TERRAIN_NO_DATA_OBSTACLE=0
Environment=LINGTU_TRAVERSABILITY_TERRAIN_NO_DATA_BLOCK_SKIP_NUM=0
Environment=LINGTU_TRAVERSABILITY_STATUS_FILE=/dev/shm/lingtu/traversability_status.json
Environment=LINGTU_CYCLONEDDS_PREFIX=
ExecStart=/bin/bash -lc 'source /opt/lingtu/config/thunder-runtime-env.sh; if [ -n "${LINGTU_CYCLONEDDS_PREFIX}" ] && [ -d "${LINGTU_CYCLONEDDS_PREFIX}/lib" ]; then export LD_LIBRARY_PATH="${LINGTU_CYCLONEDDS_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"; fi; if [ ! -x "${LINGTU_TRAVERSABILITY_DDS_BIN}" ]; then echo "ERROR: native traversability DDS producer is missing or not executable: ${LINGTU_TRAVERSABILITY_DDS_BIN}" >&2; echo "Build it with: bash scripts/build/build_nav_endpoint.sh" >&2; exit 2; fi; exec "${LINGTU_TRAVERSABILITY_DDS_BIN}" --domain-id "${LINGTU_DDS_DOMAIN_ID}" --publish-hz "${LINGTU_TRAVERSABILITY_PUBLISH_HZ}" --tick-hz "${LINGTU_TRAVERSABILITY_TICK_HZ}" --resolution "${LINGTU_TRAVERSABILITY_RESOLUTION}" --radius "${LINGTU_TRAVERSABILITY_RADIUS}" --max-points "${LINGTU_TRAVERSABILITY_MAX_POINTS}" --terrain-decay-s "${LINGTU_TRAVERSABILITY_TERRAIN_DECAY_S}" --terrain-min-block-points "${LINGTU_TRAVERSABILITY_TERRAIN_MIN_BLOCK_POINTS}" --terrain-quantile "${LINGTU_TRAVERSABILITY_TERRAIN_QUANTILE}" --terrain-cache-max-points "${LINGTU_TRAVERSABILITY_TERRAIN_CACHE_MAX_POINTS}" --terrain-clear-dy-obs "${LINGTU_TRAVERSABILITY_TERRAIN_CLEAR_DY_OBS}" --terrain-min-dy-obs-dis "${LINGTU_TRAVERSABILITY_TERRAIN_MIN_DY_OBS_DIS}" --terrain-min-dy-obs-angle "${LINGTU_TRAVERSABILITY_TERRAIN_MIN_DY_OBS_ANGLE}" --terrain-min-dy-obs-rel-z "${LINGTU_TRAVERSABILITY_TERRAIN_MIN_DY_OBS_REL_Z}" --terrain-abs-dy-obs-rel-z-thre "${LINGTU_TRAVERSABILITY_TERRAIN_ABS_DY_OBS_REL_Z_THRE}" --terrain-min-dy-obs-vfov "${LINGTU_TRAVERSABILITY_TERRAIN_MIN_DY_OBS_VFOV}" --terrain-max-dy-obs-vfov "${LINGTU_TRAVERSABILITY_TERRAIN_MAX_DY_OBS_VFOV}" --terrain-min-dy-obs-point-num "${LINGTU_TRAVERSABILITY_TERRAIN_MIN_DY_OBS_POINT_NUM}" --terrain-no-data-obstacle "${LINGTU_TRAVERSABILITY_TERRAIN_NO_DATA_OBSTACLE}" --terrain-no-data-block-skip-num "${LINGTU_TRAVERSABILITY_TERRAIN_NO_DATA_BLOCK_SKIP_NUM}" --status-file "${LINGTU_TRAVERSABILITY_STATUS_FILE}"'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
