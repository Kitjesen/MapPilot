[Unit]
Description=LingTu native navigation DDS endpoint
After=network-online.target lingtu-thunder-lite.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/lingtu/current
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_NAV_DDS_BIN=/opt/lingtu/current/build/nav_endpoint/lingtu_nav_native_endpoint
Environment=LINGTU_LOCAL_PLANNER_PATHS=/opt/lingtu/current/src/nav/services/plan/local_planner/paths
Environment=LINGTU_ACTIVE_OCTOMAP=/home/sunrise/data/nova/maps/active/octomap.ot
Environment=LINGTU_DDS_DOMAIN_ID=0
Environment=LINGTU_NAV_DDS_TICK_HZ=20
Environment=LINGTU_NAV_DDS_MAX_OBSTACLE_POINTS=20000
Environment=LINGTU_NAV_PUBLISH_CMD_VEL=0
Environment=LINGTU_NAV_STATUS_FILE=/dev/shm/lingtu/nav_endpoint_status.json
Environment=LINGTU_CYCLONEDDS_PREFIX=
ExecStart=/bin/bash -lc 'source /opt/lingtu/config/thunder-runtime-env.sh; if [ -n "${LINGTU_CYCLONEDDS_PREFIX}" ] && [ -d "${LINGTU_CYCLONEDDS_PREFIX}/lib" ]; then export LD_LIBRARY_PATH="${LINGTU_CYCLONEDDS_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"; fi; if [ ! -x "${LINGTU_NAV_DDS_BIN}" ]; then echo "ERROR: native navigation DDS endpoint is missing or not executable: ${LINGTU_NAV_DDS_BIN}" >&2; echo "Build it with: bash scripts/build/build_nav_endpoint.sh" >&2; exit 2; fi; exec "${LINGTU_NAV_DDS_BIN}" --domain-id "${LINGTU_DDS_DOMAIN_ID}" --path-library "${LINGTU_LOCAL_PLANNER_PATHS}" --map "${LINGTU_ACTIVE_OCTOMAP}" --tick-hz "${LINGTU_NAV_DDS_TICK_HZ}" --max-obstacle-points "${LINGTU_NAV_DDS_MAX_OBSTACLE_POINTS}" --publish-cmd-vel "${LINGTU_NAV_PUBLISH_CMD_VEL}" --status-file "${LINGTU_NAV_STATUS_FILE}" --status-s 5'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
