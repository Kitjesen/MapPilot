[Unit]
Description=LingTu native navigation DDS endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=6s
WatchdogSignal=SIGTERM
KillMode=control-group
StateDirectory=lingtu
WorkingDirectory=/opt/lingtu/current
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_NAV_DDS_BIN=/opt/lingtu/current/build/nav_endpoint/lingtu_nav_native_endpoint
Environment=LINGTU_LOCAL_PLANNER_PATHS=/opt/lingtu/current/src/nav/services/plan/local_planner/paths
Environment=LINGTU_ACTIVE_OCTOMAP=/home/sunrise/data/nova/maps/active/octomap.ot
Environment=LINGTU_DDS_DOMAIN_ID=0
Environment=LINGTU_NAV_DDS_TICK_HZ=20
Environment=LINGTU_NAV_CONTROL_MODE=autonomy
Environment=LINGTU_NAV_MAX_SPEED_MPS=0.4
Environment=LINGTU_NAV_MAX_ACCEL_MPS2=1.0
Environment=LINGTU_NAV_DDS_MAX_OBSTACLE_POINTS=5000
Environment=LINGTU_NAV_OBSTACLE_VOXEL_SIZE_M=0.08
Environment=LINGTU_NAV_OBSTACLE_REGISTERED_SHARE=0.55
Environment=LINGTU_NAV_OBSTACLE_TERRAIN_SHARE=0.30
Environment=LINGTU_NAV_OBSTACLE_TERRAIN_EXT_SHARE=0.0
Environment=LINGTU_NAV_LIVE_OBSTACLE_DECAY_S=0.45
Environment=LINGTU_NAV_LIVE_OBSTACLE_INFLATION_RADIUS_M=0.12
Environment=LINGTU_NAV_LIVE_OBSTACLE_RAY_CLEARING=1
Environment=LINGTU_NAV_LIVE_OBSTACLE_RAY_CLEAR_MAX_RANGE_M=3.5
Environment=LINGTU_NAV_LIVE_OBSTACLE_RAY_CLEARING_INTERVAL_S=0.33
Environment=LINGTU_NAV_LIVE_OBSTACLE_MAX_CLEARING_RAYS=160
Environment=LINGTU_NAV_LIVE_OBSTACLE_MIN_HITS=1
Environment=LINGTU_NAV_PUBLISH_CMD_VEL=1
Environment=LINGTU_NAV_CHECK_OBSTACLE=1
Environment=LINGTU_NAV_USE_TRAVERSABILITY_COST=1
Environment=LINGTU_NAV_TRAVERSABILITY_MAX_AGE_S=1.5
Environment=LINGTU_NAV_LOCALIZATION_HEALTH_MAX_AGE_S=0.5
Environment=LINGTU_NAV_ALLOW_LEGACY_MOTION_INPUTS=0
Environment=LINGTU_NAV_ALLOW_TELEOP_TAKEOVER=0
Environment=LINGTU_TELEOP_LOCAL_PLANNER=0
Environment=LINGTU_TELEOP_PLANNER_HORIZON_M=2.0
Environment=LINGTU_TELEOP_PLANNER_MAX_DEVIATION_DEG=55.0
Environment=LINGTU_NAV_TRAVERSABILITY_HARD_COST=80.0
Environment=LINGTU_NAV_TRAVERSABILITY_SOFT_COST=40.0
Environment=LINGTU_NAV_TRAVERSABILITY_WEIGHT=0.01
Environment=LINGTU_NAV_TERRAIN_MAP_MAX_AGE_S=1.5
Environment=LINGTU_NAV_ODOM_MAX_AGE_S=0.25
Environment=LINGTU_NAV_TF_MAX_AGE_S=0.25
Environment=LINGTU_NAV_CLOUD_MAX_AGE_S=0.35
Environment=LINGTU_NAV_CLOUD_POSE_MAX_GAP_S=0.10
Environment=LINGTU_NAV_INPUT_RECOVERY_FRAMES=3
Environment=LINGTU_NAV_VEHICLE_LENGTH_M=1.0
Environment=LINGTU_NAV_VEHICLE_WIDTH_M=0.6
Environment=LINGTU_NAV_SENSOR_OFFSET_X_M=-0.011
Environment=LINGTU_NAV_SENSOR_OFFSET_Y_M=-0.02329
Environment=LINGTU_NAV_SENSOR_OFFSET_Z_M=0.04412
Environment=LINGTU_TELEOP_CMD_MAX_AGE_S=0.35
Environment=LINGTU_TELEOP_MAX_SPEED_MPS=0.4
Environment=LINGTU_TELEOP_MAX_YAW_RATE=1.0
Environment=LINGTU_TELEOP_MIN_MOTION_SPEED_MPS=0.03
Environment=LINGTU_TELEOP_SLOW_DISTANCE_M=1.2
Environment=LINGTU_TELEOP_STOP_DISTANCE_M=0.55
Environment=LINGTU_TELEOP_LINEAR_SLOW_SCALE=0.35
Environment=LINGTU_TELEOP_OBSTACLE_HEIGHT_MIN_M=0.10
Environment=LINGTU_TELEOP_OBSTACLE_HEIGHT_MAX_M=1.20
Environment=LINGTU_TELEOP_OBSTACLE_MARGIN_M=0.15
Environment=LINGTU_TELEOP_TRAVERSABILITY_HARD_COST=80.0
Environment=LINGTU_TELEOP_TRAVERSABILITY_SOFT_COST=40.0
Environment=LINGTU_NAV_STATUS_FILE=/dev/shm/lingtu/nav_endpoint_status.json
Environment=LINGTU_NAV_ESTOP_LATCH_FILE=/var/lib/lingtu/nav_estop_latched
Environment=LINGTU_NAV_STATUS_S=0.2
Environment=LINGTU_NAV_LOCAL_PLANNER_DEBUG_CANDIDATES=18
Environment=LINGTU_NAV_LOCAL_MAP_DEBUG_POINTS=640
Environment=LINGTU_CYCLONEDDS_PREFIX=
ExecStart=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/run_status_file_watchdog.sh --status-file ${LINGTU_NAV_STATUS_FILE} --startup-timeout-s 30 --poll-interval-s 0.5 -- /bin/bash -lc 'source /opt/lingtu/config/thunder-runtime-env.sh; if [ -n "${LINGTU_CYCLONEDDS_PREFIX}" ] && [ -d "${LINGTU_CYCLONEDDS_PREFIX}/lib" ]; then export LD_LIBRARY_PATH="${LINGTU_CYCLONEDDS_PREFIX}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"; fi; if [ ! -x "${LINGTU_NAV_DDS_BIN}" ]; then echo "ERROR: native navigation DDS endpoint is missing or not executable: ${LINGTU_NAV_DDS_BIN}" >&2; echo "Build it with: bash scripts/build/build_nav_endpoint.sh" >&2; exit 2; fi; exec "${LINGTU_NAV_DDS_BIN}" --control-mode "${LINGTU_NAV_CONTROL_MODE}" --domain-id "${LINGTU_DDS_DOMAIN_ID}" --path-library "${LINGTU_LOCAL_PLANNER_PATHS}" --map "${LINGTU_ACTIVE_OCTOMAP}" --tick-hz "${LINGTU_NAV_DDS_TICK_HZ}" --max-obstacle-points "${LINGTU_NAV_DDS_MAX_OBSTACLE_POINTS}" --obstacle-voxel-size-m "${LINGTU_NAV_OBSTACLE_VOXEL_SIZE_M}" --obstacle-registered-share "${LINGTU_NAV_OBSTACLE_REGISTERED_SHARE}" --obstacle-terrain-share "${LINGTU_NAV_OBSTACLE_TERRAIN_SHARE}" --obstacle-terrain-ext-share "${LINGTU_NAV_OBSTACLE_TERRAIN_EXT_SHARE}" --live-obstacle-decay-s "${LINGTU_NAV_LIVE_OBSTACLE_DECAY_S}" --live-obstacle-inflation-radius-m "${LINGTU_NAV_LIVE_OBSTACLE_INFLATION_RADIUS_M}" --live-obstacle-ray-clearing "${LINGTU_NAV_LIVE_OBSTACLE_RAY_CLEARING}" --live-obstacle-ray-clear-max-range-m "${LINGTU_NAV_LIVE_OBSTACLE_RAY_CLEAR_MAX_RANGE_M}" --live-obstacle-ray-clearing-interval-s "${LINGTU_NAV_LIVE_OBSTACLE_RAY_CLEARING_INTERVAL_S}" --live-obstacle-max-clearing-rays "${LINGTU_NAV_LIVE_OBSTACLE_MAX_CLEARING_RAYS}" --live-obstacle-min-hits "${LINGTU_NAV_LIVE_OBSTACLE_MIN_HITS}" --publish-cmd-vel "${LINGTU_NAV_PUBLISH_CMD_VEL}" --check-obstacle "${LINGTU_NAV_CHECK_OBSTACLE}" --use-traversability-cost "${LINGTU_NAV_USE_TRAVERSABILITY_COST}" --traversability-max-age-s "${LINGTU_NAV_TRAVERSABILITY_MAX_AGE_S}" --localization-health-max-age-s "${LINGTU_NAV_LOCALIZATION_HEALTH_MAX_AGE_S}" --allow-teleop-takeover "${LINGTU_NAV_ALLOW_TELEOP_TAKEOVER}" --teleop-local-planner "${LINGTU_TELEOP_LOCAL_PLANNER}" --teleop-planner-horizon-m "${LINGTU_TELEOP_PLANNER_HORIZON_M}" --teleop-planner-max-deviation-deg "${LINGTU_TELEOP_PLANNER_MAX_DEVIATION_DEG}" --allow-legacy-motion-inputs "${LINGTU_NAV_ALLOW_LEGACY_MOTION_INPUTS}" --terrain-map-max-age-s "${LINGTU_NAV_TERRAIN_MAP_MAX_AGE_S}" --odom-max-age-s "${LINGTU_NAV_ODOM_MAX_AGE_S}" --tf-max-age-s "${LINGTU_NAV_TF_MAX_AGE_S}" --cloud-max-age-s "${LINGTU_NAV_CLOUD_MAX_AGE_S}" --cloud-pose-max-gap-s "${LINGTU_NAV_CLOUD_POSE_MAX_GAP_S}" --input-recovery-frames "${LINGTU_NAV_INPUT_RECOVERY_FRAMES}" --local-planner-debug-candidates "${LINGTU_NAV_LOCAL_PLANNER_DEBUG_CANDIDATES}" --local-map-debug-points "${LINGTU_NAV_LOCAL_MAP_DEBUG_POINTS}" --status-file "${LINGTU_NAV_STATUS_FILE}" --estop-latch-file "${LINGTU_NAV_ESTOP_LATCH_FILE}" --status-s "${LINGTU_NAV_STATUS_S}"'
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
