[Unit]
Description=LingTu Thunder navigation runtime
After=network-online.target lingtu-slam-dds.service lingtu-nav-dds.service lingtu-driver.service
Wants=network-online.target lingtu-slam-dds.service lingtu-nav-dds.service lingtu-driver.service

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=15s
WatchdogSignal=SIGTERM
KillMode=control-group
User=sunrise
Group=sunrise
WorkingDirectory=/opt/lingtu/current
Environment=HOME=/home/sunrise
Environment=LINGTU_REPO=/opt/lingtu/current
Environment=LINGTU_PROFILE=nav
Environment=LINGTU_PYTHON=python3
Environment=LINGTU_MODULE_TRANSPORT=local
Environment=LINGTU_ENDPOINT=thunder_field
Environment=LINGTU_ENDPOINT_TRANSPORT=dds
Environment=LINGTU_ENDPOINT_CONTRACT=thunder_field_dds_v1
Environment=LINGTU_TELEOP_BRIDGE_ADDR=
Environment=LINGTU_TELEOP_CMD_DDS=1
Environment=LINGTU_ENABLE_ROBOT_DRIVER=0
Environment=LINGTU_COMMAND_OUTPUT_MODE=endpoint_only
Environment=LINGTU_HARDWARE_CONTROL_BOUNDARY=driver
Environment=LINGTU_MANAGE_SESSION_SERVICES=0
Environment=LINGTU_OCTOPLANNER3D_EXECUTABLE=/opt/lingtu/current/build/octoplanner3d_headless/octoplanner3d_headless
Environment=LINGTU_OCTOPLANNER3D_MAP=/home/sunrise/data/nova/maps/active/octomap.ot
Environment=LINGTU_NAV_CLIENT_LIB=/opt/lingtu/current/build/nav_endpoint/liblingtu_nav_client.so
Environment=LINGTU_INSPECTION_LIBRARY=/opt/lingtu/current/build/nav_endpoint/inspection/liblingtu_inspection.so
Environment=LINGTU_INSPECTION_EVIDENCE_BRIDGE_LIBRARY=/opt/lingtu/current/build/nav_endpoint/liblingtu_inspection_evidence_bridge.so
Environment=LINGTU_INSPECTION_EVIDENCE_DIR=/home/sunrise/data/lingtu/inspection_evidence
Environment=LINGTU_INSPECTION_EVIDENCE_STATUS_FILE=/dev/shm/lingtu/inspection_evidence_status.json
Environment=LINGTU_NAV_COMMANDS_REQUIRED=1
Environment=LINGTU_NAV_GOAL_TIMEOUT_MS=10000
Environment=LINGTU_NAV_CANCEL_TIMEOUT_MS=2000
Environment=LINGTU_NAV_TELEOP_TIMEOUT_MS=1000
Environment=LINGTU_DDS_DOMAIN_ID=0
Environment=LINGTU_SERVICE_DDS_CHECK=1
Environment=LINGTU_SERVICE_DDS_CHECK_TIMEOUT=2.5
Environment=LINGTU_DDS_PROBE_SCRIPT=/opt/lingtu/current/scripts/diagnostics/dds_probe.py
Environment=LINGTU_SERVICE_READINESS_JSON=/tmp/lingtu_service_readiness.json
Environment=LINGTU_CLOUD_VIEWER_MAX_HZ=2
Environment=LINGTU_SCAN_VIEWER_MAX_HZ=10
Environment=LINGTU_SCAN_VIEWER_MAX_POINTS=5000
Environment=LINGTU_SLAM_LIDAR_SCAN_INTERVAL_S=0.005
ExecStart=/bin/bash /opt/lingtu/current/scripts/deploy/thunder/run_http_watchdog.sh --health-url http://127.0.0.1:5050/health --startup-timeout-s 60 --poll-interval-s 2 -- /bin/bash -lc 'source /opt/lingtu/config/thunder-runtime-env.sh && exec "${LINGTU_PYTHON}" lingtu.py "${LINGTU_PROFILE}" --no-repl'
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
