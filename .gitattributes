/.gitattributes text eol=lf
scripts/*.sh text eol=lf
scripts/**/*.sh text eol=lf
src/native/recording/tests/*.sh text eol=lf
scripts/lingtu text eol=lf
scripts/deploy/**/*.service text eol=lf
docs/04-deployment/services/*.service text eol=lf
docs/04-deployment/services/*.sh text eol=lf

# Simulation package manifests and physics assets participate in SHA-256
# provenance checks and must have identical bytes on Windows and Linux.
sim/**/*.json text eol=lf
sim/**/*.obj text eol=lf
sim/**/*.py text eol=lf
sim/**/*.svg text eol=lf
sim/**/*.xml text eol=lf
sim/**/*.yaml text eol=lf
sim/**/*.yml text eol=lf

# Committed configuration is platform-neutral text.
config/**/*.json text eol=lf
config/**/*.md text eol=lf
config/**/*.xml text eol=lf
config/**/*.yaml text eol=lf
scripts/build/*.ps1 text eol=lf
scripts/build/cmake/**/*.cmake text eol=lf
scripts/build/locks/**/*.json text eol=lf
scripts/build/provenance/slam/** text eol=lf
scripts/build/tests/**/*.idl text eol=lf
scripts/build/vcpkg/**/*.json text eol=lf
# This vendored tree's reviewed development-source lock was established over
# CRLF bytes. Force the same bytes on every host so provenance does not depend
# on each clone's core.autocrlf setting.
src/localization/fastlio2/** text eol=crlf

# Large simulation source assets are versioned through Git LFS. Generated UE
# directories remain ignored by sim/runtime/visual/RobotSimUE/.gitignore.
sim/packages/**/*.STL filter=lfs diff=lfs merge=lfs -text
sim/packages/**/*.stl filter=lfs diff=lfs merge=lfs -text
sim/packages/**/*.fbx filter=lfs diff=lfs merge=lfs -text
sim/packages/**/*.glb filter=lfs diff=lfs merge=lfs -text
sim/packages/**/*.bin filter=lfs diff=lfs merge=lfs -text
sim/compat/assets/**/*.STL filter=lfs diff=lfs merge=lfs -text
sim/compat/assets/**/*.stl filter=lfs diff=lfs merge=lfs -text
sim/packages/controllers/doso/thunder_v4/locomotion/policy/policy_1119.onnx filter=lfs diff=lfs merge=lfs -text
sim/runtime/visual/RobotSimUE/Content/**/*.uasset filter=lfs diff=lfs merge=lfs -text
sim/runtime/visual/RobotSimUE/Content/**/*.umap filter=lfs diff=lfs merge=lfs -text
sim/runtime/visual/RobotSimUE/Plugins/**/*.uasset filter=lfs diff=lfs merge=lfs -text
sim/runtime/visual/RobotSimUE/Plugins/**/*.umap filter=lfs diff=lfs merge=lfs -text
src/nav/cpp/planning/local/cmu/paths/**/correspondences.txt filter=lfs diff=lfs merge=lfs -text
